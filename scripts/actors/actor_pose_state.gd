extends RefCounted

const STYLE_LEGACY: StringName = &"legacy"
const STYLE_VELVET: StringName = &"velvet_doll"
const STYLE_SHADOW: StringName = &"pumpkin_shadow"
const STYLE_CROOKED_TOWER: StringName = &"crooked_tower"
const STYLE_HOOD: StringName = &"hood"  # the hooded boy (hood_frame_actor.gd)
const HOOD_RUN_SPEED_SCALE := 0.53  # his run speed against the level's RUN_SPEED (285 px/s): 151 px/s, a slow, heavy jog
const HOOD_AIR_SPEED_SCALE := 0.8  # in the air he can go a little faster (a lunge), so a jump still gets across the gap
const HOOD_JUMP_SCALE := 0.72  # his jump speed against the level's: the big jump is about his own height (about 65 px, he is 76 px tall on screen), not 115; anything higher he climbs

const EQUIPMENT_NONE: StringName = &"none"
const EQUIPMENT_THROWABLE: StringName = &"throwable"
const EQUIPMENT_SHIELD: StringName = &"shield"
const EQUIPMENT_BLADE: StringName = &"blade"
const EQUIPMENT_SHIELD_BLADE: StringName = &"shield_blade"

const ACTION_NONE: StringName = &"none"
const ACTION_PICKUP: StringName = &"pickup"
const ACTION_PUT_DOWN: StringName = &"put_down"
const ACTION_THROW_CHARGE: StringName = &"throw_charge"
const ACTION_THROW_RELEASE: StringName = &"throw_release"
const ACTION_SHIELD_EQUIP: StringName = &"shield_equip"
const ACTION_SHIELD_RAISE: StringName = &"shield_raise"
const ACTION_SHIELD_GUARD: StringName = &"shield_guard"
const ACTION_SHIELD_LOWER: StringName = &"shield_lower"
const ACTION_SHIELD_PARRY: StringName = &"shield_parry"
const ACTION_SHIELD_BLOCK: StringName = &"shield_block"
const ACTION_BLADE_EQUIP: StringName = &"blade_equip"
const ACTION_BLADE_SWING: StringName = &"blade_swing"
const ACTION_BLADE_SHEATHE: StringName = &"blade_sheathe"
const ACTION_BLADE_DRAW_RUN: StringName = &"blade_draw_run"
const ACTION_BLADE_SHEATHE_RUN: StringName = &"blade_sheathe_run"
const ACTION_BLADE_SHEATHE_GUARD: StringName = &"blade_sheathe_guard"
const ACTION_PUSH_ENGAGE: StringName = &"push_engage"
const ACTION_PUSH: StringName = &"push"
const ACTION_PUSH_RELEASE: StringName = &"push_release"
const ACTION_HIT: StringName = &"hit"
const ACTION_KNOCKDOWN: StringName = &"knockdown"
const ACTION_DOWNED: StringName = &"downed"
const ACTION_GET_UP: StringName = &"get_up"
const ACTION_UNCONTROLLED_FALL: StringName = &"uncontrolled_fall"
const ACTION_FALL_IMPACT: StringName = &"fall_impact"
const ACTION_FALL_DOWNED: StringName = &"fall_downed"
const ACTION_CLIMB: StringName = &"climb"  # hands over a ledge: hang, pull up, crawl, stand (the clip's root is the ledge corner)

var active := true
var style_id: StringName = STYLE_LEGACY
var feet := Vector2.ZERO
var velocity := Vector2.ZERO
var grounded := false
var facing := 1.0
var held := -1
var aiming := false
var room := -1
var failure_time := 0.0
var failure_duration := 0.82

var equipment: StringName = EQUIPMENT_NONE
var action: StringName = ACTION_NONE
var action_progress := 0.0
var aim_angle := -0.72
var effort := 0.0
var impact := 0.0
var light_exposure := 0.0
var combo_index := 0
var small_item_kind: StringName = &""
var small_item_radius := 8.0
var small_item_origin := Vector2(-9999.0, -9999.0)  # screen position where the item lay before it was picked up
var visual_scale := 1.0
var fog_blur := 0.0
var monochrome := false
var clip_flip_h := false
var frame_root_offset := Vector2.ZERO
var shoved := false  # a rolling boulder is walking him back (the hooded boy braces against it)
var alarm := false  # frozen in fright (the hooded boy shows the scared pose)

func apply(source: Dictionary) -> void:
	active = bool(source.get("active", true))
	style_id = StringName(source.get("style_id", STYLE_LEGACY))
	feet = Vector2(source.get("feet", Vector2.ZERO))
	velocity = Vector2(source.get("velocity", Vector2.ZERO))
	grounded = bool(source.get("grounded", false))
	facing = float(source.get("facing", 1.0))
	held = int(source.get("held", -1))
	aiming = bool(source.get("aiming", false))
	room = int(source.get("room", -1))
	failure_time = float(source.get("failure_time", 0.0))
	failure_duration = float(source.get("failure_duration", 0.82))
	equipment = StringName(source.get("equipment", EQUIPMENT_NONE))
	action = StringName(source.get("action", ACTION_NONE))
	action_progress = clampf(float(source.get("action_progress", 0.0)), 0.0, 1.0)
	aim_angle = float(source.get("aim_angle", -0.72))
	effort = clampf(float(source.get("effort", 0.0)), 0.0, 1.0)
	impact = clampf(float(source.get("impact", 0.0)), 0.0, 1.0)
	light_exposure = clampf(float(source.get("light_exposure", 0.0)), 0.0, 1.0)
	combo_index = int(source.get("combo_index", 0))
	small_item_kind = StringName(source.get("small_item_kind", ""))
	small_item_radius = maxf(4.0, float(source.get("small_item_radius", 8.0)))
	small_item_origin = Vector2(source.get("small_item_origin", Vector2(-9999.0, -9999.0)))
	visual_scale = clampf(float(source.get("visual_scale", 1.0)), 0.5, 1.5)
	fog_blur = clampf(float(source.get("fog_blur", 0.0)), 0.0, 4.0)
	monochrome = bool(source.get("monochrome", false))
	clip_flip_h = bool(source.get("clip_flip_h", false))
	frame_root_offset = Vector2(source.get("frame_root_offset", Vector2.ZERO))
	shoved = bool(source.get("shoved", false))
	alarm = bool(source.get("alarm", false))
