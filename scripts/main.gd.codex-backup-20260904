	match cellar_region:
		"H":
			return "H · 中央厅"
		"L":
			return "L · 酒窖岔路"
		"O":
			return "O · 碎石暗龛"
		"M":
			return "M · 储藏室"
		"D":
			return "D · 错层坑道"
		"C":
			return "C · 回声排水室"
		"G":
			return "G · 毒气管室"
		"F":
			return "F · 伪回廊"
		"Q":
			return "Q · 淹水采石室"
		"W":
			return "W · 裂墙夹道"
		"K":
			return "K · 钥匙室"
		"R":
			return "R · 锁链回廊"
		"T":
			return "T · 落石长廊"
		"P":
			return "P · 监牢"
	return "迷雾地窖"

func _room_name() -> String:
	match room:
		Room.SURFACE:
			return "A · 悬崖井口"
		Room.SHAFT:
			return "B · 雨根竖井"
		Room.CAVERN, Room.LEVEL_01_LIFT:
			return "C · 井底根穴"
		Room.LEVEL_02_CLIFFS:
			return "A · 双崖上层"
		Room.LEVEL_02_ROPEWAY:
			return "E · 风化绳道"
		Room.LEVEL_02_CAVE:
			return "F · 盾行山洞"
		Room.LEVEL_02_COMPLETE:
			return "G · 木屋外缘"
		Room.LEVEL_03_HOUSE:
			return "A · 月炉木屋"
		Room.LEVEL_03_YARD:
			return "B · 对岸庭院"
		Room.LEVEL_03_CELLAR_READY:
			return "C · 地窖入口"
		Room.LEVEL_03_CELLAR_MAZE:
			return _cellar_region_label()
		Room.LEVEL_03_RESCUED:
			return "D · 地牢深处"
		_:
			return ""

