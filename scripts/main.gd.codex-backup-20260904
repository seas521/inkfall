func _ready() -> void:
	ui_font = ThemeDB.fallback_font
	_reset_pickup_items()
	if debug_start_level > 0:
		debug_selection = debug_start_level - 1
		_start_debug_level()
	queue_redraw()

func _physics_process(delta: float) -> void:
	elapsed += delta

	if debug_selector_open:
		if Input.is_action_just_pressed("ui_up"):
			debug_selection = maxi(0, debug_selection - 1)
		if Input.is_action_just_pressed("ui_down"):
			debug_selection = mini(3, debug_selection + 1)
		if Input.is_action_just_pressed("ui_accept") or Input.is_action_just_pressed("interact"):
			_start_debug_level()
		queue_redraw()
		return

	if Input.is_action_just_pressed("ui_cancel"):
		debug_selector_open = true
		queue_redraw()
		return

	room_intro_time = maxf(0.0, room_intro_time - delta)
	entry_fall_lock = maxf(0.0, entry_fall_lock - delta)
	failure_flash = maxf(0.0, failure_flash - delta)
	spout_reject_time = maxf(0.0, spout_reject_time - delta)
	cavern_checkpoint_flash_time = maxf(0.0, cavern_checkpoint_flash_time - delta)
	ropeway_collect_time = maxf(0.0, ropeway_collect_time - delta)
	ropeway_status_time = maxf(0.0, ropeway_status_time - delta)
	shield_pickup_time = maxf(0.0, shield_pickup_time - delta)
	shield_parry_hit_time = maxf(0.0, shield_parry_hit_time - delta)
	shield_block_hit_time = maxf(0.0, shield_block_hit_time - delta)
	cave_status_time = maxf(0.0, cave_status_time - delta)
	cave_tutorial_time = maxf(0.0, cave_tutorial_time - delta)
	cave_entry_fade_time = maxf(0.0, cave_entry_fade_time - delta)
	cave_rock_impact_time = maxf(0.0, cave_rock_impact_time - delta)
	level3_seal_flash_time = maxf(0.0, level3_seal_flash_time - delta)
	level3_swing_time = maxf(0.0, level3_swing_time - delta)
	level3_transition_time = maxf(0.0, level3_transition_time - delta)
	level3_help_clock += delta
	cellar_intro_time = maxf(0.0, cellar_intro_time - delta)
	cellar_transition_time = maxf(0.0, cellar_transition_time - delta)
	cellar_focus_time = maxf(0.0, cellar_focus_time - delta)
	cellar_wall_hit_time = maxf(0.0, cellar_wall_hit_time - delta)
	cellar_drain_time = maxf(0.0, cellar_drain_time - delta)
	cellar_spawn_grace_time = maxf(0.0, cellar_spawn_grace_time - delta)
	cellar_o_boulder_fall_time = maxf(0.0, cellar_o_boulder_fall_time - delta)

	if Input.is_action_just_pressed("restart"):
		_reset_current_room()

	match room:
		Room.SURFACE:
			_update_surface(delta)
		Room.SHAFT:
			_update_shaft(delta)
		Room.CAVERN:
			_update_cavern(delta)
		Room.LEVEL_01_LIFT:
			_update_level_01_lift(delta)
		Room.LEVEL_02_CLIFFS:
			_update_level_02_cliffs(delta)
		Room.LEVEL_02_ROPEWAY:
			_update_level_02_ropeway(delta)
		Room.LEVEL_02_CAVE:
			_update_level_02_cave(delta)
		Room.LEVEL_02_COMPLETE:
			_update_level_02_complete(delta)
		Room.LEVEL_03_HOUSE:
			_update_level_03_house(delta)
		Room.LEVEL_03_YARD:
			_update_level_03_yard(delta)
		Room.LEVEL_03_CELLAR_READY:
			_update_level_03_cellar_ready(delta)
		Room.LEVEL_03_CELLAR_MAZE:
			_update_cellar_maze(delta)
		Room.LEVEL_03_RESCUED:
			_update_cellar_rescued(delta)

	queue_redraw()

func _start_debug_level() -> void:
	debug_selector_open = false
	if debug_selection == 3:
		_enter_cellar_maze(true)
		return
	if debug_selection == 2:
		_enter_level_03_house(true)
		return
	if debug_selection == 1:
		_enter_level_02_cliffs()
		return
	room = Room.SURFACE
	player_position = Vector2(170.0, 526.0)
	player_velocity = Vector2.ZERO
	checkpoint_position = player_position
	shaft_checkpoint_depth = 0.0
	camera_axis = 0.0
	room_intro_time = 4.2
	entry_fall_lock = 0.0
	failure_flash = 0.0
	water_blocked = false
	lift_time = 0.0
	completion_time = 0.0
	shaft_failure_kind = ""
	shaft_failure_time = 0.0
	cavern_failure_kind = ""
	cavern_failure_time = 0.0
	cavern_mid_checkpoint_active = false
	cavern_checkpoint_flash_time = 0.0
	spout_reject_time = 0.0
	on_ground = false
	regular_jump_active = false
	_reset_pickup_items()

func _update_surface(delta: float) -> void:
	_update_player(delta, SURFACE_PLATFORMS, Vector2(-20.0, 1274.0), true)
	camera_axis = 0.0
	if player_position.y > SCREEN.y + 36.0:
		if player_position.x > 660.0 and player_position.x < 945.0:
			_enter_shaft()
		else:
			_fail_and_respawn()

func _enter_shaft() -> void:
	room = Room.SHAFT
	player_position = Vector2(627.0, -96.0)
	player_velocity = Vector2(0.0, 760.0)
	checkpoint_position = Vector2(627.0, 116.0)
	shaft_checkpoint_depth = 170.0
	camera_axis = 0.0
	entry_fall_lock = 0.62
	room_intro_time = 2.8
	on_ground = false
	regular_jump_active = false
	shaft_failure_kind = ""
	shaft_failure_time = 0.0

func _update_shaft(delta: float) -> void:
	if shaft_failure_kind != "":
		_update_shaft_failure(delta)
		return

	_update_player(delta, SHAFT_PLATFORMS, Vector2(520.0, 760.0), entry_fall_lock <= 0.0)
	camera_axis = clampf(player_position.y - 245.0, 0.0, 1740.0)
	_update_shaft_checkpoint()

	var player_rect := Rect2(player_position, PLAYER_SIZE)
	for index in range(SHAFT_FLAMES.size()):
		if _shaft_flame_is_dangerous(index) and player_rect.intersects(SHAFT_FLAMES[index]):
			_start_shaft_failure("fire", SHAFT_FLAMES[index].get_center())
			return

	# A step-off between adjacent shelves stays below this speed. Missing one
	# shelf or trying to jump over it crosses the limit before a later landing.
	if entry_fall_lock <= 0.0 and not on_ground and player_velocity.y > SHAFT_FATAL_FALL_SPEED:
		_start_shaft_failure("fall", player_position + PLAYER_SIZE * 0.5)
		return

	if player_position.y > 2400.0:
		_fail_and_respawn()
		return

	if player_position.y > 2210.0 and player_position.x > 690.0:
		_enter_cavern()

func _start_shaft_failure(kind: String, source: Vector2) -> void:
	shaft_failure_kind = kind
	shaft_failure_time = 0.001
	shaft_failure_origin = source
	on_ground = false
	regular_jump_active = false
	if kind == "fire":
		var player_center := player_position + PLAYER_SIZE * 0.5
		var recoil_direction := signf(player_center.x - source.x)
		if is_zero_approx(recoil_direction):
			recoil_direction = -player_facing
		player_velocity = Vector2(recoil_direction * 185.0, -225.0)

func _update_shaft_failure(delta: float) -> void:
	shaft_failure_time += delta
	player_velocity.x = move_toward(player_velocity.x, 0.0, 210.0 * delta)
	player_velocity.y += GRAVITY * delta
	player_position += player_velocity * delta
	player_position.x = clampf(player_position.x, 520.0, 760.0 - PLAYER_SIZE.x)
	camera_axis = clampf(player_position.y - 245.0, 0.0, 1740.0)

	var duration := 0.82 if shaft_failure_kind == "fire" else 0.46
	if shaft_failure_time >= duration:
		shaft_failure_kind = ""
		shaft_failure_time = 0.0
		_fail_and_respawn()

func _update_shaft_checkpoint() -> void:
	if not on_ground:
		return
	if player_position.y > 1050.0 and shaft_checkpoint_depth < 1050.0:
		checkpoint_position = Vector2(555.0, 1051.0)
		shaft_checkpoint_depth = 1050.0
	elif player_position.y > 1750.0 and shaft_checkpoint_depth < 1750.0:
		checkpoint_position = Vector2(704.0, 1786.0)
		shaft_checkpoint_depth = 1750.0

func _enter_cavern() -> void:
	room = Room.CAVERN
	player_position = Vector2(150.0, 506.0)
	player_velocity = Vector2.ZERO
	checkpoint_position = player_position
	camera_axis = 0.0
	room_intro_time = 3.2
	entry_fall_lock = 0.28
	on_ground = false
	regular_jump_active = false
	shaft_failure_kind = ""
	shaft_failure_time = 0.0
	cavern_failure_kind = ""
	cavern_failure_time = 0.0
	cavern_mid_checkpoint_active = false
	cavern_checkpoint_flash_time = 0.0
	spout_reject_time = 0.0
	_reset_pickup_items()

func _update_cavern(delta: float) -> void:
	if cavern_failure_kind != "":
		_update_cavern_failure(delta)
		return

	var previous_dynamic_rects: Array[Rect2] = _cavern_dynamic_platforms(elapsed - delta)
	var dynamic_rects: Array[Rect2] = _cavern_dynamic_platforms(elapsed)
	_carry_player_with_dynamic_platform(previous_dynamic_rects, dynamic_rects)

	var all_platforms: Array[Rect2] = []
	all_platforms.append_array(CAVERN_FIXED_PLATFORMS)
	all_platforms.append(LIFT_PLATFORM)
	all_platforms.append_array(dynamic_rects)
	_update_player(delta, all_platforms, Vector2(20.0, 3340.0), entry_fall_lock <= 0.0)
	_update_pickup_interaction(delta, all_platforms)
	_update_pickup_items(delta, all_platforms)

	camera_axis = clampf(player_position.x - 370.0, 0.0, 2060.0)

	if not water_blocked and Rect2(player_position, PLAYER_SIZE).intersects(WATER_CURTAIN):
		player_velocity.x = -430.0
		player_velocity.y = -190.0
		player_position.x = minf(player_position.x, WATER_CURTAIN.position.x - PLAYER_SIZE.x - 4.0)
		failure_flash = maxf(failure_flash, 0.12)

	var player_rect := Rect2(player_position, PLAYER_SIZE)
	for index in range(CAVERN_SPIKES.size()):
		var spike_hit_rect: Rect2 = _cavern_spike_hit_rect(index)
		if _cavern_spike_is_dangerous(index) and player_rect.intersects(spike_hit_rect):
			_start_cavern_failure("spike", spike_hit_rect.get_center())
			return

	if _player_in_active_gas():
		_start_cavern_failure("gas", player_position + PLAYER_SIZE * 0.5)
		return

	_update_cavern_mid_checkpoint(player_rect)

	if player_position.y > SCREEN.y + 90.0:
		_fail_and_respawn()
		return

	if water_blocked and held_item_index < 0 and Rect2(player_position, PLAYER_SIZE).intersects(LIFT_INTERACTION):
		if Input.is_action_just_pressed("interact"):
			room = Room.LEVEL_01_LIFT
			lift_time = 0.0
			completion_time = 0.0
			player_position = Vector2(3174.0, LIFT_PLATFORM.position.y - PLAYER_SIZE.y)
			player_velocity = Vector2.ZERO
			on_ground = true

func _update_cavern_mid_checkpoint(player_rect: Rect2) -> void:
	if cavern_mid_checkpoint_active or not water_blocked or not on_ground:
		return
	if not player_rect.intersects(CAVERN_MID_CHECKPOINT_ZONE):
		return
	cavern_mid_checkpoint_active = true
	cavern_checkpoint_flash_time = 1.8
	checkpoint_position = CAVERN_MID_CHECKPOINT_POSITION

func _start_cavern_failure(kind: String, source: Vector2) -> void:
	cavern_failure_kind = kind
	cavern_failure_time = 0.001
	cavern_failure_origin = source
	on_ground = false
	regular_jump_active = false
	var player_center := player_position + PLAYER_SIZE * 0.5
	var recoil_direction := signf(player_center.x - source.x)
	if is_zero_approx(recoil_direction):
		recoil_direction = -player_facing
	player_velocity = Vector2(recoil_direction * 170.0, -210.0)

func _update_cavern_failure(delta: float) -> void:
	cavern_failure_time += delta
	player_velocity.x = move_toward(player_velocity.x, 0.0, 190.0 * delta)
	player_velocity.y += GRAVITY * delta
	player_position += player_velocity * delta
	player_position.x = clampf(player_position.x, 20.0, 3340.0 - PLAYER_SIZE.x)
	camera_axis = clampf(player_position.x - 370.0, 0.0, 2060.0)
	if cavern_failure_time >= 0.76:
		cavern_failure_kind = ""
		cavern_failure_time = 0.0
		_fail_and_respawn()

func _update_level_01_lift(delta: float) -> void:
	lift_time = minf(1.0, lift_time + delta / 1.35)
	completion_time += delta
	player_velocity = Vector2.ZERO
	player_position.y = LIFT_PLATFORM.position.y - PLAYER_SIZE.y - lift_time * 238.0
	if completion_time >= 1.65:
		_enter_level_02_cliffs()

func _enter_level_02_cliffs() -> void:
	room = Room.LEVEL_02_CLIFFS
	player_position = Vector2(150.0, 400.0 - PLAYER_SIZE.y)
	player_velocity = Vector2.ZERO
	checkpoint_position = player_position
	camera_axis = 0.0
	room_intro_time = 4.0
	entry_fall_lock = 0.0
	failure_flash = 0.0
	completion_time = 0.0
	lift_time = 0.0
	level2_slide_active = false
	on_ground = false
	regular_jump_active = false
	held_item_index = -1
	throw_preparing = false

func _update_level_02_cliffs(delta: float) -> void:
	_update_player(delta, LEVEL2_CLIFF_PLATFORMS, Vector2(-20.0, 1280.0), not level2_slide_active)
	camera_axis = 0.0

	var foot_x: float = player_position.x + PLAYER_SIZE.x * 0.5
	if foot_x >= LEVEL2_SLOPE_START.x and foot_x <= LEVEL2_SLOPE_END.x:
		var slope_ratio: float = inverse_lerp(LEVEL2_SLOPE_START.x, LEVEL2_SLOPE_END.x, foot_x)
		var slope_y: float = lerpf(LEVEL2_SLOPE_START.y, LEVEL2_SLOPE_END.y, slope_ratio)
		var player_bottom: float = player_position.y + PLAYER_SIZE.y
		if level2_slide_active or (player_velocity.y >= 0.0 and player_bottom >= slope_y - 9.0 and player_bottom <= slope_y + 40.0):
			level2_slide_active = true
			player_position.y = slope_y - PLAYER_SIZE.y
			player_velocity.x = maxf(player_velocity.x, 315.0)
			player_velocity.y = 0.0
			player_facing = 1.0
			on_ground = true

	if level2_slide_active and (foot_x >= LEVEL2_SLOPE_END.x - 8.0 or player_position.y > 610.0):
		_enter_level_02_ropeway()
		return
	if player_position.y > SCREEN.y + 80.0:
		_fail_and_respawn()

func _enter_level_02_ropeway() -> void:
	room = Room.LEVEL_02_ROPEWAY
	player_position = Vector2(115.0, 78.0)
	player_velocity = Vector2(250.0, 470.0)
	checkpoint_position = Vector2(115.0, ROPEWAY_PLATFORMS[0].position.y - PLAYER_SIZE.y)
	camera_axis = 0.0
	room_intro_time = 3.2
	entry_fall_lock = 0.58
	on_ground = false
	regular_jump_active = false
	_reset_ropeway_attempt()

func _update_level_02_ropeway(delta: float) -> void:
	if ropeway_failure_time > 0.0:
		_update_ropeway_failure(delta)
		return
	if ropeway_rope_installed:
		_update_ropeway_climb(delta)
		return

	var previous_moving_platforms: Array[Rect2] = [_ropeway_moving_platform(elapsed - delta)]
	var moving_platforms: Array[Rect2] = [_ropeway_moving_platform(elapsed)]
	_carry_player_with_dynamic_platform(previous_moving_platforms, moving_platforms)
	var ropeway_collision_platforms: Array[Rect2] = []
	ropeway_collision_platforms.append_array(ROPEWAY_PLATFORMS)
	ropeway_collision_platforms.append_array(moving_platforms)
	_update_player(delta, ropeway_collision_platforms, Vector2(0.0, 2390.0), entry_fall_lock <= 0.0)
	camera_axis = clampf(player_position.x - 330.0, 0.0, 1110.0)
	_update_ropeway_chase(delta)
	_try_ropeway_interaction()

	var player_rect := Rect2(player_position, PLAYER_SIZE)
	if ropeway_chase_state == "rolling" or ropeway_chase_state == "jammed":
		if player_rect.intersects(_ropeway_boulder_rect()):
			_start_ropeway_failure("滚石追上了你")
			return
	if player_position.y > SCREEN.y + 70.0:
		_start_ropeway_failure("坠入深坑")

func _update_level_02_complete(delta: float) -> void:
	completion_time += delta
	player_velocity = Vector2.ZERO
	if completion_time > 0.45 and Input.is_action_just_pressed("interact"):
		_enter_level_03_house(true)

func _enter_level_03_house(reset_puzzle: bool) -> void:
	room = Room.LEVEL_03_HOUSE
	player_position = Vector2(145.0, 590.0 - PLAYER_SIZE.y)
	player_velocity = Vector2.ZERO
	player_facing = 1.0
	on_ground = false
	regular_jump_active = false
	camera_axis = 0.0
	checkpoint_position = player_position
	room_intro_time = 0.0
	level3_transition_time = 0.7
	level3_seal_overlay_open = false
	level3_help_clock = 0.0
	if reset_puzzle:
		_reset_level_03_puzzle()

func _reset_level_03_puzzle() -> void:
	level3_held_item = ""
	level3_axe_picked = false
	level3_tree_hits = 0
	level3_branch_available = false
	level3_fireplace_lit = false
	level3_charred_stick_available = false
	level3_curtain_open = false
	level3_window_propped = false
	level3_fire_unlocked = false
	level3_moon_unlocked = false
	level3_wind_unlocked = false
	level3_hatch_unsealed = false
	level3_hatch_open = false
	level3_seal_overlay_open = false
	level3_seal_flash_time = 0.0
	level3_swing_time = 0.0

func _switch_level_03_room(next_room: Room, next_position: Vector2) -> void:
	room = next_room
	player_position = next_position
	player_velocity = Vector2.ZERO
	on_ground = false
	regular_jump_active = false
	camera_axis = clampf(player_position.x - 360.0, 0.0, LEVEL3_YARD_WORLD_WIDTH - SCREEN.x) if next_room == Room.LEVEL_03_YARD else 0.0
	checkpoint_position = player_position
	level3_transition_time = 0.38
	level3_seal_overlay_open = false

func _level_03_house_platforms() -> Array[Rect2]:
	var platforms: Array[Rect2] = []
	if level3_hatch_open:
		platforms.append(Rect2(-80.0, 590.0, LEVEL3_HATCH_GAP.position.x + 80.0, 150.0))
		platforms.append(Rect2(LEVEL3_HATCH_GAP.end.x, 590.0, LEVEL3_HOUSE_WORLD_WIDTH - LEVEL3_HATCH_GAP.end.x + 80.0, 150.0))
	else:
		platforms.append(Rect2(-80.0, 590.0, LEVEL3_HOUSE_WORLD_WIDTH + 160.0, 150.0))
	platforms.append_array(LEVEL3_HOUSE_FURNITURE)
	return platforms

func _update_level_03_house(delta: float) -> void:
	if level3_seal_overlay_open:
		player_velocity = Vector2.ZERO
		if Input.is_action_just_pressed("interact"):
			level3_seal_overlay_open = false
		return

	var house_platforms: Array[Rect2] = _level_03_house_platforms()
	_update_player(delta, house_platforms, Vector2(0.0, LEVEL3_HOUSE_WORLD_WIDTH), true)
	camera_axis = clampf(player_position.x - 360.0, 0.0, LEVEL3_HOUSE_WORLD_WIDTH - SCREEN.x)
	_try_level_03_house_interaction()

	if player_position.y > SCREEN.y + 42.0:
		if level3_hatch_open and player_position.x + PLAYER_SIZE.x * 0.5 >= LEVEL3_HATCH_GAP.position.x and player_position.x <= LEVEL3_HATCH_GAP.end.x:
			room = Room.LEVEL_03_CELLAR_READY
			player_velocity = Vector2.ZERO
			completion_time = 0.0
			camera_axis = 0.0
			level3_transition_time = 0.55
		else:
			player_position = checkpoint_position
			player_velocity = Vector2.ZERO
			failure_flash = 0.18

func _try_level_03_house_interaction() -> void:
	if not Input.is_action_just_pressed("interact"):
		return
	var player_rect := Rect2(player_position, PLAYER_SIZE)
	if player_rect.intersects(LEVEL3_HOUSE_DOOR_ZONE):
		_switch_level_03_room(Room.LEVEL_03_YARD, Vector2(1200.0, 590.0 - PLAYER_SIZE.y))
		return
	if level3_charred_stick_available and level3_held_item == "" and player_rect.intersects(LEVEL3_CHARRED_STICK_ZONE):
		level3_charred_stick_available = false
		level3_held_item = "charred_stick"
		return
	if player_rect.intersects(LEVEL3_FIREPLACE_ZONE):
		if not level3_fireplace_lit and level3_held_item == "torch":
			level3_fireplace_lit = true
			level3_fire_unlocked = true
			level3_held_item = ""
			level3_charred_stick_available = true
			level3_seal_flash_time = 1.0
			_update_level_03_seal_state()
		return
	if player_rect.intersects(LEVEL3_WINDOW_ZONE):
		if not level3_curtain_open:
			level3_curtain_open = true
			level3_moon_unlocked = true
			level3_seal_flash_time = 1.0
			_update_level_03_seal_state()
		elif not level3_window_propped and level3_held_item == "charred_stick" and level3_fireplace_lit:
			level3_window_propped = true
			level3_wind_unlocked = true
			level3_held_item = ""
			level3_seal_flash_time = 1.2
			_update_level_03_seal_state()
		return
	if player_rect.intersects(LEVEL3_HATCH_ZONE):
		if not level3_hatch_open and level3_hatch_unsealed:
			level3_hatch_open = true
			level3_seal_flash_time = 0.8
		elif not level3_hatch_open:
			level3_seal_overlay_open = true
			level3_seal_flash_time = 0.4
		return

func _update_level_03_yard(delta: float) -> void:
	_update_player(delta, LEVEL3_YARD_PLATFORMS, Vector2(0.0, LEVEL3_YARD_WORLD_WIDTH), true)
	camera_axis = clampf(player_position.x - 360.0, 0.0, LEVEL3_YARD_WORLD_WIDTH - SCREEN.x)
	_try_level_03_yard_interaction()
	if player_position.y > SCREEN.y + 60.0:
		player_position = checkpoint_position
		player_velocity = Vector2.ZERO
		failure_flash = 0.18

func _try_level_03_yard_interaction() -> void:
	if not Input.is_action_just_pressed("interact"):
		return
	var player_rect := Rect2(player_position, PLAYER_SIZE)
	if player_rect.intersects(LEVEL3_YARD_DOOR_ZONE):
		_switch_level_03_room(Room.LEVEL_03_HOUSE, Vector2(120.0, 590.0 - PLAYER_SIZE.y))
		return
	if not level3_axe_picked and level3_held_item == "" and player_rect.intersects(LEVEL3_AXE_ZONE):
		level3_axe_picked = true
		level3_held_item = "axe"
		return
	if level3_held_item == "axe" and player_rect.intersects(LEVEL3_TREE_ZONE) and level3_tree_hits < 3:
		level3_tree_hits += 1
		level3_swing_time = 0.28
		if level3_tree_hits >= 3:
			level3_held_item = ""
			level3_branch_available = true
		return
	if level3_branch_available and level3_held_item == "" and player_rect.intersects(LEVEL3_BRANCH_ZONE):
		level3_branch_available = false
		level3_held_item = "branch"
		return
	if level3_held_item == "branch" and player_rect.intersects(LEVEL3_CAMPFIRE_ZONE):
		level3_held_item = "torch"
		level3_swing_time = 0.32
		return
	if level3_held_item == "axe" or level3_held_item == "branch" or level3_held_item == "torch" or level3_held_item == "charred_stick":
		level3_swing_time = 0.26

func _update_level_03_seal_state() -> void:
	if not level3_fire_unlocked or not level3_moon_unlocked or not level3_wind_unlocked:
		return
	level3_hatch_unsealed = true
	level3_seal_overlay_open = true
	level3_seal_flash_time = 1.6

func _update_level_03_cellar_ready(delta: float) -> void:
	completion_time += delta
	player_velocity = Vector2.ZERO
	if completion_time >= 1.35:
		_enter_cellar_maze(true)

func _enter_cellar_maze(reset_maze: bool) -> void:
	room = Room.LEVEL_03_CELLAR_MAZE
	if reset_maze:
		_reset_cellar_state()
	cellar_region = "H"
	# The preceding CELLAR_READY room already owns the falling shot. Enter the
	# playable maze on the landing frame instead of starting a second fall.
	player_position = CELLAR_HUB_SPAWN
	player_velocity = Vector2.ZERO
	player_facing = -1.0
	on_ground = true
	regular_jump_active = false
	cellar_camera = _cellar_camera_target()
	cellar_checkpoint_region = "H"
	cellar_checkpoint_position = CELLAR_HUB_SPAWN
	cellar_intro_time = 0.82
	cellar_transition_time = 0.52
	cellar_spawn_grace_time = 0.22
	cellar_focus_time = 0.0
	cellar_focus_kind = ""
	room_intro_time = 0.0

func _reset_cellar_state() -> void:
	cellar_has_stone = false
	cellar_has_rubble = false
	cellar_has_key = false
	cellar_drain_open = false
	cellar_required_wall_hits = 0
	cellar_optional_wall_hits = 0
	cellar_o_boulder_triggered = false
	cellar_o_boulder_landed = false
	cellar_o_boulder_fall_time = 0.0
	cellar_rubble_position = _cellar_region_origin("O") + Vector2(240.0, 505.0)
	cellar_rubble_velocity = Vector2.ZERO
	cellar_rubble_thrown = false
	cellar_prison_discovered = false
	cellar_key_collected = false
	cellar_rescue_started = false
	cellar_failure_time = 0.0
	cellar_failure_kind = ""
	cellar_wall_hit_time = 0.0
	cellar_drain_time = 0.0
	cellar_spawn_grace_time = 0.0
	cellar_rock_spawn_timer = 0.7
	cellar_rock_spawn_index = 0
	cellar_falling_rocks.clear()
	cellar_dust.clear()

func _update_cellar_maze(delta: float) -> void:
	if cellar_failure_time > 0.0:
		_update_cellar_failure(delta)
		_update_cellar_camera(delta)
		return

	if cellar_rescue_started:
		player_velocity = Vector2.ZERO
		_update_cellar_camera(delta)
		if cellar_focus_time <= 0.05:
			room = Room.LEVEL_03_RESCUED
			completion_time = 0.0
			cellar_transition_time = 0.7
		return

	var chamber: Rect2 = _cellar_region_rect(cellar_region)
	var allow_input: bool = cellar_intro_time <= 0.55 and cellar_transition_time <= 0.08 and cellar_focus_time <= 0.55
	var platforms: Array[Rect2] = _cellar_platforms(cellar_region)
	_update_player(delta, platforms, Vector2(chamber.position.x + 22.0, chamber.end.x - 22.0), allow_input)
	_stabilize_cellar_spawn(platforms)

	if cellar_region == "O" and cellar_optional_wall_hits < CELLAR_OPTIONAL_WALL_HITS_REQUIRED:
		var boulder_left_edge: float = chamber.position.x + 915.0
		player_position.x = minf(player_position.x, boulder_left_edge - PLAYER_SIZE.x)
		if cellar_o_boulder_triggered and not cellar_o_boulder_landed and cellar_o_boulder_fall_time <= 0.0:
			cellar_o_boulder_landed = true
			cellar_wall_hit_time = 0.58
			_spawn_cellar_dust(chamber.position + Vector2(995.0, CELLAR_FLOOR_Y), CELLAR_STONE_COLOR)
	_update_cellar_rubble(delta)

	if cellar_region == "W" and cellar_required_wall_hits < CELLAR_WALL_HITS_REQUIRED:
		var blocking_x: float = chamber.position.x + 575.0
		player_position.x = maxf(player_position.x, blocking_x)

	_update_cellar_falling_rocks(delta)
	_update_cellar_dust(delta)
	_update_cellar_camera(delta)
	var region_before_interaction: String = cellar_region
	_try_cellar_interaction()
	if cellar_region != region_before_interaction:
		return
	_check_cellar_hazards()

	if player_position.y > chamber.end.y + 95.0:
		_start_cellar_failure("fall")

func _stabilize_cellar_spawn(platforms: Array[Rect2]) -> void:
	if cellar_spawn_grace_time <= 0.0 or player_velocity.y < 0.0:
		return
	var player_bottom: float = player_position.y + PLAYER_SIZE.y
	for platform_rect in platforms:
		var horizontal_overlap: bool = (
			player_position.x + PLAYER_SIZE.x > platform_rect.position.x + 3.0
			and player_position.x < platform_rect.end.x - 3.0
		)
		if not horizontal_overlap:
			continue
		if player_bottom < platform_rect.position.y - 6.0 or player_position.y > platform_rect.position.y + 24.0:
			continue
		player_position.y = platform_rect.position.y - PLAYER_SIZE.y
		player_velocity.y = 0.0
		on_ground = true
		return

func _update_cellar_rubble(delta: float) -> void:
	if cellar_region != "O" or not cellar_rubble_thrown:
		return
	cellar_rubble_velocity.y += GRAVITY * delta * 0.72
	cellar_rubble_position += cellar_rubble_velocity * delta
	var origin: Vector2 = _cellar_region_origin("O")
	var boulder_center: Vector2 = origin + Vector2(995.0, CELLAR_FLOOR_Y - 76.0)
	if cellar_o_boulder_landed and cellar_rubble_position.distance_to(boulder_center) <= 104.0:
		cellar_rubble_thrown = false
		cellar_rubble_velocity = Vector2.ZERO
		cellar_optional_wall_hits = CELLAR_OPTIONAL_WALL_HITS_REQUIRED
		cellar_wall_hit_time = 0.62
		_spawn_cellar_dust(boulder_center, CELLAR_STONE_COLOR)
		_spawn_cellar_dust(boulder_center + Vector2(-38.0, 18.0), CELLAR_STONE_COLOR)
		return
	var floor_y: float = origin.y + CELLAR_FLOOR_Y - 13.0
	if cellar_rubble_position.y >= floor_y:
		cellar_rubble_position.y = floor_y
		cellar_rubble_velocity = Vector2.ZERO
		cellar_rubble_thrown = false
		return
	if cellar_rubble_position.x < origin.x + 80.0 or cellar_rubble_position.x > origin.x + 1080.0:
		cellar_rubble_position.x = clampf(cellar_rubble_position.x, origin.x + 80.0, origin.x + 1080.0)
		cellar_rubble_velocity.x *= -0.35

func _update_cellar_rescued(delta: float) -> void:
	completion_time += delta
	player_velocity = Vector2.ZERO

func _update_cellar_camera(delta: float) -> void:
	var target: Vector2 = _cellar_camera_target()
	var camera_weight: float = 1.0 - exp(-8.5 * delta)
	cellar_camera = cellar_camera.lerp(target, camera_weight)

func _cellar_camera_target() -> Vector2:
	var focus_world: Vector2 = player_position + PLAYER_SIZE * 0.5
	if cellar_focus_time > 0.55:
		if cellar_focus_kind == "prison" or cellar_focus_kind == "rescue":
			focus_world = _cellar_region_origin("P") + Vector2(940.0, 385.0)
		elif cellar_focus_kind == "key":
			focus_world = _cellar_region_origin("K") + Vector2(575.0, 415.0)
		elif cellar_focus_kind == "drain":
			focus_world = _cellar_region_origin("C") + Vector2(560.0, 455.0)
		elif cellar_focus_kind == "o_boulder":
			focus_world = _cellar_region_origin("O") + Vector2(985.0, 435.0)
	var target := focus_world - SCREEN * 0.5
	return Vector2(
		clampf(target.x, 0.0, CELLAR_WORLD_SIZE.x - SCREEN.x),
		clampf(target.y, 0.0, CELLAR_WORLD_SIZE.y - SCREEN.y)
	)

func _cellar_region_origin(region_id: String) -> Vector2:
	match region_id:
		"O":
			return Vector2(80.0, 80.0)
		"L":
			return Vector2(1320.0, 80.0)
		"H":
			return Vector2(2560.0, 80.0)
		"R":
			return Vector2(3800.0, 80.0)
		"T":
			return Vector2(5040.0, 80.0)
		"P":
			return Vector2(6280.0, 80.0)
		"K":
			return Vector2(80.0, 880.0)
		"M":
			return Vector2(1320.0, 880.0)
		"D":
			return Vector2(2560.0, 880.0)
		"C":
			return Vector2(3800.0, 880.0)
		"W":
			return Vector2(80.0, 1680.0)
		"Q":
			return Vector2(1320.0, 1680.0)
		"G":
			return Vector2(2560.0, 1680.0)
		"F":
			return Vector2(3800.0, 1680.0)
	return Vector2(2560.0, 80.0)

func _cellar_region_rect(region_id: String) -> Rect2:
	return Rect2(_cellar_region_origin(region_id), CELLAR_CHAMBER_SIZE)

func _cellar_platforms(region_id: String) -> Array[Rect2]:
	var origin: Vector2 = _cellar_region_origin(region_id)
	var platforms: Array[Rect2] = []
	match region_id:
		"T":
			platforms = [
				Rect2(origin + Vector2(30.0, CELLAR_FLOOR_Y), Vector2(430.0, 90.0)),
				Rect2(origin + Vector2(550.0, CELLAR_FLOOR_Y), Vector2(150.0, 90.0)),
				Rect2(origin + Vector2(790.0, CELLAR_FLOOR_Y), Vector2(300.0, 90.0)),
			]
		"M":
			platforms = [
				Rect2(origin + Vector2(30.0, CELLAR_FLOOR_Y), Vector2(1060.0, 90.0)),
				Rect2(origin + Vector2(300.0, 470.0), Vector2(150.0, 20.0)),
				Rect2(origin + Vector2(515.0, 400.0), Vector2(135.0, 20.0)),
				Rect2(origin + Vector2(725.0, 330.0), Vector2(160.0, 20.0)),
			]
		"D":
			platforms = [
				Rect2(origin + Vector2(30.0, CELLAR_FLOOR_Y), Vector2(265.0, 90.0)),
				Rect2(origin + Vector2(390.0, CELLAR_FLOOR_Y), Vector2(225.0, 90.0)),
				Rect2(origin + Vector2(720.0, CELLAR_FLOOR_Y), Vector2(370.0, 90.0)),
			]
		"F":
			platforms = [
				Rect2(origin + Vector2(30.0, CELLAR_FLOOR_Y), Vector2(270.0, 90.0)),
				Rect2(origin + Vector2(400.0, CELLAR_FLOOR_Y), Vector2(230.0, 90.0)),
				Rect2(origin + Vector2(740.0, CELLAR_FLOOR_Y), Vector2(350.0, 90.0)),
			]
		"Q":
			platforms = [
				Rect2(origin + Vector2(30.0, CELLAR_FLOOR_Y), Vector2(250.0, 90.0)),
				Rect2(origin + Vector2(760.0, CELLAR_FLOOR_Y), Vector2(330.0, 90.0)),
			]
			if cellar_drain_open:
				platforms.append(Rect2(origin + Vector2(280.0, CELLAR_FLOOR_Y), Vector2(480.0, 90.0)))
		_:
			platforms = [Rect2(origin + Vector2(30.0, CELLAR_FLOOR_Y), Vector2(1060.0, 90.0))]
	return platforms

func _cellar_spawn(region_id: String, entry_side: String) -> Vector2:
	var origin: Vector2 = _cellar_region_origin(region_id)
	var floor_y: float = origin.y + CELLAR_FLOOR_Y - PLAYER_SIZE.y - 2.0
	if region_id == "O" and entry_side == "right":
		return Vector2(origin.x + 835.0, floor_y)
	match entry_side:
		"left":
			return Vector2(origin.x + 145.0, floor_y)
		"right":
			return Vector2(origin.x + 945.0, floor_y)
		"up":
			return Vector2(origin.x + 825.0, floor_y)
		"down":
			return Vector2(origin.x + 520.0, floor_y)
	return Vector2(origin.x + 540.0, floor_y)

func _cellar_make_portal(region_id: String, side: String, target: String, target_side: String) -> Dictionary:
	var origin: Vector2 = _cellar_region_origin(region_id)
	var zone := Rect2(origin + Vector2(460.0, 420.0), Vector2(200.0, 155.0))
	match side:
		"left":
			zone = Rect2(origin + Vector2(28.0, 410.0), Vector2(150.0, 170.0))
		"right":
			zone = Rect2(origin + Vector2(942.0, 410.0), Vector2(150.0, 170.0))
		"up":
			zone = Rect2(origin + Vector2(735.0, 390.0), Vector2(190.0, 190.0))
		"up_left":
			zone = Rect2(origin + Vector2(365.0, 390.0), Vector2(190.0, 190.0))
		"down":
			zone = Rect2(origin + Vector2(465.0, 420.0), Vector2(190.0, 160.0))
	return {
		"zone": zone,
		"side": side,
		"target": target,
		"spawn": _cellar_spawn(target, target_side),
	}

func _cellar_portals() -> Array[Dictionary]:
	var portals: Array[Dictionary] = []
	match cellar_region:
		"H":
			portals = [_cellar_make_portal("H", "left", "L", "right"), _cellar_make_portal("H", "right", "R", "left")]
		"L":
			portals = [_cellar_make_portal("L", "left", "O", "right"), _cellar_make_portal("L", "right", "H", "left"), _cellar_make_portal("L", "down", "M", "up")]
		"O":
			if cellar_optional_wall_hits >= CELLAR_OPTIONAL_WALL_HITS_REQUIRED:
				portals = [_cellar_make_portal("O", "right", "L", "left")]
		"M":
			portals = [_cellar_make_portal("M", "up", "L", "down"), _cellar_make_portal("M", "right", "D", "left"), _cellar_make_portal("M", "down", "C", "left")]
		"D":
			portals = [_cellar_make_portal("D", "left", "M", "right"), _cellar_make_portal("D", "down", "G", "up")]
		"G":
			portals = [_cellar_make_portal("G", "up", "D", "down"), _cellar_make_portal("G", "left", "Q", "right"), _cellar_make_portal("G", "right", "F", "left")]
		"F":
			portals = [_cellar_make_portal("F", "left", "G", "right"), _cellar_make_portal("F", "up", "C", "down")]
		"C":
			portals = [_cellar_make_portal("C", "left", "M", "down"), _cellar_make_portal("C", "down", "F", "up")]
		"Q":
			portals = [_cellar_make_portal("Q", "right", "G", "left"), _cellar_make_portal("Q", "left", "W", "right")]
		"W":
			portals = [_cellar_make_portal("W", "right", "Q", "left")]
			if cellar_required_wall_hits >= CELLAR_WALL_HITS_REQUIRED:
				portals.append(_cellar_make_portal("W", "up", "K", "down"))
		"K":
			portals = [_cellar_make_portal("K", "down", "W", "up")]
			if cellar_has_key:
				portals.append(_cellar_make_portal("K", "right", "H", "up"))
		"R":
			portals = [_cellar_make_portal("R", "left", "H", "right"), _cellar_make_portal("R", "right", "T", "left")]
		"T":
			portals = [_cellar_make_portal("T", "left", "R", "right"), _cellar_make_portal("T", "right", "P", "left")]
		"P":
			portals = [_cellar_make_portal("P", "left", "T", "right"), _cellar_make_portal("P", "up_left", "H", "up")]
	return portals

func _try_cellar_interaction() -> void:
	if not Input.is_action_just_pressed("interact") or cellar_transition_time > 0.0 or cellar_focus_time > 0.55:
		return
	var player_rect := Rect2(player_position, PLAYER_SIZE)
	var origin: Vector2 = _cellar_region_origin(cellar_region)

	if cellar_region == "O":
		if cellar_has_rubble:
			cellar_has_rubble = false
			cellar_rubble_thrown = true
			cellar_rubble_position = player_position + PLAYER_SIZE * 0.5 + Vector2(player_facing * 31.0, -5.0)
			cellar_rubble_velocity = Vector2(player_facing * 610.0, -185.0)
			return
		var rubble_zone: Rect2 = Rect2(cellar_rubble_position - Vector2(48.0, 58.0), Vector2(96.0, 116.0))
		if not cellar_rubble_thrown and cellar_optional_wall_hits < CELLAR_OPTIONAL_WALL_HITS_REQUIRED and player_rect.intersects(rubble_zone):
			cellar_has_rubble = true
			return

	if cellar_region == "C" and not cellar_drain_open:
		var wheel_zone := Rect2(origin + Vector2(470.0, 390.0), Vector2(190.0, 190.0))
		if player_rect.intersects(wheel_zone):
			cellar_drain_open = true
			cellar_drain_time = 2.0
			cellar_focus_time = 2.0
			cellar_focus_kind = "drain"
			cellar_checkpoint_region = "C"
			cellar_checkpoint_position = _cellar_spawn("C", "left")
			return

	if cellar_region == "Q" and cellar_drain_open and not cellar_has_stone:
		var quarry_stone_zone := Rect2(origin + Vector2(120.0, 455.0), Vector2(190.0, 125.0))
		if player_rect.intersects(quarry_stone_zone):
			cellar_has_stone = true
			return

	if cellar_region == "W" and cellar_required_wall_hits < CELLAR_WALL_HITS_REQUIRED:
		var required_wall_zone := Rect2(origin + Vector2(500.0, 285.0), Vector2(145.0, 300.0))
		if cellar_has_stone and player_rect.intersects(required_wall_zone):
			cellar_required_wall_hits += 1
			cellar_wall_hit_time = 0.48
			_spawn_cellar_dust(origin + Vector2(555.0, 440.0), CELLAR_STONE_COLOR)
			if cellar_required_wall_hits >= CELLAR_WALL_HITS_REQUIRED:
				cellar_has_stone = false
			return

	if cellar_region == "K" and not cellar_has_key:
		var key_zone := Rect2(origin + Vector2(475.0, 380.0), Vector2(210.0, 200.0))
		if player_rect.intersects(key_zone):
			cellar_has_key = true
			cellar_key_collected = true
			cellar_focus_time = 2.2
			cellar_focus_kind = "key"
			cellar_checkpoint_region = "H"
			cellar_checkpoint_position = _cellar_spawn("H", "up")
			return

	if cellar_region == "P":
		var prison_zone := Rect2(origin + Vector2(790.0, 315.0), Vector2(280.0, 270.0))
		if player_rect.intersects(prison_zone):
			cellar_wall_hit_time = 0.42
			if cellar_has_key:
				cellar_rescue_started = true
				cellar_focus_time = 2.7
				cellar_focus_kind = "rescue"
			return

	for portal in _cellar_portals():
		var portal_zone: Rect2 = portal["zone"]
		if not player_rect.intersects(portal_zone):
			continue
		cellar_region = String(portal["target"])
		player_position = portal["spawn"]
		player_velocity = Vector2.ZERO
		on_ground = true
		regular_jump_active = false
		cellar_transition_time = 0.34
		cellar_spawn_grace_time = 0.20
		cellar_camera = _cellar_camera_target()
		cellar_falling_rocks.clear()
		cellar_rock_spawn_timer = 0.55
		if cellar_region == "O" and not cellar_o_boulder_triggered:
			cellar_o_boulder_triggered = true
			cellar_o_boulder_landed = false
			cellar_o_boulder_fall_time = 0.82
			cellar_focus_time = 1.28
			cellar_focus_kind = "o_boulder"
		if cellar_region == "P" and not cellar_prison_discovered:
			cellar_prison_discovered = true
			cellar_focus_time = 2.45
			cellar_focus_kind = "prison"
		return

func _cellar_spike_entries() -> Array[Dictionary]:
	var origin: Vector2 = _cellar_region_origin(cellar_region)
	if cellar_region == "D":
		return [
			{"rect": Rect2(origin + Vector2(220.0, 522.0), Vector2(75.0, 38.0)), "phase": 0.0},
			{"rect": Rect2(origin + Vector2(525.0, 522.0), Vector2(90.0, 38.0)), "phase": 1.05},
		]
	if cellar_region == "F":
		return [
			{"rect": Rect2(origin + Vector2(205.0, 522.0), Vector2(95.0, 38.0)), "phase": 0.3},
			{"rect": Rect2(origin + Vector2(520.0, 522.0), Vector2(110.0, 38.0)), "phase": 1.4},
			{"rect": Rect2(origin + Vector2(930.0, 522.0), Vector2(125.0, 38.0)), "phase": 2.2},
		]
	return []

func _cellar_spike_strength(phase: float) -> float:
	var cycle: float = fmod(elapsed + phase, 3.4)
	if cycle < 1.25:
		return 0.0
	if cycle < 1.6:
		return smoothstep(1.25, 1.6, cycle)
	if cycle < 2.55:
		return 1.0
	return 1.0 - smoothstep(2.55, 3.08, cycle)

func _cellar_gas_entries() -> Array[Dictionary]:
	var origin: Vector2 = _cellar_region_origin(cellar_region)
	if cellar_region == "G":
		return [
			{"rect": Rect2(origin + Vector2(285.0, 330.0), Vector2(82.0, 230.0)), "phase": 0.0},
			{"rect": Rect2(origin + Vector2(520.0, 285.0), Vector2(90.0, 275.0)), "phase": 1.2},
			{"rect": Rect2(origin + Vector2(790.0, 350.0), Vector2(86.0, 210.0)), "phase": 2.15},
		]
	return []

func _cellar_gas_active(phase: float) -> bool:
	return fmod(elapsed + phase, 3.5) < 1.15

func _cellar_blade_rects() -> Array[Rect2]:
	if cellar_region != "R":
		return []
	var origin: Vector2 = _cellar_region_origin("R")
	var result: Array[Rect2] = []
	for blade_index in range(3):
		var pivot := origin + Vector2(300.0 + float(blade_index) * 255.0, 105.0)
		var swing_angle: float = sin(elapsed * 1.65 + float(blade_index) * 1.7) * 0.72
		var center: Vector2 = pivot + Vector2(sin(swing_angle) * 190.0, cos(swing_angle) * 190.0)
		result.append(Rect2(center - Vector2(25.0, 25.0), Vector2(50.0, 50.0)))
	return result

func _check_cellar_hazards() -> void:
	if cellar_failure_time > 0.0 or cellar_transition_time > 0.0:
		return
	var player_rect := Rect2(player_position, PLAYER_SIZE)
	for spike_entry in _cellar_spike_entries():
		var spike_rect: Rect2 = spike_entry["rect"]
		var strength: float = _cellar_spike_strength(float(spike_entry["phase"]))
		var hit_rect := Rect2(Vector2(spike_rect.position.x, spike_rect.end.y - spike_rect.size.y * strength), Vector2(spike_rect.size.x, spike_rect.size.y * strength))
		if strength > 0.52 and player_rect.intersects(hit_rect):
			_start_cellar_failure("spike")
			return
	for gas_entry in _cellar_gas_entries():
		if _cellar_gas_active(float(gas_entry["phase"])) and player_rect.intersects(gas_entry["rect"]):
			_start_cellar_failure("gas")
			return
	for blade_rect in _cellar_blade_rects():
		if player_rect.intersects(blade_rect):
			_start_cellar_failure("blade")
			return
	for rock in cellar_falling_rocks:
		var rock_center: Vector2 = rock["position"]
		var radius: float = float(rock["radius"])
		if player_rect.intersects(Rect2(rock_center - Vector2(radius, radius), Vector2(radius * 2.0, radius * 2.0))):
			_start_cellar_failure("rock")
			return

func _update_cellar_falling_rocks(delta: float) -> void:
	if cellar_region != "T":
		cellar_falling_rocks.clear()
		return
	cellar_rock_spawn_timer -= delta
	if cellar_rock_spawn_timer <= 0.0:
		var origin: Vector2 = _cellar_region_origin("T")
		var spawn_offsets: Array[float] = [260.0, 610.0, 910.0, 455.0, 785.0]
		var spawn_x: float = origin.x + spawn_offsets[cellar_rock_spawn_index % spawn_offsets.size()]
		cellar_falling_rocks.append({"position": Vector2(spawn_x, origin.y + 65.0), "velocity": 80.0, "radius": 24.0 + float(cellar_rock_spawn_index % 2) * 8.0})
		cellar_rock_spawn_index += 1
		cellar_rock_spawn_timer = 1.05 + float(cellar_rock_spawn_index % 3) * 0.18
	var floor_y: float = _cellar_region_origin("T").y + CELLAR_FLOOR_Y
	for rock_index in range(cellar_falling_rocks.size() - 1, -1, -1):
		var rock: Dictionary = cellar_falling_rocks[rock_index]
		var velocity: float = float(rock["velocity"]) + GRAVITY * delta * 0.82
		var position_value: Vector2 = rock["position"]
		position_value.y += velocity * delta
		rock["velocity"] = velocity
		rock["position"] = position_value
		cellar_falling_rocks[rock_index] = rock
		if position_value.y + float(rock["radius"]) >= floor_y:
			_spawn_cellar_dust(Vector2(position_value.x, floor_y), CELLAR_STONE_COLOR)
			cellar_wall_hit_time = maxf(cellar_wall_hit_time, 0.13)
			cellar_falling_rocks.remove_at(rock_index)

func _spawn_cellar_dust(origin: Vector2, color_value: Color) -> void:
	for dust_index in range(7):
		var angle: float = -PI + float(dust_index) * PI / 6.0
		cellar_dust.append({
			"position": origin,
			"velocity": Vector2(cos(angle) * (35.0 + float(dust_index % 3) * 20.0), sin(angle) * 42.0 - 28.0),
			"life": 0.55,
			"color": color_value,
		})

func _update_cellar_dust(delta: float) -> void:
	for dust_index in range(cellar_dust.size() - 1, -1, -1):
		var dust: Dictionary = cellar_dust[dust_index]
		var life: float = float(dust["life"]) - delta
		var velocity: Vector2 = dust["velocity"]
		var position_value: Vector2 = dust["position"]
		velocity.y += GRAVITY * delta * 0.18
		position_value += velocity * delta
		dust["life"] = life
		dust["velocity"] = velocity
		dust["position"] = position_value
		cellar_dust[dust_index] = dust
		if life <= 0.0:
			cellar_dust.remove_at(dust_index)

func _start_cellar_failure(kind: String) -> void:
	if cellar_failure_time > 0.0:
		return
	cellar_failure_time = 0.001
	cellar_failure_kind = kind
	player_velocity = Vector2(-player_facing * 150.0, -210.0)
	on_ground = false
	regular_jump_active = false

func _update_cellar_failure(delta: float) -> void:
	cellar_failure_time += delta
	player_velocity.y += GRAVITY * delta
	player_position += player_velocity * delta
	if cellar_failure_time < 0.72:
		return
	cellar_failure_time = 0.0
	cellar_failure_kind = ""
	cellar_region = cellar_checkpoint_region
	player_position = cellar_checkpoint_position
	player_velocity = Vector2.ZERO
	on_ground = false
	regular_jump_active = false
	cellar_transition_time = 0.48
	cellar_spawn_grace_time = 0.22
	cellar_camera = _cellar_camera_target()
	cellar_falling_rocks.clear()
	cellar_dust.clear()
	failure_flash = 0.22

func _reset_ropeway_attempt() -> void:
	ropeway_knots = [false, false, false, false, false]
	ropeway_knot_count = 0
	ropeway_chase_state = "idle"
	ropeway_warning_time = 0.0
	ropeway_boulder_progress = 0.0
	ropeway_boulder_position = ropeway_boulder_path[0]
	ropeway_boulder_angle = 0.0
	ropeway_boulder_speed = ROPEWAY_BOULDER_START_SPEED
	ropeway_boulder_fall_velocity = 0.0
	ropeway_failure_time = 0.0
	ropeway_failure_reason = ""
	ropeway_collect_time = 0.0
	ropeway_collect_origin = Vector2.ZERO
	ropeway_rope_installed = false
	ropeway_climb_time = 0.0
	ropeway_status_text = ""
	ropeway_status_time = 0.0

func _update_ropeway_chase(delta: float) -> void:
	if ropeway_chase_state == "idle" and player_position.x + PLAYER_SIZE.x * 0.5 >= ROPEWAY_TRIGGER_X:
		ropeway_chase_state = "warning"
		ropeway_warning_time = 0.68
		ropeway_status_text = "身后的石槽开始震动"
		ropeway_status_time = 1.7
	elif ropeway_chase_state == "warning":
		ropeway_warning_time = maxf(0.0, ropeway_warning_time - delta)
		ropeway_boulder_position = ropeway_boulder_path[0] + Vector2(
			sin(elapsed * 28.0) * 3.0,
			absf(sin(elapsed * 19.0)) * 2.0
		)
		if ropeway_warning_time <= 0.0:
			ropeway_chase_state = "rolling"
	elif ropeway_chase_state == "rolling":
		var path_length: float = _ropeway_path_length()
		ropeway_boulder_speed = minf(
			ROPEWAY_BOULDER_MAX_SPEED,
			ropeway_boulder_speed + ROPEWAY_BOULDER_ACCELERATION * delta
		)
		ropeway_boulder_progress = minf(
			1.0,
			ropeway_boulder_progress + delta * ropeway_boulder_speed / path_length
		)
		ropeway_boulder_position = _point_on_ropeway_path(ropeway_boulder_progress)
		ropeway_boulder_angle += delta * ropeway_boulder_speed / ROPEWAY_BOULDER_RADIUS
		if ropeway_boulder_progress >= 0.999:
			ropeway_chase_state = "falling"
			ropeway_boulder_fall_velocity = 90.0
	elif ropeway_chase_state == "falling":
		ropeway_boulder_fall_velocity += GRAVITY * delta
		ropeway_boulder_position.y += ropeway_boulder_fall_velocity * delta
		ropeway_boulder_angle += delta * 8.4
		if ropeway_boulder_position.y > 820.0:
			ropeway_chase_state = "gone"

func _try_ropeway_interaction() -> void:
	if not Input.is_action_just_pressed("interact"):
		return
	var active_knot: int = _active_ropeway_knot()
	if active_knot >= 0 and _can_collect_ropeway_knot(active_knot):
		ropeway_knots[active_knot] = true
		ropeway_knot_count += 1
		ropeway_collect_origin = ROPEWAY_KNOTS[active_knot].get_center()
		ropeway_collect_time = 0.48
		ropeway_status_text = "长绳 %d / 5" % ropeway_knot_count
		ropeway_status_time = 1.25
		return
	if active_knot >= 0 and ROPEWAY_KNOT_APEX_REQUIRED[active_knot] and _ropeway_knot_prompt_visible(active_knot):
		ropeway_status_text = "要在跳跃最高点收绳"
		ropeway_status_time = 0.9
		return

	var player_rect := Rect2(player_position, PLAYER_SIZE)
	if not player_rect.intersects(ROPEWAY_CLIMB_ZONE):
		return
	if ropeway_knot_count < ROPEWAY_KNOTS.size():
		ropeway_status_text = "绳子还不够长"
		ropeway_status_time = 1.4
		return
	ropeway_rope_installed = true
	ropeway_climb_time = 0.001
	player_position = Vector2(ROPEWAY_CLIMB_ANCHOR.x - PLAYER_SIZE.x * 0.5, 416.0)
	player_velocity = Vector2.ZERO
	on_ground = false
	ropeway_status_text = "抛出绳头"
	ropeway_status_time = 1.0

func _active_ropeway_knot() -> int:
	for index in range(ropeway_knots.size()):
		if not ropeway_knots[index]:
			return index
	return -1

func _can_collect_ropeway_knot(index: int) -> bool:
	var knot: Rect2 = ROPEWAY_KNOTS[index]
	var player_rect := Rect2(player_position, PLAYER_SIZE)
	if ROPEWAY_KNOT_APEX_REQUIRED[index]:
		return (
			not on_ground
			and absf(player_velocity.y) <= 115.0
			and player_rect.intersects(_ropeway_apex_pickup_zone(index))
		)
	if ROPEWAY_KNOT_HANGING[index]:
		return player_rect.grow(10.0).intersects(knot)
	return player_rect.grow(12.0).intersects(knot) or (player_position + PLAYER_SIZE * 0.5).distance_to(knot.get_center()) < 62.0

func _ropeway_apex_pickup_zone(index: int) -> Rect2:
	var knot: Rect2 = ROPEWAY_KNOTS[index]
	# Keep the original vertical tolerance, but widen the horizontal reach so the
	# player can collect from either side of the jump instead of pixel-aligning.
	return Rect2(knot.position - Vector2(28.0, 7.0), knot.size + Vector2(56.0, 14.0))

func _ropeway_knot_prompt_visible(index: int) -> bool:
	if _can_collect_ropeway_knot(index):
		return true
	if not ROPEWAY_KNOT_HANGING[index]:
		return false
	var knot: Rect2 = ROPEWAY_KNOTS[index]
	var player_center: Vector2 = player_position + PLAYER_SIZE * 0.5
	var horizontal_prompt_reach: float = 72.0 if ROPEWAY_KNOT_APEX_REQUIRED[index] else 34.0
	return absf(player_center.x - knot.get_center().x) < horizontal_prompt_reach and player_center.y > knot.get_center().y

func _update_ropeway_climb(delta: float) -> void:
	ropeway_climb_time += delta
	_update_ropeway_chase(delta)
	var climb_ratio: float = clampf(ropeway_climb_time / 1.55, 0.0, 1.0)
	var climb_ease: float = smoothstep(0.0, 1.0, climb_ratio)
	player_position.x = ROPEWAY_CLIMB_ANCHOR.x - PLAYER_SIZE.x * 0.5 + sin(climb_ratio * TAU * 3.0) * 2.5
	player_position.y = lerpf(416.0, 138.0, climb_ease)
	player_velocity = Vector2.ZERO
	camera_axis = 1110.0
	if climb_ratio >= 1.0:
		_enter_level_02_cave()

func _start_ropeway_failure(reason: String) -> void:
	ropeway_failure_reason = reason
	ropeway_failure_time = 0.001
	player_velocity = Vector2(-player_facing * 150.0, -185.0)
	on_ground = false
	regular_jump_active = false

func _update_ropeway_failure(delta: float) -> void:
	ropeway_failure_time += delta
	player_velocity.y += GRAVITY * delta
	player_position += player_velocity * delta
	camera_axis = clampf(player_position.x - 330.0, 0.0, 1110.0)
	if ropeway_failure_time >= 0.78:
		player_position = checkpoint_position
		player_velocity = Vector2.ZERO
		camera_axis = 0.0
		entry_fall_lock = 0.0
		on_ground = false
		regular_jump_active = false
		failure_flash = 0.28
		_reset_ropeway_attempt()

func _ropeway_boulder_rect() -> Rect2:
	var diameter: float = ROPEWAY_BOULDER_RADIUS * 1.82
	return Rect2(
		ropeway_boulder_position - Vector2(diameter, diameter) * 0.5,
		Vector2(diameter, diameter)
	)

func _ropeway_path_length() -> float:
	var total: float = 0.0
	for index in range(ropeway_boulder_path.size() - 1):
		total += ropeway_boulder_path[index].distance_to(ropeway_boulder_path[index + 1])
	return maxf(total, 1.0)

func _point_on_ropeway_path(amount: float) -> Vector2:
	var remaining: float = clampf(amount, 0.0, 1.0) * _ropeway_path_length()
	for index in range(ropeway_boulder_path.size() - 1):
		var start: Vector2 = ropeway_boulder_path[index]
		var finish: Vector2 = ropeway_boulder_path[index + 1]
		var span: float = start.distance_to(finish)
		if remaining <= span or index == ropeway_boulder_path.size() - 2:
			var ratio: float = 0.0 if span <= 0.001 else remaining / span
			return start.lerp(finish, clampf(ratio, 0.0, 1.0))
		remaining -= span
	return ropeway_boulder_path[ropeway_boulder_path.size() - 1]

func _ropeway_moving_platform(sample_time: float) -> Rect2:
	return Rect2(1435.0 + sin(sample_time * 1.45) * 65.0, 560.0, 48.0, 20.0)

func _enter_level_02_cave() -> void:
	room = Room.LEVEL_02_CAVE
	cave_chest_open = false
	shield_acquired = false
	_reset_cave_attempt(false)
	room_intro_time = 4.2
	cave_entry_fade_time = 0.85

func _reset_cave_attempt(preserve_shield: bool) -> void:
	var keep_mid_checkpoint: bool = preserve_shield and cave_mid_checkpoint_active
	if not preserve_shield:
		cave_chest_open = false
		shield_acquired = false
		cave_mid_checkpoint_active = false
	if keep_mid_checkpoint:
		player_position = CAVE_MID_CHECKPOINT_POSITION
	elif shield_acquired:
		player_position = CAVE_SHIELD_CHECKPOINT
	else:
		player_position = CAVE_START_POSITION
	checkpoint_position = player_position
	player_velocity = Vector2.ZERO
	player_facing = 1.0
	on_ground = false
	regular_jump_active = false
	camera_axis = clampf(player_position.x - 390.0, 0.0, CAVE_WORLD_WIDTH - SCREEN.x)
	shield_pickup_time = 0.0
	shield_input_active = false
	shield_press_time = 0.0
	shield_guarding = false
	shield_parry_time = 0.0
	shield_parry_hit_time = 0.0
	shield_block_hit_time = 0.0
	cave_rolling_rocks.clear()
	cave_falling_rocks.clear()
	cave_arrows.clear()
	cave_dust_puffs.clear()
	cave_rolling_spawn_timer = CAVE_ROLLING_INITIAL_DELAY
	cave_rolling_spawn_count = 0
	cave_drop_event_index = 0
	if keep_mid_checkpoint:
		var drop_schedule: Array[Dictionary] = _cave_drop_schedule()
		while (
			cave_drop_event_index < drop_schedule.size()
			and float(drop_schedule[cave_drop_event_index]["trigger_x"]) <= CAVE_MID_CHECKPOINT_POSITION.x
		):
			cave_drop_event_index += 1
	cave_arrow_launcher_destroyed = keep_mid_checkpoint
	cave_failure_time = 0.0
	cave_failure_reason = ""
	cave_status_text = ""
	cave_status_time = 0.0
	cave_tutorial_time = 0.0
	cave_arrow_timer = 0.58
	cave_rock_impact_time = 0.0
	cave_rock_impact_strength = 0.0

func _update_level_02_cave(delta: float) -> void:
	if cave_failure_time > 0.0:
		_update_cave_failure(delta)
		return

	_update_player(delta, CAVE_PLATFORMS, Vector2(-20.0, CAVE_WORLD_WIDTH), true)
	camera_axis = clampf(player_position.x - 390.0, 0.0, CAVE_WORLD_WIDTH - SCREEN.x)

	if not shield_acquired:
		player_position.x = minf(player_position.x, CAVE_SHIELD_GATE_X)
		if player_velocity.x > 0.0 and player_position.x >= CAVE_SHIELD_GATE_X:
			player_velocity.x = 0.0
		_try_open_cave_chest()
	else:
		_update_shield_action(delta)
		_update_cave_mid_checkpoint()
		if shield_pickup_time <= 0.35:
			_update_cave_rolling_source(delta)
			_trigger_cave_drop_hazards()

	_update_cave_rolling_rocks(delta)
	_update_cave_falling_rocks(delta)
	_update_cave_arrow_trap(delta)
	_update_cave_dust(delta)
	_resolve_cave_hazard_collisions()
	if cave_failure_time > 0.0:
		return

	if player_position.y > SCREEN.y + 90.0:
		_start_cave_failure("坠入断崖")
		return
	if player_position.x + PLAYER_SIZE.x * 0.5 >= CAVE_EXIT_X:
		room = Room.LEVEL_02_COMPLETE
		completion_time = 0.0
		player_velocity = Vector2.ZERO

func _try_open_cave_chest() -> void:
	if cave_chest_open or not Input.is_action_just_pressed("interact"):
		return
	if not Rect2(player_position, PLAYER_SIZE).intersects(CAVE_CHEST_INTERACTION):
		return
	cave_chest_open = true
	shield_acquired = true
	shield_pickup_time = 0.95
	checkpoint_position = CAVE_SHIELD_CHECKPOINT
	cave_status_text = "获得盾牌"
	cave_status_time = 1.7
	cave_tutorial_time = 4.6

func _update_cave_mid_checkpoint() -> void:
	if cave_mid_checkpoint_active or not on_ground:
		return
	var player_rect: Rect2 = Rect2(player_position, PLAYER_SIZE)
	if not player_rect.intersects(CAVE_MID_CHECKPOINT_ZONE):
		return
	cave_mid_checkpoint_active = true
	checkpoint_position = CAVE_MID_CHECKPOINT_POSITION
	cave_arrow_launcher_destroyed = true
	cave_status_text = "山洞中段检查点已记录"
	cave_status_time = 2.0

func _update_shield_action(delta: float) -> void:
	shield_parry_time = maxf(0.0, shield_parry_time - delta)
	if Input.is_action_just_pressed("interact"):
		shield_input_active = true
		shield_press_time = 0.0
		shield_guarding = false
	if not shield_input_active:
		return
	if Input.is_action_pressed("interact"):
		shield_press_time += delta
		if shield_press_time >= SHIELD_HOLD_THRESHOLD:
			shield_guarding = true
		return
	if not shield_guarding:
		shield_parry_time = SHIELD_PARRY_DURATION
	shield_input_active = false
	shield_press_time = 0.0
	shield_guarding = false

func _update_cave_rolling_source(delta: float) -> void:
	cave_rolling_spawn_timer -= delta
	while cave_rolling_spawn_timer <= 0.0:
		var pattern_index: int = cave_rolling_spawn_count % CAVE_ROLLING_PATTERN.size()
		var kind: String = CAVE_ROLLING_PATTERN[pattern_index]
		var launch_speed: float = 455.0 if kind == "large" else 500.0
		_spawn_cave_rolling_rock(kind, CAVE_ROLLING_SOURCE_X, launch_speed, true)
		cave_rolling_spawn_count += 1
		var next_interval: float = maxf(
			CAVE_ROLLING_MIN_INTERVAL,
			CAVE_ROLLING_BASE_INTERVAL - float(cave_rolling_spawn_count) * 0.055
		)
		cave_rolling_spawn_timer += next_interval

func _trigger_cave_drop_hazards() -> void:
	var drop_schedule: Array[Dictionary] = _cave_drop_schedule()
	while cave_drop_event_index < drop_schedule.size():
		var drop_event: Dictionary = drop_schedule[cave_drop_event_index]
		if player_position.x < float(drop_event["trigger_x"]):
			break
		_spawn_cave_falling_rock(float(drop_event["drop_x"]), float(drop_event["warning_time"]))
		cave_drop_event_index += 1

func _cave_drop_schedule() -> Array[Dictionary]:
	return [
		{"trigger_x": 420.0, "drop_x": 565.0, "warning_time": 0.72},
		{"trigger_x": 850.0, "drop_x": 1000.0, "warning_time": 0.66},
		{"trigger_x": 1305.0, "drop_x": 1460.0, "warning_time": 0.62},
		{"trigger_x": 1745.0, "drop_x": 1915.0, "warning_time": 0.58},
		{"trigger_x": 2185.0, "drop_x": 2360.0, "warning_time": 0.55},
		{"trigger_x": 2610.0, "drop_x": 2790.0, "warning_time": 0.52},
		{"trigger_x": 3060.0, "drop_x": 3350.0, "warning_time": 0.50},
		{"trigger_x": 3500.0, "drop_x": 3780.0, "warning_time": 0.48},
		{"trigger_x": 3930.0, "drop_x": 4210.0, "warning_time": 0.46},
	]

func _spawn_cave_rolling_rock(kind: String, spawn_x: float, speed: float, drop_from_source: bool) -> void:
	var radius: float = 64.0 if kind == "large" else 22.0
	var floor_y: float = _cave_platform_floor_y(spawn_x)
	cave_rolling_rocks.append({
		"kind": kind,
		"position": Vector2(spawn_x, 42.0 if drop_from_source else floor_y - radius),
		"speed": speed,
		"radius": radius,
		"angle": 0.0,
		"state": "falling" if drop_from_source else "rolling",
		"fall_velocity": 0.0,
		"shatter_time": 0.0,
	})

func _spawn_cave_falling_rock(drop_x: float, warning_time: float) -> void:
	cave_falling_rocks.append({
		"position": Vector2(drop_x, 72.0),
		"radius": 25.0,
		"state": "warning",
		"warning_time": warning_time,
		"fall_velocity": 0.0,
		"angle": 0.0,
	})

func _update_cave_rolling_rocks(delta: float) -> void:
	for index in range(cave_rolling_rocks.size()):
		var rock: Dictionary = cave_rolling_rocks[index]
		var state: String = String(rock["state"])
		if state == "rolling":
			var speed: float = float(rock["speed"]) + CAVE_ROLLING_ACCELERATION * delta
			var radius: float = float(rock["radius"])
			var position_value: Vector2 = rock["position"]
			position_value.x -= speed * delta
			var floor_y: float = _cave_platform_floor_y(position_value.x)
			if floor_y < SCREEN.y:
				position_value.y = floor_y - radius
			else:
				rock["state"] = "falling"
				rock["fall_velocity"] = 0.0
			rock["speed"] = speed
			rock["position"] = position_value
			rock["angle"] = float(rock["angle"]) - speed * delta / radius
		elif state == "falling":
			var radius: float = float(rock["radius"])
			var speed: float = float(rock["speed"]) + CAVE_ROLLING_ACCELERATION * delta
			var falling_position: Vector2 = rock["position"]
			var previous_bottom: float = falling_position.y + radius
			var fall_velocity: float = float(rock["fall_velocity"]) + GRAVITY * delta
			falling_position.x -= speed * delta
			falling_position.y += fall_velocity * delta
			var floor_y: float = _cave_platform_floor_y(falling_position.x)
			var new_bottom: float = falling_position.y + radius
			var landing_tolerance: float = maxf(16.0, radius * 0.42)
			if (
				floor_y < SCREEN.y
				and previous_bottom <= floor_y + 8.0
				and new_bottom >= floor_y
				and new_bottom <= floor_y + landing_tolerance
			):
				falling_position.y = floor_y - radius
				rock["state"] = "rolling"
				rock["fall_velocity"] = 0.0
				_spawn_cave_dust(Vector2(falling_position.x, floor_y), radius)
			else:
				rock["fall_velocity"] = fall_velocity
			rock["position"] = falling_position
			rock["speed"] = speed
			rock["angle"] = float(rock["angle"]) - speed * delta / radius
			if falling_position.y > 820.0 or falling_position.x < -140.0:
				rock["state"] = "gone"
		elif state == "shattered":
			var shatter_time: float = maxf(0.0, float(rock["shatter_time"]) - delta)
			rock["shatter_time"] = shatter_time
			if shatter_time <= 0.0:
				rock["state"] = "gone"
		cave_rolling_rocks[index] = rock

func _update_cave_falling_rocks(delta: float) -> void:
	for index in range(cave_falling_rocks.size()):
		var rock: Dictionary = cave_falling_rocks[index]
		var state: String = String(rock["state"])
		if state == "warning":
			var warning_time: float = maxf(0.0, float(rock["warning_time"]) - delta)
			rock["warning_time"] = warning_time
			if warning_time <= 0.0:
				rock["state"] = "falling"
				rock["fall_velocity"] = 90.0
		elif state == "falling":
			var position_value: Vector2 = rock["position"]
			var fall_velocity: float = float(rock["fall_velocity"]) + GRAVITY * delta
			position_value.y += fall_velocity * delta
			rock["position"] = position_value
			rock["fall_velocity"] = fall_velocity
			rock["angle"] = float(rock["angle"]) + delta * 8.0
			if position_value.y > 820.0:
				rock["state"] = "gone"
		cave_falling_rocks[index] = rock

func _spawn_cave_dust(impact_position: Vector2, rock_radius: float) -> void:
	var dust_scale: float = clampf(rock_radius / 32.0, 0.75, 2.1)
	cave_dust_puffs.append({
		"position": impact_position,
		"time": 0.62,
		"scale": dust_scale,
	})
	if cave_rock_impact_time <= 0.0:
		cave_rock_impact_strength = 0.0
	var viewport_center_x: float = camera_axis + SCREEN.x * 0.5
	var visibility: float = clampf(1.0 - absf(impact_position.x - viewport_center_x) / 900.0, 0.0, 1.0)
	if visibility > 0.0:
		cave_rock_impact_time = 0.20
		cave_rock_impact_strength = maxf(cave_rock_impact_strength, dust_scale * visibility)

func _update_cave_dust(delta: float) -> void:
	for index in range(cave_dust_puffs.size() - 1, -1, -1):
		var puff: Dictionary = cave_dust_puffs[index]
		var remaining: float = float(puff["time"]) - delta
		if remaining <= 0.0:
			cave_dust_puffs.remove_at(index)
			continue
		puff["time"] = remaining
		cave_dust_puffs[index] = puff

func _update_cave_arrow_trap(delta: float) -> void:
	var player_center: Vector2 = player_position + PLAYER_SIZE * 0.5
	if not cave_arrow_launcher_destroyed and shield_acquired and CAVE_ARROW_TRIGGER.has_point(player_center):
		cave_arrow_timer -= delta
		if cave_arrow_timer <= 0.0:
			cave_arrows.append({
				"position": CAVE_ARROW_LAUNCHER,
				"state": "flying",
			})
			cave_arrow_timer = CAVE_ARROW_INTERVAL
	elif player_center.x < CAVE_ARROW_TRIGGER.position.x:
		cave_arrow_timer = minf(cave_arrow_timer, 0.58)

	for index in range(cave_arrows.size()):
		var arrow: Dictionary = cave_arrows[index]
		if String(arrow["state"]) != "flying":
			continue
		var arrow_position: Vector2 = arrow["position"]
		arrow_position.x -= CAVE_ARROW_SPEED * delta
		arrow["position"] = arrow_position
		if arrow_position.x < 1410.0:
			arrow["state"] = "gone"
		cave_arrows[index] = arrow

func _resolve_cave_hazard_collisions() -> void:
	var player_rect: Rect2 = Rect2(player_position, PLAYER_SIZE).grow(-2.0)
	var parry_rect: Rect2 = _shield_parry_rect()
	var guard_rect: Rect2 = _shield_guard_rect()
	if (
		not cave_arrow_launcher_destroyed
		and shield_parry_time > 0.0
		and parry_rect.intersects(CAVE_ARROW_LAUNCHER_HITBOX)
	):
		cave_arrow_launcher_destroyed = true
		shield_parry_time = 0.0
		shield_parry_hit_time = 0.30
		cave_status_text = "弩机已摧毁"
		cave_status_time = 1.35
	for index in range(cave_rolling_rocks.size()):
		var rock: Dictionary = cave_rolling_rocks[index]
		var rock_state: String = String(rock["state"])
		if rock_state != "rolling" and rock_state != "falling":
			continue
		var rock_rect: Rect2 = _cave_rock_rect(rock)
		if shield_parry_time > 0.0 and parry_rect.intersects(rock_rect):
			rock["state"] = "shattered"
			rock["shatter_time"] = SHIELD_SHATTER_DURATION
			cave_rolling_rocks[index] = rock
			shield_parry_time = 0.0
			shield_parry_hit_time = 0.30
			continue
		if player_rect.intersects(rock_rect):
			_start_cave_failure("举盾挡不住滚石" if shield_guarding else "被滚石撞倒")
			return

	for rock in cave_falling_rocks:
		if String(rock["state"]) != "falling":
			continue
		if player_rect.intersects(_cave_rock_rect(rock)):
			_start_cave_failure("被头顶落石砸中")
			return

	for index in range(cave_arrows.size()):
		var arrow: Dictionary = cave_arrows[index]
		if String(arrow["state"]) != "flying":
			continue
		var arrow_position: Vector2 = arrow["position"]
		var arrow_rect: Rect2 = Rect2(arrow_position - Vector2(24.0, 4.0), Vector2(48.0, 8.0))
		if shield_guarding and guard_rect.intersects(arrow_rect):
			arrow["state"] = "gone"
			cave_arrows[index] = arrow
			shield_block_hit_time = 0.16
			continue
		if player_rect.intersects(arrow_rect):
			_start_cave_failure("飞箭需要持续举盾")
			return

func _cave_platform_floor_y(world_x: float) -> float:
	for platform_rect in CAVE_PLATFORMS:
		if world_x >= platform_rect.position.x and world_x <= platform_rect.end.x:
			return platform_rect.position.y
	return 760.0

func _cave_rock_rect(rock: Dictionary) -> Rect2:
	var radius: float = float(rock["radius"])
	var position_value: Vector2 = rock["position"]
	return Rect2(position_value - Vector2(radius, radius), Vector2(radius * 2.0, radius * 2.0))

func _shield_parry_rect() -> Rect2:
	var center: Vector2 = player_position + PLAYER_SIZE * 0.5
	if player_facing >= 0.0:
		return Rect2(center + Vector2(5.0, -48.0), Vector2(78.0, 96.0))
	return Rect2(center + Vector2(-83.0, -48.0), Vector2(78.0, 96.0))

func _shield_guard_rect() -> Rect2:
	var center: Vector2 = player_position + PLAYER_SIZE * 0.5
	if player_facing >= 0.0:
		return Rect2(center + Vector2(4.0, -36.0), Vector2(46.0, 72.0))
	return Rect2(center + Vector2(-50.0, -36.0), Vector2(46.0, 72.0))

func _start_cave_failure(reason: String) -> void:
	if cave_failure_time > 0.0:
		return
	cave_failure_time = 0.001
	cave_failure_reason = reason
	shield_input_active = false
	shield_guarding = false
	shield_parry_time = 0.0
	player_velocity = Vector2(-player_facing * 145.0, -210.0)
	on_ground = false
	regular_jump_active = false

func _update_cave_failure(delta: float) -> void:
	cave_failure_time += delta
	player_velocity.y += GRAVITY * delta
	player_position += player_velocity * delta
	camera_axis = clampf(player_position.x - 390.0, 0.0, CAVE_WORLD_WIDTH - SCREEN.x)
	if cave_failure_time >= 0.78:
		_reset_cave_attempt(true)
		failure_flash = 0.28

func _update_player(delta: float, platform_list: Array[Rect2], horizontal_bounds: Vector2, allow_input: bool) -> void:
	if Input.is_action_just_pressed("jump"):
		jump_buffer = 0.13
	jump_buffer = maxf(0.0, jump_buffer - delta)

	var direction := 0.0
	if allow_input:
		direction = Input.get_axis("move_left", "move_right")
	if direction != 0.0:
		player_facing = signf(direction)
	var target_speed := direction * RUN_SPEED
	player_velocity.x = move_toward(player_velocity.x, target_speed, (2300.0 if direction != 0.0 else 3000.0) * delta)

	if on_ground:
		coyote_time = 0.12
	else:
		coyote_time = maxf(0.0, coyote_time - delta)
	if allow_input and jump_buffer > 0.0 and coyote_time > 0.0:
		player_velocity.y = JUMP_SPEED
		jump_buffer = 0.0
		coyote_time = 0.0
		on_ground = false
		regular_jump_active = true
	if regular_jump_active:
		if not Input.is_action_pressed("jump") and player_velocity.y < -185.0:
			player_velocity.y = -185.0
			regular_jump_active = false
		elif player_velocity.y >= 0.0:
			regular_jump_active = false

	player_velocity.y += GRAVITY * delta
	player_position.x += player_velocity.x * delta
	player_position.x = clampf(player_position.x, horizontal_bounds.x, horizontal_bounds.y - PLAYER_SIZE.x)

	var previous_bottom := player_position.y + PLAYER_SIZE.y
	player_position.y += player_velocity.y * delta
	on_ground = false
	if player_velocity.y >= 0.0:
		for platform_rect in platform_list:
			var new_bottom := player_position.y + PLAYER_SIZE.y
			var horizontal_overlap: bool = (
				player_position.x + PLAYER_SIZE.x > platform_rect.position.x + 3.0
				and player_position.x < platform_rect.end.x - 3.0
			)
			if not horizontal_overlap:
				continue
			if previous_bottom <= platform_rect.position.y + 5.0 and new_bottom >= platform_rect.position.y:
				player_position.y = platform_rect.position.y - PLAYER_SIZE.y
				player_velocity.y = 0.0
				on_ground = true
				break

func _carry_player_with_dynamic_platform(previous_rects: Array[Rect2], current_rects: Array[Rect2]) -> void:
	if not on_ground or previous_rects.size() != current_rects.size():
		return
	var player_bottom := player_position.y + PLAYER_SIZE.y
	for index in range(previous_rects.size()):
		var old_rect: Rect2 = previous_rects[index]
		var standing_on_top: bool = (
			absf(player_bottom - old_rect.position.y) <= 4.0
			and player_position.x + PLAYER_SIZE.x > old_rect.position.x + 4.0
			and player_position.x < old_rect.end.x - 4.0
		)
		if standing_on_top:
			player_position += current_rects[index].position - old_rect.position
			return

func _cavern_dynamic_platforms(sample_time: float) -> Array[Rect2]:
	var result: Array[Rect2] = []
	if not water_blocked:
		return result
	result.append(Rect2(690.0 + sin(sample_time * 1.25) * 70.0, 515.0, 110.0, 20.0))
	result.append(Rect2(1530.0 + sin(sample_time * 0.92 + 1.4) * 75.0, 510.0, 72.0, 18.0))
	result.append(Rect2(2160.0, 350.0 + sin(sample_time * 0.78 + 0.8) * 70.0, 68.0, 18.0))
	var cable_ratio := (sin(sample_time * 0.72) + 1.0) * 0.5
	var cable_position := Vector2(2480.0, 285.0).lerp(Vector2(2870.0, 235.0), cable_ratio)
	result.append(Rect2(cable_position, Vector2(104.0, 18.0)))
	return result

func _reset_pickup_items() -> void:
	pickup_items = [
		_make_pickup("stone", Vector2(340.0, 532.0), 14.0),
		_make_pickup("wood", Vector2(430.0, 530.0), 16.0),
		_make_pickup("scrap", Vector2(520.0, 532.0), 13.0),
	]
	held_item_index = -1
	throw_preparing = false
	throw_hold_time = 0.0
	lodged_item_index = -1

func _make_pickup(kind: String, spawn_position: Vector2, radius: float) -> Dictionary:
	return {
		"kind": kind,
		"position": spawn_position,
		"spawn": spawn_position,
		"velocity": Vector2.ZERO,
		"radius": radius,
		"state": "waiting",
		"spout_cooldown": 0.0,
	}

func _update_pickup_interaction(delta: float, platform_list: Array[Rect2]) -> void:
	if held_item_index >= 0:
		throw_angle = clampf(
			throw_angle + Input.get_axis("aim_up", "aim_down") * 1.55 * delta,
			-1.38,
			-0.18
		)

	if Input.is_action_just_pressed("interact"):
		if held_item_index >= 0:
			throw_preparing = true
			throw_hold_time = 0.0
		else:
			_try_pick_up_item()

	if not throw_preparing:
		return
	if Input.is_action_pressed("interact"):
		throw_hold_time = minf(1.0, throw_hold_time + delta)
		return
	_release_held_item(platform_list)

func _try_pick_up_item() -> void:
	var nearest_index := -1
	var nearest_distance := 68.0
	var player_center := player_position + PLAYER_SIZE * 0.5
	for index in range(pickup_items.size()):
		var item: Dictionary = pickup_items[index]
		if item["state"] != "waiting":
			continue
		var distance: float = player_center.distance_to(item["position"])
		if distance < nearest_distance:
			nearest_distance = distance
			nearest_index = index
	if nearest_index < 0:
		return
	held_item_index = nearest_index
	pickup_items[nearest_index]["state"] = "carried"
	pickup_items[nearest_index]["velocity"] = Vector2.ZERO

func _release_held_item(_platform_list: Array[Rect2]) -> void:
	if held_item_index < 0:
		throw_preparing = false
		return
	var item: Dictionary = pickup_items[held_item_index]
	var ratio := clampf((throw_hold_time - THROW_HOLD_THRESHOLD) / 0.82, 0.0, 1.0)
	if throw_hold_time < THROW_HOLD_THRESHOLD:
		item["state"] = "waiting"
		item["position"] = player_position + Vector2(PLAYER_SIZE.x * 0.5 + player_facing * 28.0, PLAYER_SIZE.y - item["radius"])
		item["velocity"] = Vector2.ZERO
	else:
		var strength := lerpf(THROW_MIN_SPEED, THROW_MAX_SPEED, ratio)
		var direction := Vector2(player_facing * cos(throw_angle), sin(throw_angle)).normalized()
		item["state"] = "thrown"
		item["position"] = _held_item_position()
		item["velocity"] = direction * strength
	pickup_items[held_item_index] = item
	held_item_index = -1
	throw_preparing = false
	throw_hold_time = 0.0

func _update_pickup_items(delta: float, platform_list: Array[Rect2]) -> void:
	for index in range(pickup_items.size()):
		var item: Dictionary = pickup_items[index]
		var spout_cooldown: float = maxf(0.0, float(item["spout_cooldown"]) - delta)
		item["spout_cooldown"] = spout_cooldown
		if index == held_item_index:
			item["position"] = _held_item_position()
			item["velocity"] = Vector2.ZERO
			pickup_items[index] = item
			continue
		if item["state"] == "lodged":
			continue
		if item["state"] != "thrown":
			pickup_items[index] = item
			continue

		var velocity_value: Vector2 = item["velocity"]
		var position_value: Vector2 = item["position"]
		velocity_value.y += GRAVITY * delta
		position_value += velocity_value * delta
		item["velocity"] = velocity_value
		item["position"] = position_value

		if spout_cooldown <= 0.0 and SPOUT_TARGET.has_point(position_value):
			if item["kind"] == "stone":
				item["state"] = "lodged"
				item["position"] = SPOUT_VISUAL.get_center() + Vector2(0.0, 12.0)
				item["velocity"] = Vector2.ZERO
				water_blocked = true
				lodged_item_index = index
				failure_flash = 0.16
				pickup_items[index] = item
				continue
			var reject_direction: float = -signf(velocity_value.x)
			if is_zero_approx(reject_direction):
				reject_direction = -1.0
			velocity_value = Vector2(reject_direction * 390.0, 175.0)
			item["velocity"] = velocity_value
			item["spout_cooldown"] = 0.42
			spout_reject_time = 0.86
			spout_reject_origin = position_value
			failure_flash = maxf(failure_flash, 0.1)

		var radius: float = item["radius"]
		if velocity_value.y >= 0.0:
			for platform_rect in platform_list:
				var inside_x: bool = (
					position_value.x + radius > platform_rect.position.x
					and position_value.x - radius < platform_rect.end.x
				)
				var crossed_top: bool = (
					position_value.y + radius >= platform_rect.position.y
					and position_value.y + radius - velocity_value.y * delta <= platform_rect.position.y + 4.0
				)
				if inside_x and crossed_top:
					item["position"] = Vector2(position_value.x, platform_rect.position.y - radius)
					item["velocity"] = Vector2(velocity_value.x * 0.34, -absf(velocity_value.y) * 0.18)
					if absf(velocity_value.y) < 130.0:
						item["velocity"] = Vector2.ZERO
						item["state"] = "waiting"
					break

		if item["position"].y > 760.0 or item["position"].x < -80.0 or item["position"].x > 3400.0:
			item["position"] = item["spawn"]
			item["velocity"] = Vector2.ZERO
			item["state"] = "waiting"
		pickup_items[index] = item

func _held_item_position() -> Vector2:
	return player_position + Vector2(PLAYER_SIZE.x * 0.5 + player_facing * 27.0, 24.0)

func _player_in_active_gas() -> bool:
	var player_rect := Rect2(player_position, PLAYER_SIZE)
	for gas_column in _cavern_gas_columns():
		var gas_rect: Rect2 = gas_column["rect"]
		if _gas_active(float(gas_column["phase"])) and player_rect.intersects(gas_rect):
			return true
	return false

func _cavern_gas_columns() -> Array[Dictionary]:
	return [
		{"rect": Rect2(1160.0, 375.0, 48.0, 160.0), "phase": 0.0},
		{"rect": Rect2(1360.0, 365.0, 48.0, 170.0), "phase": 1.35},
		{"rect": Rect2(1510.0, 350.0, 48.0, 160.0), "phase": 2.20},
		{"rect": Rect2(1792.0, 325.0, 48.0, 160.0), "phase": 0.65},
		{"rect": Rect2(1970.0, 325.0, 48.0, 160.0), "phase": 1.85},
		{"rect": Rect2(2110.0, 260.0, 48.0, 160.0), "phase": 2.75},
		{"rect": Rect2(2510.0, 245.0, 48.0, 160.0), "phase": 0.95},
		{"rect": Rect2(2780.0, 265.0, 48.0, 160.0), "phase": 2.05},
	]

func _gas_active(phase: float) -> bool:
	return fmod(elapsed + phase, 3.2) < 0.92

func _gas_warning(phase: float) -> bool:
	var cycle := fmod(elapsed + phase, 3.2)
	return cycle > 2.5

func _shaft_flame_strength(index: int) -> float:
	var cycle := fmod(elapsed + float(index) * 0.47, 3.1)
	if cycle < 1.05:
		return 0.0
	if cycle < 1.45:
		return smoothstep(1.05, 1.45, cycle)
	if cycle < 2.55:
		return 0.86 + sin(elapsed * 9.0 + float(index)) * 0.14
	return 1.0 - smoothstep(2.55, 3.1, cycle)

func _shaft_flame_is_dangerous(index: int) -> bool:
	return _shaft_flame_strength(index) > 0.48

func _cavern_spike_strength(index: int) -> float:
	var cycle := fmod(elapsed + float(index) * 0.71, 3.0)
	if cycle < 0.92:
		return 0.0
	if cycle < 1.28:
		return smoothstep(0.92, 1.28, cycle)
	if cycle < 2.18:
		return 1.0
	return 1.0 - smoothstep(2.18, 2.72, cycle)

func _cavern_spike_is_dangerous(index: int) -> bool:
	return _cavern_spike_strength(index) > 0.5

func _cavern_spike_hit_rect(index: int) -> Rect2:
	var source: Rect2 = CAVERN_SPIKES[index]
	var visible_height: float = source.size.y * _cavern_spike_strength(index)
	return Rect2(
		Vector2(source.position.x, source.end.y - visible_height),
		Vector2(source.size.x, visible_height)
	)

func _fail_and_respawn() -> void:
	player_position = checkpoint_position
	player_velocity = Vector2.ZERO
	on_ground = false
	regular_jump_active = false
	shaft_failure_kind = ""
	shaft_failure_time = 0.0
	cavern_failure_kind = ""
	cavern_failure_time = 0.0
	spout_reject_time = 0.0
	throw_preparing = false
	if room == Room.LEVEL_02_CLIFFS:
		level2_slide_active = false
	elif room == Room.CAVERN:
		camera_axis = clampf(checkpoint_position.x - 370.0, 0.0, 2060.0)
	if held_item_index >= 0:
		pickup_items[held_item_index]["state"] = "waiting"
		pickup_items[held_item_index]["position"] = pickup_items[held_item_index]["spawn"]
		held_item_index = -1
	failure_flash = 0.32

func _reset_current_room() -> void:
	match room:
		Room.SURFACE:
			player_position = Vector2(170.0, 526.0)
			checkpoint_position = player_position
		Room.SHAFT:
			player_position = Vector2(627.0, 116.0)
			checkpoint_position = player_position
			shaft_checkpoint_depth = 170.0
			camera_axis = 0.0
		Room.CAVERN, Room.LEVEL_01_LIFT:
			room = Room.CAVERN
			player_position = Vector2(150.0, 506.0)
			checkpoint_position = player_position
			camera_axis = 0.0
			water_blocked = false
			cavern_mid_checkpoint_active = false
			cavern_checkpoint_flash_time = 0.0
			_reset_pickup_items()
		Room.LEVEL_02_CLIFFS:
			player_position = Vector2(150.0, 400.0 - PLAYER_SIZE.y)
			checkpoint_position = player_position
			camera_axis = 0.0
			level2_slide_active = false
		Room.LEVEL_02_ROPEWAY:
			room = Room.LEVEL_02_ROPEWAY
			player_position = Vector2(115.0, ROPEWAY_PLATFORMS[0].position.y - PLAYER_SIZE.y)
			checkpoint_position = player_position
			camera_axis = 0.0
			entry_fall_lock = 0.0
			_reset_ropeway_attempt()
		Room.LEVEL_02_CAVE, Room.LEVEL_02_COMPLETE:
			room = Room.LEVEL_02_CAVE
			_reset_cave_attempt(true)
		Room.LEVEL_03_HOUSE, Room.LEVEL_03_YARD, Room.LEVEL_03_CELLAR_READY:
			_enter_level_03_house(true)
		Room.LEVEL_03_CELLAR_MAZE, Room.LEVEL_03_RESCUED:
			_enter_cellar_maze(true)
	player_velocity = Vector2.ZERO
	on_ground = false
	regular_jump_active = false
	shaft_failure_kind = ""
	shaft_failure_time = 0.0
	cavern_failure_kind = ""
	cavern_failure_time = 0.0
	spout_reject_time = 0.0
	ropeway_failure_time = 0.0
	failure_flash = 0.18

func _draw() -> void:
	draw_rect(Rect2(Vector2.ZERO, SCREEN), PAPER)
	if debug_selector_open:
		_draw_debug_selector()
		return
	match room:
		Room.SURFACE:
			_draw_surface()
		Room.SHAFT:
			_draw_shaft()
		Room.CAVERN, Room.LEVEL_01_LIFT:
			_draw_cavern()
		Room.LEVEL_02_CLIFFS:
			_draw_level_02_cliffs()
		Room.LEVEL_02_ROPEWAY:
			_draw_level_02_ropeway()
		Room.LEVEL_02_CAVE, Room.LEVEL_02_COMPLETE:
			_draw_level_02_cave()
		Room.LEVEL_03_HOUSE:
			_draw_level_03_house()
		Room.LEVEL_03_YARD:
			_draw_level_03_yard()
		Room.LEVEL_03_CELLAR_READY:
			_draw_level_03_cellar_ready()
		Room.LEVEL_03_CELLAR_MAZE:
			_draw_cellar_maze()
		Room.LEVEL_03_RESCUED:
			_draw_cellar_rescued()
	if room != Room.LEVEL_03_CELLAR_READY and room != Room.LEVEL_03_RESCUED:
		_draw_player()
	if room == Room.LEVEL_02_ROPEWAY and ropeway_knot_count > 0 and not ropeway_rope_installed:
		_draw_ropeway_held_coil()
	if room == Room.SHAFT and shaft_failure_kind != "":
		_draw_shaft_failure_effect()
	if room == Room.CAVERN and cavern_failure_kind != "":
		_draw_cavern_failure_effect()
	if room == Room.CAVERN and spout_reject_time > 0.0:
		_draw_spout_reject_effect()
	if room == Room.LEVEL_02_ROPEWAY and ropeway_failure_time > 0.0:
		_draw_ropeway_failure_effect()
	if room == Room.LEVEL_02_CAVE and cave_failure_time > 0.0:
		_draw_cave_failure_effect()
	if room == Room.LEVEL_03_CELLAR_MAZE:
		if cellar_failure_time > 0.0:
			_draw_cellar_failure_effect()
		_draw_cellar_darkness()
	_draw_ui()
	if room == Room.LEVEL_03_HOUSE and level3_seal_overlay_open:
		_draw_level_03_seal_overlay()
	if (room == Room.LEVEL_02_CAVE or room == Room.LEVEL_02_COMPLETE) and cave_entry_fade_time > 0.0:
		draw_rect(Rect2(Vector2.ZERO, SCREEN), Color(INK, clampf(cave_entry_fade_time / 0.85, 0.0, 1.0)))
	if level3_transition_time > 0.0 and (room == Room.LEVEL_03_HOUSE or room == Room.LEVEL_03_YARD or room == Room.LEVEL_03_CELLAR_READY):
		draw_rect(Rect2(Vector2.ZERO, SCREEN), Color(INK, clampf(level3_transition_time / 0.7, 0.0, 0.92)))
	if cellar_transition_time > 0.0 and (room == Room.LEVEL_03_CELLAR_MAZE or room == Room.LEVEL_03_RESCUED):
		draw_rect(Rect2(Vector2.ZERO, SCREEN), Color(CELLAR_BG, clampf(cellar_transition_time / 0.7, 0.0, 0.96)))
	if failure_flash > 0.0:
		draw_rect(Rect2(Vector2.ZERO, SCREEN), Color(INK, failure_flash * 0.7))

func _draw_surface() -> void:
	_draw_far_hills()
	draw_line(Vector2(0.0, 579.0), Vector2(700.0, 579.0), INK, 4.0, true)
	draw_line(Vector2(930.0, 579.0), Vector2(1280.0, 579.0), INK, 4.0, true)
	draw_rect(Rect2(-20.0, 583.0, 720.0, 150.0), INK)
	draw_rect(Rect2(930.0, 583.0, 370.0, 150.0), INK)
	var hole_points := PackedVector2Array([
		Vector2(690.0, 580.0), Vector2(716.0, 548.0), Vector2(758.0, 535.0),
		Vector2(815.0, 538.0), Vector2(864.0, 550.0), Vector2(934.0, 580.0),
		Vector2(915.0, 625.0), Vector2(705.0, 625.0),
	])
	draw_polygon(hole_points, PackedColorArray([INK]))
	draw_polyline(hole_points, PAPER, 3.0, true)
	_draw_fire(Vector2(275.0, 570.0))
	_draw_dead_tree(Vector2(1060.0, 580.0), 0.82)
	_draw_label(Vector2(760.0, 500.0), "洞口", 16, MID)

func _draw_level_02_cliffs() -> void:
	_draw_far_hills()
	draw_polygon(PackedVector2Array([
		Vector2(0.0, 400.0),
		LEVEL2_SLOPE_START,
		LEVEL2_SLOPE_END,
		Vector2(760.0, SCREEN.y),
		Vector2(0.0, SCREEN.y),
	]), PackedColorArray([INK]))
	draw_line(Vector2(0.0, 400.0), LEVEL2_SLOPE_START, PAPER, 4.0, true)
	draw_line(LEVEL2_SLOPE_START, LEVEL2_SLOPE_END, PAPER, 5.0, true)
	for mark_index in range(7):
		var mark_ratio: float = (float(mark_index) + 0.5) / 7.0
		var mark: Vector2 = LEVEL2_SLOPE_START.lerp(LEVEL2_SLOPE_END, mark_ratio)
		draw_line(mark + Vector2(-7.0, 8.0), mark + Vector2(13.0, 21.0), Color(PAPER, 0.35), 2.0, true)

	draw_polygon(PackedVector2Array([
		Vector2(770.0, 430.0), Vector2(1280.0, 430.0),
		Vector2(1280.0, 720.0), Vector2(960.0, 720.0),
		Vector2(975.0, 555.0),
	]), PackedColorArray([INK]))
	draw_line(Vector2(770.0, 430.0), Vector2(1280.0, 430.0), PAPER, 4.0, true)
	_draw_shared_hut_forecourt(Vector2(1158.0, 430.0), 0.50, 0, "ground")

	draw_line(Vector2(74.0, 150.0), Vector2(74.0, 400.0), Color(MID, 0.55), 3.0, true)
	draw_line(Vector2(232.0, 150.0), Vector2(232.0, 400.0), Color(MID, 0.55), 3.0, true)
	draw_rect(Rect2(88.0, 382.0, 130.0, 18.0), PAPER)
	draw_rect(Rect2(88.0, 382.0, 130.0, 18.0), INK, false, 3.0)

func _draw_shared_hut_forecourt(base: Vector2, scale_factor: float, tree_hits_value: int, axe_state: String) -> void:
	_draw_shared_tree(base + Vector2(-720.0, 0.0) * scale_factor, scale_factor, tree_hits_value)
	_draw_scaled_fire(base + Vector2(-300.0, -5.0) * scale_factor, scale_factor)
	_draw_shared_house(base, scale_factor)
	_draw_shared_backyard_clutter(base, scale_factor, axe_state)
	if axe_state == "stuck":
		_draw_shared_axe(base + Vector2(-695.0, -92.0) * scale_factor, -0.18, scale_factor)

func _draw_shared_backyard_clutter(base: Vector2, scale_factor: float, axe_state: String) -> void:
	var fence_start := base + Vector2(300.0, 0.0) * scale_factor
	var fence_end := base + Vector2(760.0, 0.0) * scale_factor
	draw_line(fence_start + Vector2(0.0, -54.0) * scale_factor, fence_end + Vector2(0.0, -54.0) * scale_factor, Color(INK, 0.7), maxf(2.0, 6.0 * scale_factor), true)
	for post_index in range(5):
		var post_x: float = fence_start.x + float(post_index) * 112.0 * scale_factor
		draw_line(Vector2(post_x, fence_start.y), Vector2(post_x, fence_start.y - 92.0 * scale_factor), INK, maxf(3.0, 8.0 * scale_factor), true)
	# A rake and a spade make the axe read as one tool among several, not a key on display.
	var rake_base := base + Vector2(390.0, -5.0) * scale_factor
	draw_line(rake_base, rake_base + Vector2(18.0, -126.0) * scale_factor, HEMP, maxf(2.0, 5.0 * scale_factor), true)
	for tine_index in range(4):
		var tine_origin := rake_base + Vector2(5.0 + float(tine_index) * 9.0, -125.0) * scale_factor
		draw_line(tine_origin, tine_origin + Vector2(0.0, -20.0) * scale_factor, INK, maxf(1.0, 3.0 * scale_factor), true)
	var spade_base := base + Vector2(475.0, -4.0) * scale_factor
	draw_line(spade_base, spade_base + Vector2(-14.0, -118.0) * scale_factor, HEMP, maxf(2.0, 5.0 * scale_factor), true)
	draw_circle(spade_base + Vector2(-15.0, -126.0) * scale_factor, 13.0 * scale_factor, PALE)
	if axe_state == "ground":
		_draw_shared_axe(base + Vector2(620.0, -18.0) * scale_factor, -1.02, scale_factor)
	# The foreground woodpile partially covers the axe head from the first view.
	for log_index in range(7):
		var row: int = int(log_index / 4)
		var column: int = log_index % 4
		var log_center := base + Vector2(545.0 + float(column) * 43.0 + float(row) * 18.0, -18.0 - float(row) * 34.0) * scale_factor
		draw_circle(log_center, 18.0 * scale_factor, HEMP)
		draw_circle(log_center, 18.0 * scale_factor, INK, false, maxf(1.0, 3.0 * scale_factor), true)
		draw_circle(log_center, 7.0 * scale_factor, Color(INK, 0.28), false, maxf(1.0, 2.0 * scale_factor), true)

func _draw_shared_house(base: Vector2, scale_factor: float) -> void:
	var wall := Rect2(base + Vector2(0.0, -132.0) * scale_factor, Vector2(210.0, 132.0) * scale_factor)
	draw_rect(wall, PAPER)
	draw_rect(wall, INK, false, maxf(2.0, 4.0 * scale_factor))
	for plank_index in range(5):
		var plank_x: float = base.x + (24.0 + float(plank_index) * 39.0) * scale_factor
		draw_line(Vector2(plank_x, wall.position.y + 8.0 * scale_factor), Vector2(plank_x - 4.0 * scale_factor, base.y), Color(INK, 0.22), maxf(1.0, 2.0 * scale_factor), true)
	var roof := PackedVector2Array([
		base + Vector2(-25.0, -124.0) * scale_factor,
		base + Vector2(96.0, -204.0) * scale_factor,
		base + Vector2(229.0, -124.0) * scale_factor,
	])
	draw_polygon(roof, PackedColorArray([INK]))
	draw_polyline(roof, Color(PAPER, 0.7), maxf(1.0, 2.0 * scale_factor), true)
	var chimney := Rect2(base + Vector2(153.0, -218.0) * scale_factor, Vector2(28.0, 72.0) * scale_factor)
	draw_rect(chimney, INK)
	var door := Rect2(base + Vector2(126.0, -82.0) * scale_factor, Vector2(48.0, 82.0) * scale_factor)
	draw_rect(door, INK)
	draw_circle(door.position + Vector2(11.0, 42.0) * scale_factor, maxf(1.5, 3.0 * scale_factor), GOLD)
	var window := Rect2(base + Vector2(34.0, -91.0) * scale_factor, Vector2(54.0, 46.0) * scale_factor)
	draw_rect(window, Color("b9dbe0"))
	draw_rect(window, INK, false, maxf(1.5, 3.0 * scale_factor))
	draw_line(Vector2(window.get_center().x, window.position.y), Vector2(window.get_center().x, window.end.y), INK, maxf(1.0, 2.0 * scale_factor))
	draw_line(Vector2(window.position.x, window.get_center().y), Vector2(window.end.x, window.get_center().y), INK, maxf(1.0, 2.0 * scale_factor))
	var crescent_center := window.get_center()
	draw_circle(crescent_center, 9.0 * scale_factor, Color("dbe8df"))
	draw_circle(crescent_center + Vector2(4.0, -2.0) * scale_factor, 8.0 * scale_factor, Color("b9dbe0"))
	for smoke_index in range(3):
		var smoke_ratio: float = fmod(elapsed * 0.18 + float(smoke_index) * 0.31, 1.0)
		var smoke_center := chimney.position + Vector2(14.0, -12.0 - smoke_ratio * 70.0) * scale_factor
		draw_circle(smoke_center, (7.0 + smoke_ratio * 8.0) * scale_factor, Color(MID, (1.0 - smoke_ratio) * 0.22))

func _draw_shared_tree(base: Vector2, scale_factor: float, tree_hits_value: int) -> void:
	var sway: float = sin(elapsed * 18.0) * float(tree_hits_value) * 1.2 * scale_factor if level3_swing_time > 0.0 else 0.0
	var trunk_top := base + Vector2(sway, -205.0 * scale_factor)
	draw_line(base, trunk_top, INK, maxf(6.0, 18.0 * scale_factor), true)
	draw_line(base + Vector2(-4.0, -94.0) * scale_factor, base + Vector2(-86.0 + sway, -151.0) * scale_factor, INK, maxf(4.0, 11.0 * scale_factor), true)
	draw_line(base + Vector2(2.0, -135.0) * scale_factor, base + Vector2(92.0 + sway, -190.0) * scale_factor, INK, maxf(4.0, 10.0 * scale_factor), true)
	draw_line(trunk_top, base + Vector2(30.0 + sway, -250.0) * scale_factor, INK, maxf(3.0, 8.0 * scale_factor), true)
	for crown_index in range(7):
		var angle: float = float(crown_index) * TAU / 7.0
		var crown_center := trunk_top + Vector2(cos(angle) * 48.0, sin(angle) * 31.0) * scale_factor
		draw_circle(crown_center, 32.0 * scale_factor, PAPER)
		draw_circle(crown_center, 32.0 * scale_factor, INK, false, maxf(1.5, 3.0 * scale_factor), true)
	for cut_index in range(tree_hits_value):
		var cut_y: float = base.y - (45.0 + float(cut_index) * 9.0) * scale_factor
		draw_line(Vector2(base.x - 11.0 * scale_factor, cut_y), Vector2(base.x + 12.0 * scale_factor, cut_y - 7.0 * scale_factor), FIRE, maxf(2.0, 4.0 * scale_factor), true)

func _draw_shared_axe(origin: Vector2, rotation: float, scale_factor: float) -> void:
	var handle_end := origin + Vector2(46.0, 0.0).rotated(rotation) * scale_factor
	draw_line(origin, handle_end, HEMP, maxf(2.0, 6.0 * scale_factor), true)
	var blade_center := handle_end + Vector2(2.0, -2.0).rotated(rotation) * scale_factor
	var blade := PackedVector2Array([
		blade_center + Vector2(-2.0, -13.0).rotated(rotation) * scale_factor,
		blade_center + Vector2(18.0, -9.0).rotated(rotation) * scale_factor,
		blade_center + Vector2(19.0, 10.0).rotated(rotation) * scale_factor,
		blade_center + Vector2(-2.0, 12.0).rotated(rotation) * scale_factor,
	])
	draw_polygon(blade, PackedColorArray([PALE]))
	draw_polyline(blade, INK, maxf(1.0, 2.0 * scale_factor), true)

func _draw_scaled_fire(origin: Vector2, scale_factor: float) -> void:
	draw_line(origin + Vector2(-25.0, 0.0) * scale_factor, origin + Vector2(25.0, 0.0) * scale_factor, INK, maxf(2.0, 5.0 * scale_factor), true)
	for flame_index in range(4):
		var flame_x: float = (-15.0 + float(flame_index) * 10.0) * scale_factor
		var flame_height: float = (25.0 + sin(elapsed * 9.0 + float(flame_index)) * 7.0) * scale_factor
		var flame := PackedVector2Array([
			origin + Vector2(flame_x - 7.0 * scale_factor, 0.0),
			origin + Vector2(flame_x, -flame_height),
			origin + Vector2(flame_x + 7.0 * scale_factor, 0.0),
		])
		draw_polygon(flame, PackedColorArray([FIRE]))
		draw_polyline(flame, INK, maxf(1.0, 2.0 * scale_factor), true)

func _draw_level_03_yard() -> void:
	for band_index in range(6):
		var band_rect := Rect2(0.0, float(band_index) * 120.0, SCREEN.x, 120.0)
		draw_rect(band_rect, Color(0.76 - float(band_index) * 0.035, 0.82 - float(band_index) * 0.035, 0.81 - float(band_index) * 0.03, 1.0))
	for ridge_index in range(3):
		var ridge := PackedVector2Array()
		for point_index in range(12):
			var world_x: float = float(point_index) * 190.0 - 120.0
			var world_y: float = 300.0 + float(ridge_index) * 78.0 + sin(float(point_index) * 1.15 + float(ridge_index)) * 42.0
			ridge.append(_world_to_screen(Vector2(world_x, world_y)))
		draw_polyline(ridge, Color(INK, 0.16 + float(ridge_index) * 0.08), 5.0, true)
	var ground_rect := _world_rect_to_screen(LEVEL3_YARD_PLATFORMS[0])
	draw_rect(ground_rect, INK)
	draw_line(ground_rect.position, Vector2(ground_rect.end.x, ground_rect.position.y), PAPER, 4.0, true)
	var axe_state := ""
	if not level3_axe_picked:
		axe_state = "ground"
	elif level3_tree_hits >= 3:
		axe_state = "stuck"
	_draw_shared_hut_forecourt(_world_to_screen(Vector2(1050.0, 590.0)), 1.0, level3_tree_hits, axe_state)
	if level3_branch_available:
		var branch_start := _world_to_screen(Vector2(306.0, 562.0))
		draw_line(branch_start, branch_start + Vector2(88.0, -19.0), HEMP, 7.0, true)
		draw_line(branch_start + Vector2(54.0, -12.0), branch_start + Vector2(72.0, -32.0), HEMP, 4.0, true)
	_draw_level_03_context_prompt()

func _draw_level_03_house() -> void:
	draw_rect(Rect2(Vector2.ZERO, SCREEN), Color("dedbd0"))
	_draw_level_03_home_backdrop()
	var house_platforms: Array[Rect2] = _level_03_house_platforms()
	for platform_rect in house_platforms:
		if platform_rect.position.y >= 580.0:
			var floor_screen := _world_rect_to_screen(platform_rect)
			draw_rect(floor_screen, INK)
			draw_line(floor_screen.position, Vector2(floor_screen.end.x, floor_screen.position.y), PAPER, 4.0, true)
	_draw_level_03_interior_door()
	_draw_level_03_furniture()
	_draw_level_03_fireplace()
	_draw_level_03_window()
	_draw_level_03_wind_chime()
	_draw_level_03_hatch()
	_draw_level_03_context_prompt()

func _draw_level_03_home_backdrop() -> void:
	# Alternating wall recesses and posts divide the long side-view into lived-in rooms.
	var recesses: Array[Rect2] = [
		Rect2(205.0, 250.0, 250.0, 300.0),
		Rect2(780.0, 250.0, 430.0, 300.0),
		Rect2(1290.0, 110.0, 610.0, 205.0),
		Rect2(1970.0, 260.0, 560.0, 290.0),
	]
	for recess in recesses:
		var recess_screen := _world_rect_to_screen(recess)
		draw_rect(recess_screen, Color(INK, 0.055))
		draw_rect(recess_screen, Color(INK, 0.18), false, 3.0)
	for wall_index in range(18):
		var world_x: float = float(wall_index) * 164.0 - 30.0
		draw_line(_world_to_screen(Vector2(world_x, 84.0)), _world_to_screen(Vector2(world_x - 20.0, 590.0)), Color(INK, 0.10), 3.0, true)
	var roof_peaks: Array[Vector2] = [Vector2(390.0, 60.0), Vector2(1050.0, 98.0), Vector2(1590.0, 42.0), Vector2(2320.0, 82.0)]
	for peak_index in range(roof_peaks.size()):
		var peak: Vector2 = roof_peaks[peak_index]
		var half_span: float = 390.0 if peak_index != 2 else 480.0
		draw_line(_world_to_screen(peak), _world_to_screen(peak + Vector2(-half_span, 150.0)), Color(INK, 0.34), 13.0, true)
		draw_line(_world_to_screen(peak), _world_to_screen(peak + Vector2(half_span, 150.0)), Color(INK, 0.34), 13.0, true)
	for post_x in [190.0, 470.0, 760.0, 1270.0, 1915.0, 2550.0]:
		draw_line(_world_to_screen(Vector2(post_x, 92.0)), _world_to_screen(Vector2(post_x, 590.0)), Color(INK, 0.30), 14.0, true)
	# Background-only household clutter creates false visual candidates without false interactions.
	var shelf := _world_rect_to_screen(Rect2(245.0, 326.0, 180.0, 13.0))
	draw_rect(shelf, HEMP)
	draw_rect(shelf, INK, false, 2.0)
	for jar_index in range(5):
		var jar_center := shelf.position + Vector2(18.0 + float(jar_index) * 35.0, -13.0 - float(jar_index % 2) * 5.0)
		draw_circle(jar_center, 10.0, PALE)
		draw_circle(jar_center, 10.0, INK, false, 2.0, true)
	for herb_index in range(6):
		var herb_root := _world_to_screen(Vector2(820.0 + float(herb_index) * 48.0, 124.0))
		draw_line(herb_root, herb_root + Vector2(0.0, 58.0 + float(herb_index % 2) * 14.0), Color(INK, 0.6), 2.0, true)
		for leaf_index in range(3):
			draw_circle(herb_root + Vector2(-5.0 + float(leaf_index % 2) * 10.0, 40.0 + float(leaf_index) * 11.0), 6.0, Color(INK, 0.24))
	var picture_centers: Array[Vector2] = [Vector2(340.0, 420.0), Vector2(2070.0, 335.0), Vector2(2215.0, 350.0)]
	for picture_index in range(picture_centers.size()):
		var center: Vector2 = _world_to_screen(picture_centers[picture_index])
		var picture_rect := Rect2(center - Vector2(38.0, 30.0), Vector2(76.0, 60.0))
		draw_rect(picture_rect, PAPER)
		draw_rect(picture_rect, INK, false, 3.0)
		draw_polyline(PackedVector2Array([picture_rect.position + Vector2(8.0, 45.0), picture_rect.position + Vector2(29.0, 22.0), picture_rect.position + Vector2(45.0, 39.0), picture_rect.position + Vector2(65.0, 15.0)]), Color(INK, 0.38), 2.0, true)

func _draw_level_03_interior_door() -> void:
	var door := _world_rect_to_screen(Rect2(60.0, 414.0, 118.0, 176.0))
	draw_rect(door, PAPER)
	draw_rect(door, INK, false, 5.0)
	for plank_index in range(3):
		var plank_x: float = door.position.x + 22.0 + float(plank_index) * 29.0
		draw_line(Vector2(plank_x, door.position.y + 5.0), Vector2(plank_x - 7.0, door.end.y - 5.0), Color(INK, 0.28), 2.0, true)
	draw_circle(door.position + Vector2(79.0, 86.0), 4.0, GOLD)

func _draw_level_03_fireplace() -> void:
	var hearth := _world_rect_to_screen(Rect2(505.0, 455.0, 210.0, 135.0))
	draw_rect(hearth, PALE)
	draw_rect(hearth, INK, false, 5.0)
	var opening := _world_rect_to_screen(Rect2(548.0, 497.0, 124.0, 93.0))
	draw_rect(opening, INK)
	if level3_fireplace_lit:
		_draw_scaled_fire(_world_to_screen(Vector2(610.0, 580.0)), 1.12)
		for glow_index in range(3):
			draw_circle(_world_to_screen(Vector2(610.0, 545.0)), 56.0 + float(glow_index) * 26.0, Color(FIRE, 0.07))
		for smoke_index in range(5):
			var smoke_ratio: float = fmod(elapsed * 0.28 + float(smoke_index) * 0.19, 1.0)
			var drift_x: float = smoke_ratio * (170.0 if level3_wind_unlocked else 28.0)
			var smoke_world := Vector2(610.0 + drift_x, 500.0 - smoke_ratio * 205.0)
			draw_circle(_world_to_screen(smoke_world), 6.0 + smoke_ratio * 8.0, Color(MID, (1.0 - smoke_ratio) * 0.25))
	else:
		draw_line(_world_to_screen(Vector2(570.0, 573.0)), _world_to_screen(Vector2(648.0, 548.0)), HEMP, 7.0, true)
		draw_line(_world_to_screen(Vector2(572.0, 548.0)), _world_to_screen(Vector2(650.0, 573.0)), HEMP, 7.0, true)
	draw_line(_world_to_screen(Vector2(498.0, 450.0)), _world_to_screen(Vector2(722.0, 450.0)), INK, 12.0, true)
	var log_basket := _world_rect_to_screen(Rect2(718.0, 542.0, 118.0, 48.0))
	draw_rect(log_basket, Color(INK, 0.12))
	draw_rect(log_basket, INK, false, 3.0)
	for log_index in range(4):
		draw_circle(log_basket.position + Vector2(19.0 + float(log_index) * 26.0, 18.0 + float(log_index % 2) * 12.0), 12.0, HEMP)
	if level3_charred_stick_available:
		var charred_start := _world_to_screen(Vector2(742.0, 572.0))
		draw_line(charred_start, charred_start + Vector2(72.0, -17.0), Color("35383a"), 8.0, true)
		draw_line(charred_start + Vector2(6.0, -2.0), charred_start + Vector2(65.0, -15.0), Color(PALE, 0.35), 2.0, true)

func _draw_level_03_furniture() -> void:
	# A low dining table and chairs make the hearth zone read as a home, not a runway.
	var dining_table := _world_rect_to_screen(Rect2(255.0, 500.0, 178.0, 18.0))
	draw_rect(dining_table, HEMP)
	draw_rect(dining_table, INK, false, 3.0)
	draw_line(dining_table.position + Vector2(22.0, 18.0), dining_table.position + Vector2(17.0, 88.0), INK, 7.0, true)
	draw_line(dining_table.position + Vector2(156.0, 18.0), dining_table.position + Vector2(161.0, 88.0), INK, 7.0, true)
	for cup_index in range(3):
		var cup := Rect2(dining_table.position + Vector2(30.0 + float(cup_index) * 51.0, -17.0), Vector2(18.0, 17.0))
		draw_rect(cup, PAPER)
		draw_rect(cup, INK, false, 2.0)
	var rug := _world_rect_to_screen(Rect2(205.0, 574.0, 520.0, 16.0))
	draw_rect(rug, Color("a9b8ae"))
	for stripe_index in range(9):
		var stripe_x: float = rug.position.x + 18.0 + float(stripe_index) * 55.0
		draw_line(Vector2(stripe_x, rug.position.y + 2.0), Vector2(stripe_x + 14.0, rug.end.y - 2.0), Color(INK, 0.28), 2.0, true)
	# Four real stair steps lead to a broad loft; their collision rects match these boards.
	for stair_index in range(4):
		var stair_rect: Rect2 = _world_rect_to_screen(LEVEL3_HOUSE_FURNITURE[stair_index])
		draw_rect(stair_rect, HEMP)
		draw_rect(stair_rect, INK, false, 3.0)
		draw_line(stair_rect.position + Vector2(10.0, stair_rect.size.y), stair_rect.position + Vector2(10.0, 60.0), Color(INK, 0.72), 5.0, true)
	draw_line(_world_to_screen(Vector2(820.0, 570.0)), _world_to_screen(Vector2(1260.0, 365.0)), INK, 8.0, true)
	var loft_rect: Rect2 = _world_rect_to_screen(LEVEL3_HOUSE_FURNITURE[4])
	draw_rect(loft_rect, HEMP)
	draw_rect(loft_rect, INK, false, 4.0)
	for support_x in [1320.0, 1870.0]:
		draw_line(_world_to_screen(Vector2(support_x, 350.0)), _world_to_screen(Vector2(support_x, 590.0)), Color(INK, 0.72), 10.0, true)
	# Loft bed, blanket, books and boxes are non-interactive silhouette clutter.
	var bed := _world_rect_to_screen(Rect2(1325.0, 278.0, 180.0, 52.0))
	draw_rect(bed, PAPER)
	draw_rect(bed, INK, false, 3.0)
	draw_polygon(PackedVector2Array([bed.position + Vector2(68.0, 0.0), bed.end - Vector2(0.0, 22.0), bed.end, bed.position + Vector2(55.0, bed.size.y)]), PackedColorArray([Color("93a8a0")]))
	for book_index in range(5):
		var book := _world_rect_to_screen(Rect2(1760.0 + float(book_index) * 20.0, 292.0 - float(book_index % 2) * 8.0, 15.0, 38.0 + float(book_index % 2) * 8.0))
		draw_rect(book, PAPER if book_index % 2 == 0 else PALE)
		draw_rect(book, INK, false, 2.0)
	var pantry := _world_rect_to_screen(Rect2(1985.0, 404.0, 205.0, 186.0))
	draw_rect(pantry, Color("b3a88d"))
	draw_rect(pantry, INK, false, 4.0)
	for shelf_index in range(2):
		draw_line(Vector2(pantry.position.x, pantry.position.y + 61.0 + float(shelf_index) * 60.0), Vector2(pantry.end.x, pantry.position.y + 61.0 + float(shelf_index) * 60.0), INK, 3.0)
	for sack_index in range(3):
		var sack_center := _world_to_screen(Vector2(2225.0 + float(sack_index) * 48.0, 565.0 - float(sack_index % 2) * 15.0))
		draw_circle(sack_center, 31.0, PALE)
		draw_circle(sack_center, 31.0, INK, false, 3.0, true)

func _draw_level_03_window() -> void:
	var frame := _world_rect_to_screen(Rect2(1500.0, 175.0, 225.0, 170.0))
	draw_rect(frame, Color("a9cfd2"))
	draw_rect(frame, INK, false, 7.0)
	draw_circle(frame.position + Vector2(112.0, 75.0), 39.0, Color("eef2d5"))
	draw_circle(frame.position + Vector2(129.0, 63.0), 36.0, Color("a9cfd2"))
	if level3_curtain_open:
		var beam := PackedVector2Array([
			frame.position + Vector2(45.0, 145.0),
			frame.end + Vector2(-25.0, -25.0),
			_world_to_screen(Vector2(1850.0, 590.0)),
			_world_to_screen(Vector2(1300.0, 590.0)),
		])
		draw_polygon(beam, PackedColorArray([Color(Color("e8efd2"), 0.18)]))
		draw_polygon(PackedVector2Array([frame.position, frame.position + Vector2(44.0, 0.0), frame.position + Vector2(25.0, 170.0), frame.position + Vector2(-18.0, 170.0)]), PackedColorArray([INK]))
		draw_polygon(PackedVector2Array([frame.end - Vector2(44.0, 170.0), frame.end - Vector2(0.0, 170.0), frame.end + Vector2(18.0, 0.0), frame.end - Vector2(25.0, 0.0)]), PackedColorArray([INK]))
	else:
		draw_polygon(PackedVector2Array([frame.position, frame.end - Vector2(0.0, 170.0), frame.end, frame.position + Vector2(0.0, 170.0)]), PackedColorArray([Color(INK, 0.92)]))
		for fold_index in range(4):
			var fold_x: float = frame.position.x + 30.0 + float(fold_index) * 52.0
			draw_line(Vector2(fold_x, frame.position.y + 8.0), Vector2(fold_x - 7.0, frame.end.y - 7.0), Color(PAPER, 0.18), 3.0, true)
	if level3_window_propped:
		draw_line(frame.position + Vector2(18.0, 150.0), frame.position + Vector2(72.0, 92.0), HEMP, 7.0, true)
		draw_line(frame.position + Vector2(12.0, 156.0), frame.position + Vector2(74.0, 94.0), INK, 2.0, true)
	if level3_wind_unlocked:
		for wind_index in range(4):
			var wind_y: float = frame.position.y + 68.0 + float(wind_index) * 27.0
			var wind_wave := PackedVector2Array()
			for point_index in range(7):
				wind_wave.append(Vector2(frame.end.x + float(point_index) * 34.0, wind_y + sin(elapsed * 5.0 + float(point_index)) * 8.0))
			draw_polyline(wind_wave, Color(Color("77b8bd"), 0.68), 3.0, true)
func _draw_level_03_wind_chime() -> void:
	var anchor := _world_to_screen(Vector2(1885.0, 225.0))
	var sway: float = sin(elapsed * 5.2) * 13.0 if level3_wind_unlocked else 0.0
	draw_line(anchor + Vector2(-42.0, 0.0), anchor + Vector2(42.0, 0.0), INK, 5.0, true)
	for chime_index in range(3):
		var local_sway: float = sway * (0.72 + float(chime_index) * 0.18)
		var string_start := anchor + Vector2(-25.0 + float(chime_index) * 25.0, 0.0)
		var bell_center := string_start + Vector2(local_sway, 58.0 + float(chime_index % 2) * 13.0)
		draw_line(string_start, bell_center, Color(INK, 0.72), 2.0, true)
		var bell := PackedVector2Array([
			bell_center + Vector2(-11.0, 8.0),
			bell_center + Vector2(0.0, -12.0),
			bell_center + Vector2(11.0, 8.0),
		])
		draw_polygon(bell, PackedColorArray([PAPER]))
		draw_polyline(bell, INK, 3.0, true)
	if level3_wind_unlocked:
		for note_index in range(2):
			var note_position := anchor + Vector2(70.0 + float(note_index) * 29.0, 34.0 - float(note_index) * 19.0)
			draw_circle(note_position, 5.0, Color("77b8bd"))
			draw_line(note_position + Vector2(5.0, 0.0), note_position + Vector2(5.0, -18.0), Color("77b8bd"), 3.0, true)

func _draw_level_03_hatch() -> void:
	var hatch_screen := _world_rect_to_screen(Rect2(LEVEL3_HATCH_GAP.position.x, 565.0, LEVEL3_HATCH_GAP.size.x, 25.0))
	if level3_hatch_open:
		draw_rect(_world_rect_to_screen(LEVEL3_HATCH_GAP), INK)
		draw_line(hatch_screen.position + Vector2(0.0, -8.0), hatch_screen.position + Vector2(-66.0, -92.0), HEMP, 10.0, true)
		return
	draw_rect(hatch_screen, HEMP)
	draw_rect(hatch_screen, INK, false, 4.0)
	for plank_index in range(4):
		var plank_x: float = hatch_screen.position.x + 24.0 + float(plank_index) * 34.0
		draw_line(Vector2(plank_x, hatch_screen.position.y + 2.0), Vector2(plank_x, hatch_screen.end.y - 2.0), Color(INK, 0.5), 2.0)
	var seal_center := hatch_screen.get_center() + Vector2(0.0, -48.0)
	var seal_color: Color = GOLD if level3_hatch_unsealed else PALE
	draw_circle(seal_center, 30.0, Color(PAPER, 0.82))
	draw_circle(seal_center, 30.0, seal_color, false, 4.0, true)
	var node_colors: Array[Color] = [
		FIRE if level3_fire_unlocked else PALE,
		Color("e8efd2") if level3_moon_unlocked else PALE,
		Color("77b8bd") if level3_wind_unlocked else PALE,
	]
	for node_index in range(3):
		var angle: float = -PI * 0.5 + float(node_index) * TAU / 3.0
		draw_circle(seal_center + Vector2(cos(angle), sin(angle)) * 17.0, 4.0, node_colors[node_index])
	if level3_seal_flash_time > 0.0:
		var flash_ratio: float = clampf(level3_seal_flash_time, 0.0, 1.0)
		draw_arc(seal_center, 36.0 + (1.0 - flash_ratio) * 28.0, 0.0, TAU, 32, Color(GOLD, flash_ratio), 4.0, true)
	var help_phase: float = fmod(level3_help_clock, 3.4)
	if help_phase < 1.7 and not level3_hatch_unsealed:
		var help_alpha: float = sin(help_phase / 1.7 * PI)
		draw_string(ui_font, seal_center + Vector2(-28.0, -52.0), "Help…", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 16, Color(INK, help_alpha * 0.7))
		for ring_index in range(2):
			draw_arc(seal_center, 39.0 + float(ring_index) * 10.0 + help_phase * 7.0, PI * 1.1, PI * 1.9, 18, Color(INK, help_alpha * 0.35), 2.0, true)

func _draw_level_03_seal_overlay() -> void:
	draw_rect(Rect2(Vector2.ZERO, SCREEN), Color(INK, 0.78))
	var panel := Rect2(250.0, 90.0, 780.0, 540.0)
	draw_rect(panel, Color("202528"))
	draw_rect(panel, PAPER, false, 4.0)
	var title := "三相闭合 · 地窖封印" if not level3_hatch_unsealed else "三相闭合 · 封印解除"
	var title_width: float = ui_font.get_string_size(title, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 28).x
	draw_string(ui_font, Vector2((SCREEN.x - title_width) * 0.5, 142.0), title, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 28, PAPER)
	var flame_center := Vector2(640.0, 252.0)
	var moon_center := Vector2(485.0, 452.0)
	var wind_center := Vector2(795.0, 452.0)
	var connection_color := GOLD if level3_hatch_unsealed else Color(PAPER, 0.28)
	draw_line(flame_center, moon_center, connection_color, 4.0, true)
	draw_line(moon_center, wind_center, connection_color, 4.0, true)
	draw_line(wind_center, flame_center, connection_color, 4.0, true)
	_draw_level_03_seal_node(flame_center, "fire", level3_fire_unlocked)
	_draw_level_03_seal_node(moon_center, "moon", level3_moon_unlocked)
	_draw_level_03_seal_node(wind_center, "wind", level3_wind_unlocked)
	_draw_level_03_f_prompt(Vector2(640.0, 585.0))
	if level3_seal_flash_time > 0.0:
		draw_rect(panel, Color(GOLD, minf(0.16, level3_seal_flash_time * 0.12)))

func _draw_level_03_seal_node(center: Vector2, kind: String, unlocked: bool) -> void:
	var fill_color := PAPER
	if unlocked and kind == "fire":
		fill_color = FIRE
	elif unlocked and kind == "moon":
		fill_color = Color("e8efd2")
	elif unlocked and kind == "wind":
		fill_color = Color("77b8bd")
	draw_circle(center, 54.0, Color(PAPER, 0.08))
	draw_circle(center, 54.0, PAPER, false, 4.0, true)
	if kind == "fire":
		var flame := PackedVector2Array([center + Vector2(-25.0, 31.0), center + Vector2(-16.0, -5.0), center + Vector2(0.0, -38.0), center + Vector2(14.0, -7.0), center + Vector2(29.0, 31.0)])
		draw_polygon(flame, PackedColorArray([fill_color if unlocked else Color("202528")]))
		draw_polyline(flame, PAPER, 3.0, true)
	elif kind == "moon":
		draw_circle(center, 31.0, fill_color if unlocked else Color("202528"))
		draw_circle(center + Vector2(14.0, -8.0), 29.0, Color("202528"))
		draw_arc(center, 31.0, 0.0, TAU, 30, PAPER, 3.0, true)
	else:
		for line_index in range(3):
			var y_offset: float = -18.0 + float(line_index) * 18.0
			var wave := PackedVector2Array()
			for point_index in range(6):
				wave.append(center + Vector2(-34.0 + float(point_index) * 14.0, y_offset + sin(float(point_index) * 1.4) * 7.0))
			draw_polyline(wave, fill_color if unlocked else PAPER, 5.0 if unlocked else 3.0, true)

func _draw_level_03_cellar_ready() -> void:
	draw_rect(Rect2(Vector2.ZERO, SCREEN), CELLAR_BG)
	var fall_ratio: float = clampf(completion_time / 1.35, 0.0, 1.0)
	for wall_index in range(8):
		var wall_y: float = -80.0 + float(wall_index) * 118.0 + fmod(fall_ratio * 420.0, 118.0)
		draw_line(Vector2(180.0, wall_y), Vector2(430.0, wall_y + 45.0), Color(CELLAR_LINE, 0.15), 4.0, true)
		draw_line(Vector2(1100.0, wall_y), Vector2(850.0, wall_y + 45.0), Color(CELLAR_LINE, 0.15), 4.0, true)
	draw_polygon(PackedVector2Array([Vector2(0.0, 0.0), Vector2(420.0, 0.0), Vector2(505.0, 720.0), Vector2(0.0, 720.0)]), PackedColorArray([Color("111517")]))
	draw_polygon(PackedVector2Array([Vector2(1280.0, 0.0), Vector2(860.0, 0.0), Vector2(775.0, 720.0), Vector2(1280.0, 720.0)]), PackedColorArray([Color("111517")]))
	var falling_center := Vector2(640.0, lerpf(130.0, 555.0, smoothstep(0.0, 1.0, fall_ratio)))
	for trail_index in range(5):
		var trail_x: float = falling_center.x - 46.0 + float(trail_index) * 23.0
		draw_line(Vector2(trail_x, falling_center.y - 98.0), Vector2(trail_x - 5.0, falling_center.y - 28.0), Color(PAPER, 0.16), 3.0, true)
	_draw_falling_player_silhouette(falling_center)
	draw_rect(Rect2(0.0, 0.0, SCREEN.x, 48.0), CELLAR_BG)
	draw_rect(Rect2(0.0, SCREEN.y - 48.0, SCREEN.x, 48.0), CELLAR_BG)

func _draw_falling_player_silhouette(center: Vector2) -> void:
	draw_circle(center + Vector2(0.0, -22.0), 11.0, PAPER)
	draw_circle(center + Vector2(0.0, -22.0), 11.0, CELLAR_BG, false, 3.0, true)
	var cloak := PackedVector2Array([center + Vector2(0.0, -10.0), center + Vector2(-18.0, 24.0), center + Vector2(18.0, 24.0)])
	draw_polygon(cloak, PackedColorArray([PAPER]))
	draw_polyline(cloak, CELLAR_BG, 3.0, true)
	draw_line(center + Vector2(-22.0, -30.0), center + Vector2(18.0, -30.0), PAPER, 5.0, true)
	draw_polygon(PackedVector2Array([center + Vector2(-12.0, -30.0), center + Vector2(3.0, -61.0), center + Vector2(12.0, -30.0)]), PackedColorArray([PAPER]))

func _draw_level_03_context_prompt() -> void:
	if level3_seal_overlay_open:
		return
	var player_rect := Rect2(player_position, PLAYER_SIZE)
	if room == Room.LEVEL_03_HOUSE:
		if player_rect.intersects(LEVEL3_HOUSE_DOOR_ZONE):
			_draw_level_03_f_prompt(_world_to_screen(Vector2(112.0, 432.0)))
		elif level3_charred_stick_available and level3_held_item == "" and player_rect.intersects(LEVEL3_CHARRED_STICK_ZONE):
			_draw_level_03_f_prompt(_world_to_screen(Vector2(775.0, 500.0)))
		elif player_rect.intersects(LEVEL3_FIREPLACE_ZONE):
			_draw_level_03_f_prompt(_world_to_screen(Vector2(610.0, 430.0)))
		elif player_rect.intersects(LEVEL3_WINDOW_ZONE):
			_draw_level_03_f_prompt(_world_to_screen(Vector2(1610.0, 166.0)))
		elif player_rect.intersects(LEVEL3_HATCH_ZONE):
			_draw_level_03_f_prompt(_world_to_screen(Vector2(2418.0, 482.0)))
	elif room == Room.LEVEL_03_YARD:
		if player_rect.intersects(LEVEL3_YARD_DOOR_ZONE):
			_draw_level_03_f_prompt(_world_to_screen(Vector2(1200.0, 418.0)))
		elif not level3_axe_picked and player_rect.intersects(LEVEL3_AXE_ZONE):
			_draw_level_03_f_prompt(_world_to_screen(Vector2(1700.0, 480.0)))
		elif level3_held_item == "axe" and player_rect.intersects(LEVEL3_TREE_ZONE):
			_draw_level_03_f_prompt(_world_to_screen(Vector2(360.0, 338.0)))
		elif level3_branch_available and level3_held_item == "" and player_rect.intersects(LEVEL3_BRANCH_ZONE):
			_draw_level_03_f_prompt(_world_to_screen(Vector2(380.0, 500.0)))
		elif level3_held_item == "branch" and player_rect.intersects(LEVEL3_CAMPFIRE_ZONE):
			_draw_level_03_f_prompt(_world_to_screen(Vector2(750.0, 478.0)))

func _draw_level_03_f_prompt(center: Vector2) -> void:
	draw_circle(center, 17.0, PAPER)
	draw_circle(center, 17.0, INK, false, 2.0, true)
	var key_size: Vector2 = ui_font.get_string_size("F", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 15)
	draw_string(ui_font, center - key_size * 0.5 + Vector2(0.0, key_size.y * 0.72), "F", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 15, INK)

func _draw_cellar_maze() -> void:
	draw_rect(Rect2(Vector2.ZERO, SCREEN), CELLAR_BG)
	_draw_cellar_background()
	for platform_rect in _cellar_platforms(cellar_region):
		_draw_cellar_platform(platform_rect)
	_draw_cellar_portals()
	_draw_cellar_region_landmark()
	_draw_cellar_traps()
	_draw_cellar_falling_rocks()
	_draw_cellar_dust()
	_draw_cellar_context_prompt()

func _draw_cellar_background() -> void:
	var chamber: Rect2 = _cellar_region_rect(cellar_region)
	var chamber_screen := _world_rect_to_screen(chamber)
	draw_rect(chamber_screen, Color("101416"))
	for depth_index in range(4):
		var inset: float = 26.0 + float(depth_index) * 34.0
		var recess := Rect2(chamber_screen.position + Vector2(inset, 36.0 + inset * 0.35), chamber_screen.size - Vector2(inset * 2.0, 96.0 + inset * 0.5))
		draw_rect(recess, Color(CELLAR_WALL, 0.18 + float(depth_index) * 0.09), false, 5.0)
	for brick_row in range(7):
		var world_y: float = chamber.position.y + 96.0 + float(brick_row) * 70.0
		var offset_x: float = 40.0 if brick_row % 2 == 0 else 5.0
		for brick_column in range(8):
			var world_x: float = chamber.position.x + offset_x + float(brick_column) * 145.0
			var brick := _world_rect_to_screen(Rect2(world_x, world_y, 118.0, 44.0))
			draw_rect(brick, Color(CELLAR_LINE, 0.055), false, 2.0)
	for root_index in range(7):
		var root_start := _world_to_screen(chamber.position + Vector2(70.0 + float(root_index) * 165.0, 0.0))
		var root_end := root_start + Vector2(sin(float(root_index) * 1.9) * 45.0, 105.0 + float(root_index % 3) * 34.0)
		draw_line(root_start, root_end, Color("07090a"), 13.0 - float(root_index % 3) * 2.0, true)
	# Foreground edges frame the room and provide a consistent 2D depth layer.
	draw_polygon(PackedVector2Array([chamber_screen.position, chamber_screen.position + Vector2(86.0, 0.0), chamber_screen.position + Vector2(120.0, chamber_screen.size.y), chamber_screen.position + Vector2(0.0, chamber_screen.size.y)]), PackedColorArray([Color("050708")]))
	draw_polygon(PackedVector2Array([chamber_screen.position + Vector2(chamber_screen.size.x - 86.0, 0.0), chamber_screen.end - Vector2(0.0, chamber_screen.size.y), chamber_screen.end, chamber_screen.end - Vector2(120.0, 0.0)]), PackedColorArray([Color("050708")]))

func _draw_cellar_region_landmark() -> void:
	var origin: Vector2 = _cellar_region_origin(cellar_region)
	match cellar_region:
		"H":
			_draw_cellar_hub(origin)
		"O":
			_draw_cellar_rubble_room(origin)
		"L":
			_draw_cellar_wine_room(origin)
		"M":
			_draw_cellar_store_room(origin)
		"D":
			_draw_cellar_drop_room(origin)
		"C":
			_draw_cellar_echo_room(origin)
		"G":
			_draw_cellar_gas_room(origin)
		"F":
			_draw_cellar_false_gallery(origin)
		"Q":
			_draw_cellar_quarry(origin)
		"W":
			_draw_cellar_required_wall(origin)
		"K":
			_draw_cellar_key_room(origin)
		"R":
			_draw_cellar_chain_room(origin)
		"T":
			_draw_cellar_rock_room(origin)
		"P":
			_draw_cellar_prison(origin)

func _draw_cellar_hub(origin: Vector2) -> void:
	var cistern_center := _world_to_screen(origin + Vector2(560.0, 330.0))
	for ring_index in range(4):
		draw_arc(cistern_center, 125.0 + float(ring_index) * 28.0, PI, TAU, 42, Color(CELLAR_LINE, 0.12 + float(ring_index) * 0.035), 5.0, true)
	var grate := _world_rect_to_screen(Rect2(origin + Vector2(430.0, 118.0), Vector2(260.0, 104.0)))
	draw_rect(grate, Color("07090a"))
	draw_rect(grate, Color(CELLAR_LINE, 0.38), false, 5.0)
	for bar_index in range(7):
		var bar_x: float = grate.position.x + 24.0 + float(bar_index) * 35.0
		draw_line(Vector2(bar_x, grate.position.y), Vector2(bar_x, grate.end.y), Color(CELLAR_LINE, 0.34), 4.0, true)
	var help_phase: float = fmod(level3_help_clock, 3.8)
	if help_phase < 1.8 and not cellar_has_key:
		var wave_center := _world_to_screen(origin + Vector2(1040.0, 430.0))
		var wave_alpha: float = sin(help_phase / 1.8 * PI) * 0.28
		for wave_index in range(3):
			draw_arc(wave_center, 24.0 + float(wave_index) * 19.0 + help_phase * 8.0, PI * 0.65, PI * 1.35, 16, Color(PAPER, wave_alpha), 2.0, true)

func _draw_cellar_rubble_room(origin: Vector2) -> void:
	for stone_index in range(12):
		var column: int = stone_index % 6
		var row: int = int(stone_index / 6)
		var center := _world_to_screen(origin + Vector2(120.0 + float(column) * 52.0 + float(row) * 18.0, 535.0 - float(row) * 35.0))
		_draw_cellar_stone(center, 17.0 + float(stone_index % 3) * 3.0)
	if not cellar_has_rubble and cellar_optional_wall_hits < CELLAR_OPTIONAL_WALL_HITS_REQUIRED:
		var rubble_center: Vector2 = _world_to_screen(cellar_rubble_position)
		_draw_cellar_stone(rubble_center, 25.0)
		if cellar_rubble_thrown:
			for trail_index in range(3):
				var trail_offset: float = 18.0 + float(trail_index) * 13.0
				draw_line(rubble_center - cellar_rubble_velocity.normalized() * trail_offset, rubble_center - cellar_rubble_velocity.normalized() * (trail_offset + 8.0), Color(CELLAR_LINE, 0.28), 3.0, true)
	_draw_cellar_o_boulder(origin)

func _draw_cellar_o_boulder(origin: Vector2) -> void:
	if not cellar_o_boulder_triggered or cellar_optional_wall_hits >= CELLAR_OPTIONAL_WALL_HITS_REQUIRED:
		return
	var fall_ratio: float = 1.0
	if not cellar_o_boulder_landed:
		fall_ratio = 1.0 - clampf(cellar_o_boulder_fall_time / 0.82, 0.0, 1.0)
	var center_y: float = lerpf(105.0, CELLAR_FLOOR_Y - 76.0, smoothstep(0.0, 1.0, fall_ratio))
	var center: Vector2 = _world_to_screen(origin + Vector2(995.0, center_y))
	draw_circle(center + Vector2(0.0, 68.0), 72.0, Color(CELLAR_BG, 0.48))
	_draw_cellar_stone(center, 78.0)
	for crack_index in range(3):
		var crack_start: Vector2 = center + Vector2(-17.0 + float(crack_index) * 19.0, -35.0 + float(crack_index) * 13.0)
		draw_line(crack_start, crack_start + Vector2(-12.0 + float(crack_index) * 9.0, 30.0), Color(CELLAR_BG, 0.34), 3.0, true)

func _draw_cellar_wine_room(origin: Vector2) -> void:
	for rack_index in range(3):
		var rack := _world_rect_to_screen(Rect2(origin + Vector2(190.0 + float(rack_index) * 285.0, 235.0), Vector2(205.0, 300.0)))
		draw_rect(rack, Color("0b0e0f"))
		draw_rect(rack, Color(CELLAR_LINE, 0.42), false, 5.0)
		for shelf_index in range(3):
			var shelf_y: float = rack.position.y + 70.0 + float(shelf_index) * 78.0
			draw_line(Vector2(rack.position.x, shelf_y), Vector2(rack.end.x, shelf_y), Color(CELLAR_LINE, 0.35), 4.0, true)
			for bottle_index in range(4):
				var bottle_center := Vector2(rack.position.x + 29.0 + float(bottle_index) * 48.0, shelf_y - 17.0)
				draw_rect(Rect2(bottle_center - Vector2(7.0, 17.0), Vector2(14.0, 28.0)), Color(CELLAR_LINE, 0.18))
				draw_line(bottle_center - Vector2(3.0, 22.0), bottle_center + Vector2(3.0, -22.0), Color(CELLAR_LINE, 0.28), 3.0, true)

func _draw_cellar_store_room(origin: Vector2) -> void:
	for crate_index in range(8):
		var crate_world := Rect2(origin + Vector2(145.0 + float(crate_index % 4) * 205.0, 470.0 - float(crate_index / 4) * 112.0), Vector2(145.0, 88.0))
		var crate := _world_rect_to_screen(crate_world)
		draw_rect(crate, Color("15191a"))
		draw_rect(crate, Color(CELLAR_LINE, 0.34), false, 4.0)
		draw_line(crate.position + Vector2(9.0, 8.0), crate.end - Vector2(9.0, 8.0), Color(CELLAR_LINE, 0.23), 3.0, true)
		draw_line(Vector2(crate.end.x - 9.0, crate.position.y + 8.0), Vector2(crate.position.x + 9.0, crate.end.y - 8.0), Color(CELLAR_LINE, 0.23), 3.0, true)

func _draw_cellar_drop_room(origin: Vector2) -> void:
	for beam_index in range(5):
		var beam_start := _world_to_screen(origin + Vector2(90.0 + float(beam_index) * 235.0, 120.0 + float(beam_index % 2) * 72.0))
		draw_line(beam_start, beam_start + Vector2(150.0, 70.0), Color(CELLAR_LINE, 0.27), 9.0, true)
	for pit_index in range(2):
		var pit_center := _world_to_screen(origin + Vector2(342.0 + float(pit_index) * 330.0, 586.0))
		for echo_index in range(3):
			draw_arc(pit_center, 22.0 + float(echo_index) * 22.0, 0.0, PI, 18, Color(CELLAR_LINE, 0.12), 2.0, true)

func _draw_cellar_echo_room(origin: Vector2) -> void:
	var wheel_center := _world_to_screen(origin + Vector2(560.0, 462.0))
	for ring_index in range(3):
		draw_circle(wheel_center, 43.0 + float(ring_index) * 12.0, Color(CELLAR_LINE, 0.08), false, 3.0, true)
	draw_circle(wheel_center, 41.0, Color("111617"))
	draw_circle(wheel_center, 41.0, CELLAR_LINE, false, 5.0, true)
	for spoke_index in range(8):
		var angle: float = float(spoke_index) * TAU / 8.0 + (-0.7 if cellar_drain_open else 0.0)
		draw_line(wheel_center, wheel_center + Vector2(cos(angle), sin(angle)) * 36.0, Color(CELLAR_LINE, 0.65), 4.0, true)
	if cellar_drain_time > 0.0:
		for echo_index in range(5):
			var radius: float = 58.0 + float(echo_index) * 31.0 + (2.0 - cellar_drain_time) * 25.0
			draw_arc(wheel_center, radius, 0.0, TAU, 28, Color(WATER, cellar_drain_time * 0.12), 3.0, true)
	for drip_index in range(6):
		var drip_x: float = origin.x + 150.0 + float(drip_index) * 165.0
		var drip_y: float = origin.y + 180.0 + fmod(elapsed * 95.0 + float(drip_index) * 73.0, 285.0)
		draw_line(_world_to_screen(Vector2(drip_x, drip_y)), _world_to_screen(Vector2(drip_x, drip_y + 18.0)), Color(WATER_PALE, 0.42), 2.0, true)

func _draw_cellar_gas_room(origin: Vector2) -> void:
	for pipe_index in range(4):
		var pipe_x: float = origin.x + 170.0 + float(pipe_index) * 260.0
		draw_line(_world_to_screen(Vector2(pipe_x, origin.y + 80.0)), _world_to_screen(Vector2(pipe_x, origin.y + 390.0)), Color(CELLAR_LINE, 0.22), 8.0, true)
		draw_arc(_world_to_screen(Vector2(pipe_x + 42.0, origin.y + 390.0)), 42.0, PI, TAU, 18, Color(CELLAR_LINE, 0.22), 8.0, true)
	var channel := _world_rect_to_screen(Rect2(origin + Vector2(55.0, 535.0), Vector2(1010.0, 65.0)))
	draw_rect(channel, Color(WATER, 0.20 if not cellar_drain_open else 0.055))
	if cellar_drain_open:
		draw_line(channel.position + Vector2(0.0, 43.0), channel.end - Vector2(0.0, 22.0), Color(WATER, 0.28), 2.0, true)

func _draw_cellar_false_gallery(origin: Vector2) -> void:
	for arch_index in range(5):
		var arch_center := _world_to_screen(origin + Vector2(150.0 + float(arch_index) * 205.0, 365.0))
		draw_arc(arch_center, 82.0, PI, TAU, 24, Color(CELLAR_LINE, 0.28 if arch_index != 2 else 0.12), 7.0, true)
		draw_line(arch_center + Vector2(-82.0, 0.0), arch_center + Vector2(-82.0, 170.0), Color(CELLAR_LINE, 0.28), 7.0, true)
		draw_line(arch_center + Vector2(82.0, 0.0), arch_center + Vector2(82.0, 170.0), Color(CELLAR_LINE, 0.28), 7.0, true)

func _draw_cellar_quarry(origin: Vector2) -> void:
	var pool := _world_rect_to_screen(Rect2(origin + Vector2(280.0, 540.0), Vector2(480.0, 90.0)))
	if not cellar_drain_open:
		draw_rect(pool, Color(WATER, 0.45))
		for ripple_index in range(7):
			var ripple_x: float = pool.position.x + 30.0 + float(ripple_index) * 68.0
			draw_line(Vector2(ripple_x, pool.position.y + 8.0), Vector2(ripple_x + 34.0, pool.position.y + 8.0), Color(WATER_PALE, 0.62), 3.0, true)
	else:
		draw_rect(pool, Color(WATER, 0.06))
	for stone_index in range(14):
		var column: int = stone_index % 5
		var row: int = int(stone_index / 5)
		var stone_center := _world_to_screen(origin + Vector2(95.0 + float(column) * 40.0 + float(row) * 12.0, 540.0 - float(row) * 31.0))
		_draw_cellar_stone(stone_center, 14.0 + float(stone_index % 3) * 3.0)
	if cellar_drain_open and not cellar_has_stone:
		_draw_cellar_stone(_world_to_screen(origin + Vector2(190.0, 505.0)), 25.0)

func _draw_cellar_required_wall(origin: Vector2) -> void:
	_draw_cellar_cracked_wall(origin + Vector2(555.0, 420.0), cellar_required_wall_hits, CELLAR_WALL_HITS_REQUIRED, false)
	if cellar_required_wall_hits >= CELLAR_WALL_HITS_REQUIRED:
		var opening := _world_rect_to_screen(Rect2(origin + Vector2(505.0, 280.0), Vector2(125.0, 280.0)))
		draw_rect(opening, Color("030506"))
		for step_index in range(4):
			var step := _world_rect_to_screen(Rect2(origin + Vector2(505.0 - float(step_index) * 62.0, 525.0 - float(step_index) * 58.0), Vector2(95.0, 18.0)))
			draw_rect(step, CELLAR_STONE_COLOR)
			draw_rect(step, CELLAR_BG, false, 3.0)

func _draw_cellar_key_room(origin: Vector2) -> void:
	for bar_index in range(9):
		var bar_x: float = origin.x + 315.0 + float(bar_index) * 62.0
		draw_line(_world_to_screen(Vector2(bar_x, origin.y + 145.0)), _world_to_screen(Vector2(bar_x, origin.y + 530.0)), Color(CELLAR_LINE, 0.28), 6.0, true)
	var pedestal := _world_rect_to_screen(Rect2(origin + Vector2(505.0, 495.0), Vector2(140.0, 65.0)))
	draw_rect(pedestal, CELLAR_STONE_COLOR)
	draw_rect(pedestal, CELLAR_BG, false, 4.0)
	if not cellar_has_key:
		var key_center := _world_to_screen(origin + Vector2(575.0, 442.0))
		for glow_index in range(4):
			draw_circle(key_center, 38.0 + float(glow_index) * 25.0, Color(CELLAR_KEY_COLOR, 0.065))
		_draw_cellar_key(key_center, 1.0, 1.0)
	else:
		var ladder_x: float = origin.x + 1010.0
		draw_line(_world_to_screen(Vector2(ladder_x, origin.y + 170.0)), _world_to_screen(Vector2(ladder_x, origin.y + 560.0)), CELLAR_LINE, 6.0, true)
		draw_line(_world_to_screen(Vector2(ladder_x + 55.0, origin.y + 170.0)), _world_to_screen(Vector2(ladder_x + 55.0, origin.y + 560.0)), CELLAR_LINE, 6.0, true)
		for rung_index in range(8):
			var rung_y: float = origin.y + 205.0 + float(rung_index) * 43.0
			draw_line(_world_to_screen(Vector2(ladder_x, rung_y)), _world_to_screen(Vector2(ladder_x + 55.0, rung_y)), Color(CELLAR_LINE, 0.7), 4.0, true)

func _draw_cellar_chain_room(origin: Vector2) -> void:
	for blade_index in range(3):
		var pivot := origin + Vector2(300.0 + float(blade_index) * 255.0, 105.0)
		var swing_angle: float = sin(elapsed * 1.65 + float(blade_index) * 1.7) * 0.72
		var center: Vector2 = pivot + Vector2(sin(swing_angle) * 190.0, cos(swing_angle) * 190.0)
		draw_line(_world_to_screen(pivot), _world_to_screen(center), Color(CELLAR_LINE, 0.46), 4.0, true)
		draw_circle(_world_to_screen(center), 25.0, CELLAR_STONE_COLOR)
		draw_circle(_world_to_screen(center), 25.0, CELLAR_BG, false, 4.0, true)
		for tooth_index in range(8):
			var angle: float = float(tooth_index) * TAU / 8.0
			var tooth_start := _world_to_screen(center) + Vector2(cos(angle), sin(angle)) * 23.0
			var tooth_end := _world_to_screen(center) + Vector2(cos(angle), sin(angle)) * 35.0
			draw_line(tooth_start, tooth_end, CELLAR_STONE_COLOR, 5.0, true)

func _draw_cellar_rock_room(origin: Vector2) -> void:
	for crack_index in range(6):
		var crack_start := _world_to_screen(origin + Vector2(135.0 + float(crack_index) * 175.0, 15.0))
		var crack_points := PackedVector2Array([crack_start, crack_start + Vector2(-20.0, 62.0), crack_start + Vector2(14.0, 112.0), crack_start + Vector2(-8.0, 170.0)])
		draw_polyline(crack_points, Color(CELLAR_LINE, 0.26), 4.0, true)

func _draw_cellar_prison(origin: Vector2) -> void:
	var cell := _world_rect_to_screen(Rect2(origin + Vector2(760.0, 205.0), Vector2(310.0, 355.0)))
	draw_rect(cell, Color("050708"))
	for bar_index in range(7):
		var bar_x: float = cell.position.x + 22.0 + float(bar_index) * 44.0
		draw_line(Vector2(bar_x, cell.position.y), Vector2(bar_x, cell.end.y), Color(CELLAR_LINE, 0.72), 7.0, true)
	draw_line(cell.position, Vector2(cell.end.x, cell.position.y), Color(CELLAR_LINE, 0.72), 8.0, true)
	var lock_center := _world_to_screen(origin + Vector2(805.0, 415.0))
	draw_rect(Rect2(lock_center - Vector2(17.0, 19.0), Vector2(34.0, 38.0)), CELLAR_KEY_COLOR if cellar_has_key else CELLAR_STONE_COLOR)
	draw_circle(lock_center, 5.0, CELLAR_BG)
	var mage_center := _world_to_screen(origin + Vector2(940.0, 468.0))
	draw_circle(mage_center + Vector2(0.0, -72.0), 17.0, PALE)
	draw_arc(mage_center + Vector2(0.0, -72.0), 28.0, PI, TAU, 18, PALE, 7.0, true)
	draw_line(mage_center + Vector2(0.0, -55.0), mage_center + Vector2(-9.0, 0.0), PALE, 8.0, true)
	draw_line(mage_center + Vector2(-9.0, 0.0), mage_center + Vector2(-30.0, 47.0), PALE, 6.0, true)
	draw_line(mage_center + Vector2(-2.0, -38.0), mage_center + Vector2(42.0, 32.0), HEMP, 5.0, true)
	if not cellar_rescue_started:
		var help_phase: float = fmod(level3_help_clock, 3.2)
		if help_phase < 1.45:
			var help_alpha: float = sin(help_phase / 1.45 * PI)
			draw_string(ui_font, mage_center + Vector2(-33.0, -116.0), "Help…", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 17, Color(PAPER, help_alpha * 0.72))
			for ring_index in range(2):
				draw_arc(mage_center + Vector2(0.0, -72.0), 35.0 + float(ring_index) * 16.0 + help_phase * 7.0, PI * 1.08, PI * 1.92, 16, Color(PAPER, help_alpha * 0.32), 2.0, true)

func _draw_cellar_portals() -> void:
	for portal in _cellar_portals():
		var zone: Rect2 = portal["zone"]
		var side: String = String(portal["side"])
		var screen_zone := _world_rect_to_screen(zone)
		if side == "up" or side == "up_left":
			draw_line(screen_zone.position + Vector2(45.0, 0.0), screen_zone.position + Vector2(45.0, 160.0), Color(CELLAR_LINE, 0.48), 5.0, true)
			draw_line(screen_zone.position + Vector2(115.0, 0.0), screen_zone.position + Vector2(115.0, 160.0), Color(CELLAR_LINE, 0.48), 5.0, true)
			for rung_index in range(5):
				var rung_y: float = screen_zone.position.y + 22.0 + float(rung_index) * 31.0
				draw_line(Vector2(screen_zone.position.x + 45.0, rung_y), Vector2(screen_zone.position.x + 115.0, rung_y), Color(CELLAR_LINE, 0.38), 4.0, true)
		elif side == "down":
			draw_rect(Rect2(screen_zone.position + Vector2(18.0, 118.0), Vector2(154.0, 28.0)), Color("030506"))
			draw_line(screen_zone.position + Vector2(18.0, 116.0), screen_zone.position + Vector2(172.0, 116.0), Color(CELLAR_LINE, 0.45), 5.0, true)
		else:
			var arch_center := Vector2(screen_zone.get_center().x, screen_zone.position.y + 83.0)
			draw_rect(Rect2(arch_center + Vector2(-51.0, 0.0), Vector2(102.0, 87.0)), Color("030506"))
			draw_arc(arch_center, 51.0, PI, TAU, 22, Color(CELLAR_LINE, 0.45), 6.0, true)
			draw_line(arch_center + Vector2(-51.0, 0.0), arch_center + Vector2(-51.0, 87.0), Color(CELLAR_LINE, 0.45), 6.0, true)
			draw_line(arch_center + Vector2(51.0, 0.0), arch_center + Vector2(51.0, 87.0), Color(CELLAR_LINE, 0.45), 6.0, true)

func _draw_cellar_platform(world_rect: Rect2) -> void:
	var screen_rect := _world_rect_to_screen(world_rect)
	var top_points := PackedVector2Array([
		screen_rect.position + Vector2(0.0, 6.0),
		screen_rect.position + Vector2(screen_rect.size.x * 0.25, 0.0),
		screen_rect.position + Vector2(screen_rect.size.x * 0.53, 5.0),
		screen_rect.position + Vector2(screen_rect.size.x * 0.78, 1.0),
		screen_rect.position + Vector2(screen_rect.size.x, 7.0),
		screen_rect.end,
		Vector2(screen_rect.position.x, screen_rect.end.y),
	])
	draw_polygon(top_points, PackedColorArray([Color("b9bfba")]))
	draw_polyline(PackedVector2Array([top_points[0], top_points[1], top_points[2], top_points[3], top_points[4]]), CELLAR_BG, 4.0, true)
	for scratch_index in range(maxi(1, int(world_rect.size.x / 105.0))):
		var scratch_x: float = screen_rect.position.x + 45.0 + float(scratch_index) * 103.0
		draw_line(Vector2(scratch_x, screen_rect.position.y + 17.0), Vector2(scratch_x - 15.0, screen_rect.position.y + 55.0), Color(CELLAR_BG, 0.46), 2.0, true)

func _draw_cellar_traps() -> void:
	for spike_entry in _cellar_spike_entries():
		var spike_rect: Rect2 = spike_entry["rect"]
		_draw_spike_strip(_world_rect_to_screen(spike_rect), _cellar_spike_strength(float(spike_entry["phase"])))
	for gas_entry in _cellar_gas_entries():
		var gas_rect: Rect2 = gas_entry["rect"]
		var vent_center := _world_to_screen(Vector2(gas_rect.get_center().x, gas_rect.end.y))
		draw_arc(vent_center, 18.0, PI, TAU, 18, CELLAR_LINE, 4.0, true)
		if _cellar_gas_active(float(gas_entry["phase"])):
			var screen_rect := _world_rect_to_screen(gas_rect)
			for puff_index in range(8):
				var ratio: float = float(puff_index) / 7.0
				var puff_center := Vector2(screen_rect.get_center().x + sin(elapsed * 4.8 + float(puff_index)) * 13.0, lerpf(screen_rect.end.y, screen_rect.position.y, ratio))
				draw_circle(puff_center, 11.0 + float(puff_index % 3) * 4.0, Color(GAS, 0.38))
				draw_circle(puff_center, 11.0 + float(puff_index % 3) * 4.0, Color(GAS, 0.82), false, 2.0, true)
		else:
			for warning_index in range(3):
				draw_circle(vent_center + Vector2(-10.0 + float(warning_index) * 10.0, -14.0 - float(warning_index % 2) * 7.0), 3.0, Color(GAS, 0.55))

func _draw_cellar_falling_rocks() -> void:
	for rock in cellar_falling_rocks:
		var center: Vector2 = _world_to_screen(rock["position"])
		var radius: float = float(rock["radius"])
		_draw_cellar_stone(center, radius)
		for trail_index in range(3):
			draw_line(center + Vector2(-12.0 + float(trail_index) * 12.0, -radius - 48.0), center + Vector2(-15.0 + float(trail_index) * 12.0, -radius - 12.0), Color(CELLAR_LINE, 0.18), 2.0, true)

func _draw_cellar_dust() -> void:
	for dust in cellar_dust:
		var life: float = float(dust["life"])
		var color_value: Color = dust["color"]
		draw_circle(_world_to_screen(dust["position"]), 4.0 + life * 8.0, Color(color_value, life * 0.65))

func _draw_cellar_stone(center: Vector2, radius: float) -> void:
	var stone := PackedVector2Array([
		center + Vector2(-radius, 3.0), center + Vector2(-radius * 0.58, -radius * 0.76),
		center + Vector2(radius * 0.25, -radius), center + Vector2(radius, -radius * 0.12),
		center + Vector2(radius * 0.70, radius * 0.72), center + Vector2(-radius * 0.42, radius),
	])
	draw_polygon(stone, PackedColorArray([CELLAR_STONE_COLOR]))
	draw_polyline(stone, CELLAR_BG, 3.0, true)
	draw_line(center + Vector2(-radius * 0.42, -radius * 0.3), center + Vector2(radius * 0.28, radius * 0.12), Color(CELLAR_BG, 0.32), 2.0, true)

func _draw_cellar_cracked_wall(center_world: Vector2, hits: int, required_hits: int, optional: bool) -> void:
	if hits >= required_hits:
		return
	var wall := _world_rect_to_screen(Rect2(center_world - Vector2(55.0, 140.0), Vector2(110.0, 280.0)))
	draw_rect(wall, Color("2b3032"))
	draw_rect(wall, Color(CELLAR_LINE, 0.22), false, 4.0)
	var crack_center := wall.get_center()
	var crack_scale: float = 0.75 + float(hits) * 0.24
	var crack_points := PackedVector2Array([
		crack_center + Vector2(0.0, -70.0) * crack_scale,
		crack_center + Vector2(-18.0, -34.0) * crack_scale,
		crack_center + Vector2(12.0, -4.0) * crack_scale,
		crack_center + Vector2(-24.0, 31.0) * crack_scale,
		crack_center + Vector2(9.0, 78.0) * crack_scale,
	])
	draw_polyline(crack_points, Color(PAPER, 0.62 if optional else 0.78), 3.0 + float(hits), true)
	for branch_index in range(3 + hits):
		var branch_point: Vector2 = crack_center + Vector2(-15.0 + float(branch_index) * 9.0, -28.0 + float(branch_index) * 26.0)
		draw_line(branch_point, branch_point + Vector2((-22.0 if branch_index % 2 == 0 else 24.0), 17.0), Color(PAPER, 0.42), 2.0, true)

func _draw_cellar_key(center: Vector2, scale_factor: float, alpha: float) -> void:
	var key_color := Color(CELLAR_KEY_COLOR, alpha)
	draw_circle(center + Vector2(-31.0, 0.0) * scale_factor, 18.0 * scale_factor, key_color, false, 6.0 * scale_factor, true)
	draw_line(center + Vector2(-13.0, 0.0) * scale_factor, center + Vector2(47.0, 0.0) * scale_factor, key_color, 8.0 * scale_factor, true)
	draw_line(center + Vector2(24.0, 0.0) * scale_factor, center + Vector2(24.0, 18.0) * scale_factor, key_color, 7.0 * scale_factor, true)
	draw_line(center + Vector2(42.0, 0.0) * scale_factor, center + Vector2(42.0, 13.0) * scale_factor, key_color, 7.0 * scale_factor, true)

func _draw_cellar_context_prompt() -> void:
	if cellar_transition_time > 0.0 or cellar_focus_time > 0.55:
		return
	var player_rect := Rect2(player_position, PLAYER_SIZE)
	var origin: Vector2 = _cellar_region_origin(cellar_region)
	var prompt_world := Vector2.ZERO
	var has_prompt := false
	if cellar_region == "O":
		if cellar_has_rubble:
			_draw_level_03_f_prompt(_world_to_screen(player_position + Vector2(PLAYER_SIZE.x * 0.5, -22.0)))
			return
		var rubble_zone: Rect2 = Rect2(cellar_rubble_position - Vector2(48.0, 58.0), Vector2(96.0, 116.0))
		if not cellar_has_rubble and not cellar_rubble_thrown and cellar_optional_wall_hits < CELLAR_OPTIONAL_WALL_HITS_REQUIRED and player_rect.intersects(rubble_zone):
			prompt_world = rubble_zone.get_center() - Vector2(0.0, 95.0)
			has_prompt = true
	elif cellar_region == "C" and not cellar_drain_open:
		var wheel_zone := Rect2(origin + Vector2(470.0, 390.0), Vector2(190.0, 190.0))
		if player_rect.intersects(wheel_zone):
			prompt_world = wheel_zone.get_center() - Vector2(0.0, 130.0)
			has_prompt = true
	elif cellar_region == "Q" and cellar_drain_open and not cellar_has_stone:
		var quarry_zone := Rect2(origin + Vector2(120.0, 455.0), Vector2(190.0, 125.0))
		if player_rect.intersects(quarry_zone):
			prompt_world = quarry_zone.get_center() - Vector2(0.0, 95.0)
			has_prompt = true
	elif cellar_region == "W" and cellar_has_stone and cellar_required_wall_hits < CELLAR_WALL_HITS_REQUIRED:
		var required_zone := Rect2(origin + Vector2(500.0, 285.0), Vector2(145.0, 300.0))
		if player_rect.intersects(required_zone):
			prompt_world = required_zone.get_center() - Vector2(0.0, 185.0)
			has_prompt = true
	elif cellar_region == "K" and not cellar_has_key:
		var key_zone := Rect2(origin + Vector2(475.0, 380.0), Vector2(210.0, 200.0))
		if player_rect.intersects(key_zone):
			prompt_world = key_zone.get_center() - Vector2(0.0, 150.0)
			has_prompt = true
	elif cellar_region == "P":
		var prison_zone := Rect2(origin + Vector2(790.0, 315.0), Vector2(280.0, 270.0))
		if player_rect.intersects(prison_zone):
			prompt_world = prison_zone.get_center() - Vector2(0.0, 170.0)
			has_prompt = true
	if has_prompt:
		_draw_level_03_f_prompt(_world_to_screen(prompt_world))
		return
	for portal in _cellar_portals():
		var zone: Rect2 = portal["zone"]
		if player_rect.intersects(zone):
			_draw_level_03_f_prompt(_world_to_screen(zone.get_center() - Vector2(0.0, 118.0)))
			return

func _draw_cellar_darkness() -> void:
	var light_world: Vector2 = player_position + PLAYER_SIZE * 0.5 + Vector2(player_facing * 42.0, 0.0)
	if not on_ground and player_velocity.y > 80.0:
		light_world += Vector2(0.0, 55.0)
	if cellar_focus_time > 0.55:
		if cellar_focus_kind == "prison" or cellar_focus_kind == "rescue":
			light_world = _cellar_region_origin("P") + Vector2(940.0, 390.0)
		elif cellar_focus_kind == "key":
			light_world = _cellar_region_origin("K") + Vector2(575.0, 430.0)
		elif cellar_focus_kind == "drain":
			light_world = _cellar_region_origin("C") + Vector2(560.0, 455.0)
		elif cellar_focus_kind == "o_boulder":
			light_world = _cellar_region_origin("O") + Vector2(985.0, 435.0)
	var center: Vector2 = _world_to_screen(light_world)
	var band_count := 12
	for band_index in range(band_count):
		var inner_radius: float = CELLAR_LIGHT_RADIUS + CELLAR_LIGHT_FEATHER * float(band_index) / float(band_count)
		var outer_radius: float = CELLAR_LIGHT_RADIUS + CELLAR_LIGHT_FEATHER * float(band_index + 1) / float(band_count)
		var band_alpha: float = 0.07 + float(band_index) / float(band_count - 1) * 0.83
		_draw_cellar_annulus(center, inner_radius, outer_radius, Color(CELLAR_BG, band_alpha))
	_draw_cellar_annulus(center, CELLAR_LIGHT_RADIUS + CELLAR_LIGHT_FEATHER, 2200.0, Color(CELLAR_BG, 0.985))
	draw_arc(center, CELLAR_LIGHT_RADIUS + 5.0, 0.0, TAU, 72, Color(PAPER, 0.07), 2.0, true)
	if cellar_intro_time > 0.55 or cellar_focus_time > 0.55:
		draw_rect(Rect2(0.0, 0.0, SCREEN.x, 42.0), CELLAR_BG)
		draw_rect(Rect2(0.0, SCREEN.y - 42.0, SCREEN.x, 42.0), CELLAR_BG)

func _draw_cellar_annulus(center: Vector2, inner_radius: float, outer_radius: float, color_value: Color) -> void:
	var segment_count := 72
	for segment_index in range(segment_count):
		var angle_a: float = float(segment_index) * TAU / float(segment_count)
		var angle_b: float = float(segment_index + 1) * TAU / float(segment_count)
		var points := PackedVector2Array([
			center + Vector2(cos(angle_a), sin(angle_a)) * inner_radius,
			center + Vector2(cos(angle_a), sin(angle_a)) * outer_radius,
			center + Vector2(cos(angle_b), sin(angle_b)) * outer_radius,
			center + Vector2(cos(angle_b), sin(angle_b)) * inner_radius,
		])
		draw_polygon(points, PackedColorArray([color_value]))

func _draw_cellar_failure_effect() -> void:
	var center: Vector2 = _world_to_screen(player_position + PLAYER_SIZE * 0.5)
	var alpha: float = clampf(1.0 - cellar_failure_time / 0.72, 0.0, 1.0)
	var effect_color: Color = GAS if cellar_failure_kind == "gas" else FIRE if cellar_failure_kind == "rock" else PAPER
	for slash_index in range(8):
		var angle: float = float(slash_index) * TAU / 8.0
		var start := center + Vector2(cos(angle), sin(angle)) * 22.0
		var finish := center + Vector2(cos(angle), sin(angle)) * (42.0 + cellar_failure_time * 38.0)
		draw_line(start, finish, Color(effect_color, alpha), 4.0, true)

func _draw_cellar_rescued() -> void:
	draw_rect(Rect2(Vector2.ZERO, SCREEN), CELLAR_BG)
	var cell_opening := Rect2(305.0, 115.0, 670.0, 500.0)
	draw_rect(cell_opening, Color("111617"))
	for bar_index in range(8):
		var bar_x: float = cell_opening.position.x + 34.0 + float(bar_index) * 84.0
		var lean: float = -55.0 if bar_index >= 4 else 0.0
		draw_line(Vector2(bar_x, cell_opening.position.y), Vector2(bar_x + lean, cell_opening.end.y), Color(CELLAR_LINE, 0.38), 8.0, true)
	draw_circle(Vector2(640.0, 310.0), 24.0, PALE)
	draw_arc(Vector2(640.0, 310.0), 38.0, PI, TAU, 22, PALE, 9.0, true)
	draw_line(Vector2(640.0, 334.0), Vector2(620.0, 430.0), PALE, 10.0, true)
	draw_line(Vector2(620.0, 430.0), Vector2(580.0, 505.0), PALE, 7.0, true)
	var title := "监牢已经打开"
	var title_width: float = ui_font.get_string_size(title, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 32).x
	draw_string(ui_font, Vector2((SCREEN.x - title_width) * 0.5, 570.0), title, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 32, PAPER)

func _draw_level_02_ropeway() -> void:
	_draw_ropeway_background()
	for platform_rect in ROPEWAY_PLATFORMS:
		_draw_platform(_world_rect_to_screen(platform_rect))
	_draw_moving_platform(_world_rect_to_screen(_ropeway_moving_platform(elapsed)))
	_draw_ropeway_guide_ropes()
	_draw_ropeway_collectible_rope()
	_draw_ropeway_knots()
	_draw_ropeway_climb_anchor()
	_draw_ropeway_boulder()
	if entry_fall_lock > 0.0:
		var center: Vector2 = _world_to_screen(player_position + PLAYER_SIZE * 0.5)
		for line_index in range(5):
			var x: float = center.x - 38.0 + float(line_index) * 19.0
			draw_line(Vector2(x, center.y - 58.0), Vector2(x - 3.0, center.y - 20.0), Color(MID, 0.55), 2.0, true)

func _draw_ropeway_background() -> void:
	for ridge_index in range(5):
		var base_y: float = 145.0 + float(ridge_index) * 92.0
		var ridge := PackedVector2Array()
		for point_index in range(10):
			var world_x: float = float(point_index) * 270.0
			var world_y: float = base_y + sin(float(point_index) * 1.7 + float(ridge_index)) * 35.0
			ridge.append(_world_to_screen(Vector2(world_x, world_y)))
		draw_polyline(ridge, Color(MID, 0.12 + float(ridge_index) * 0.035), 2.0 + float(ridge_index) * 0.5, true)
	draw_rect(_world_rect_to_screen(Rect2(0.0, 635.0, 2390.0, 100.0)), INK)
	draw_polygon(PackedVector2Array([
		_world_to_screen(Vector2(1960.0, 565.0)),
		_world_to_screen(Vector2(2050.0, 470.0)),
		_world_to_screen(Vector2(2050.0, 720.0)),
		_world_to_screen(Vector2(1938.0, 720.0)),
	]), PackedColorArray([INK]))
	draw_line(_world_to_screen(Vector2(2350.0, 80.0)), _world_to_screen(Vector2(2350.0, 560.0)), INK, 12.0, true)

func _draw_ropeway_guide_ropes() -> void:
	var guide := PackedVector2Array()
	for point in ropeway_boulder_path:
		guide.append(_world_to_screen(point + Vector2(0.0, 43.0)))
	draw_polyline(guide, Color(MID, 0.5), 3.0, true)
	for platform_rect in ROPEWAY_PLATFORMS:
		var center: Vector2 = _world_to_screen(platform_rect.get_center())
		draw_line(center + Vector2(0.0, -2.0), center + Vector2(0.0, -42.0), Color(MID, 0.38), 2.0, true)
	var moving_platform := _ropeway_moving_platform(elapsed)
	var moving_center := _world_to_screen(moving_platform.get_center())
	var moving_track_start := _world_to_screen(Vector2(1370.0, 530.0))
	var moving_track_end := _world_to_screen(Vector2(1548.0, 530.0))
	draw_line(moving_track_start, moving_track_end, Color(MID, 0.42), 2.0, true)
	draw_line(moving_center + Vector2(0.0, -10.0), Vector2(moving_center.x, moving_track_start.y), Color(MID, 0.55), 2.0, true)

func _draw_ropeway_collectible_rope() -> void:
	var rope_points := PackedVector2Array()
	for knot in ROPEWAY_KNOTS:
		rope_points.append(knot.get_center())
	rope_points.append(Vector2(2220.0, 470.0))
	for index in range(ropeway_knot_count, rope_points.size() - 1):
		var start: Vector2 = _world_to_screen(rope_points[index])
		var finish: Vector2 = _world_to_screen(rope_points[index + 1])
		var middle: Vector2 = (start + finish) * 0.5 + Vector2(0.0, 14.0)
		draw_polyline(PackedVector2Array([start, middle, finish]), INK, 5.0, true)
		draw_polyline(PackedVector2Array([start, middle, finish]), HEMP, 2.5, true)
	if ropeway_collect_time > 0.0:
		var progress: float = 1.0 - ropeway_collect_time / 0.48
		var source: Vector2 = _world_to_screen(ropeway_collect_origin)
		var hand: Vector2 = _world_to_screen(player_position + Vector2(PLAYER_SIZE.x * 0.5 + player_facing * 14.0, 31.0))
		var moving_point: Vector2 = source.lerp(hand, smoothstep(0.0, 1.0, progress))
		draw_line(moving_point, hand, Color(HEMP, 1.0 - progress * 0.35), 4.0, true)
		draw_circle(moving_point, 4.0, HEMP_LIGHT)
		draw_circle(moving_point, 4.0, INK, false, 2.0)

func _draw_ropeway_knots() -> void:
	var active: int = _active_ropeway_knot()
	for index in range(ROPEWAY_KNOTS.size()):
		var knot: Rect2 = ROPEWAY_KNOTS[index]
		var center: Vector2 = _world_to_screen(knot.get_center())
		if ropeway_knots[index]:
			draw_arc(center, 9.0, 0.15, PI * 1.55, 16, Color(HEMP, 0.52), 2.0, true)
			continue
		var apex_ready: bool = (
			index == active
			and ROPEWAY_KNOT_APEX_REQUIRED[index]
			and _can_collect_ropeway_knot(index)
		)
		if apex_ready:
			var glow_pulse: float = (sin(elapsed * 13.0) + 1.0) * 2.0
			draw_circle(center, 25.0 + glow_pulse, Color(HEMP_LIGHT, 0.2))
			draw_arc(center, 20.0 + glow_pulse, 0.0, TAU, 28, Color(HEMP_LIGHT, 0.95), 3.0, true)
			for ray_index in range(8):
				var ray_direction := Vector2.RIGHT.rotated(float(ray_index) * TAU / 8.0)
				draw_line(
					center + ray_direction * 24.0,
					center + ray_direction * (31.0 + glow_pulse),
					Color(HEMP_LIGHT, 0.9),
					2.0,
					true
				)
		if ROPEWAY_KNOT_HANGING[index]:
			draw_line(center + Vector2(0.0, -34.0), center, INK, 5.0, true)
			draw_line(center + Vector2(0.0, -34.0), center, HEMP, 2.5, true)
		draw_circle(center, 12.0, HEMP_LIGHT)
		draw_circle(center, 12.0, INK, false, 3.0, true)
		draw_arc(center, 6.0, 0.0, TAU, 18, INK, 2.0, true)
		if ROPEWAY_KNOT_APEX_REQUIRED[index]:
			draw_line(center + Vector2(-9.0, -22.0), center + Vector2(0.0, -31.0), INK, 2.0, true)
			draw_line(center + Vector2(0.0, -31.0), center + Vector2(9.0, -22.0), INK, 2.0, true)
		if index == active:
			draw_circle(center, 17.0 + sin(elapsed * 5.0) * 2.0, Color(INK, 0.35), false, 2.0, true)
	if active >= 0 and _ropeway_knot_prompt_visible(active):
		_draw_key_prompt(_world_to_screen(ROPEWAY_KNOTS[active].get_center()) + Vector2(0.0, -54.0), "F", "")

func _draw_ropeway_climb_anchor() -> void:
	var anchor: Vector2 = _world_to_screen(ROPEWAY_CLIMB_ANCHOR)
	draw_circle(anchor, 18.0, PAPER)
	draw_circle(anchor, 18.0, INK, false, 4.0, true)
	draw_line(anchor + Vector2(0.0, -18.0), anchor + Vector2(0.0, -52.0), INK, 4.0, true)
	if ropeway_rope_installed:
		draw_line(anchor, _world_to_screen(Vector2(ROPEWAY_CLIMB_ANCHOR.x, 470.0)), INK, 5.0, true)
		draw_line(anchor, _world_to_screen(Vector2(ROPEWAY_CLIMB_ANCHOR.x, 470.0)), HEMP, 2.5, true)
		return
	var player_rect := Rect2(player_position, PLAYER_SIZE)
	if player_rect.intersects(ROPEWAY_CLIMB_ZONE):
		var label: String = "架设长绳" if ropeway_knot_count >= ROPEWAY_KNOTS.size() else "绳长不足"
		_draw_key_prompt(anchor + Vector2(0.0, 55.0), "F", label)

func _draw_ropeway_boulder() -> void:
	if ropeway_chase_state == "gone":
		return
	var center: Vector2 = _world_to_screen(ropeway_boulder_position)
	var radius: float = ROPEWAY_BOULDER_RADIUS
	if ropeway_chase_state == "warning":
		draw_circle(center, radius + 10.0 + sin(elapsed * 18.0) * 3.0, Color(FIRE, 0.8), false, 4.0, true)
	var rock_offsets: Array[Vector2] = [
		Vector2(-39.0, -11.0), Vector2(-27.0, -34.0), Vector2(-5.0, -41.0),
		Vector2(20.0, -35.0), Vector2(39.0, -17.0), Vector2(41.0, 9.0),
		Vector2(25.0, 34.0), Vector2(2.0, 40.0), Vector2(-25.0, 31.0),
		Vector2(-42.0, 11.0),
	]
	var rock_points := PackedVector2Array()
	for offset in rock_offsets:
		rock_points.append(center + offset.rotated(ropeway_boulder_angle))
	draw_polygon(rock_points, PackedColorArray([Color("777a78")]))
	var rock_outline: PackedVector2Array = rock_points.duplicate()
	rock_outline.append(rock_points[0])
	draw_polyline(rock_outline, INK, 4.0, true)

	var facet_a := center + Vector2(-19.0, -16.0).rotated(ropeway_boulder_angle)
	var facet_b := center + Vector2(9.0, -25.0).rotated(ropeway_boulder_angle)
	var facet_c := center + Vector2(24.0, 4.0).rotated(ropeway_boulder_angle)
	var facet_d := center + Vector2(-7.0, 23.0).rotated(ropeway_boulder_angle)
	draw_line(facet_a, facet_b, INK, 2.5, true)
	draw_line(facet_b, facet_c, INK, 2.5, true)
	draw_line(facet_c, facet_d, INK, 2.5, true)
	draw_line(facet_d, facet_a, Color(INK, 0.55), 1.5, true)
	draw_line(facet_a, center + Vector2(-29.0, 8.0).rotated(ropeway_boulder_angle), Color(PAPER, 0.72), 2.0, true)
	draw_line(facet_c, center + Vector2(29.0, 19.0).rotated(ropeway_boulder_angle), Color(PAPER, 0.55), 2.0, true)

func _draw_ropeway_held_coil() -> void:
	var hand_world: Vector2 = player_position + Vector2(PLAYER_SIZE.x * 0.5 + player_facing * 15.0, 31.0)
	var hand: Vector2 = _world_to_screen(hand_world)
	var loop_count: int = 1 + ropeway_knot_count
	for loop_index in range(loop_count):
		var radius: float = 5.0 + float(loop_index) * 2.0
		var loop_center := hand + Vector2(float(loop_index % 2) * 1.5, 0.0)
		draw_arc(loop_center, radius, 0.0, TAU, 20, INK, 3.5, true)
		draw_arc(loop_center, radius, 0.0, TAU, 20, HEMP, 1.8, true)

func _draw_ropeway_failure_effect() -> void:
	var center: Vector2 = _world_to_screen(player_position + PLAYER_SIZE * 0.5)
	var alpha: float = clampf(1.0 - ropeway_failure_time / 0.78, 0.0, 1.0)
	draw_circle(center, 28.0 + ropeway_failure_time * 38.0, Color(FIRE, alpha), false, 4.0, true)
	draw_string(ui_font, center + Vector2(-45.0, -48.0), ropeway_failure_reason, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 14, Color(INK, alpha))

func _draw_level_02_cave() -> void:
	_draw_cave_background()
	for platform_rect in CAVE_PLATFORMS:
		var screen_rect: Rect2 = _world_rect_to_screen(platform_rect)
		draw_rect(screen_rect, INK)
		draw_line(screen_rect.position, Vector2(screen_rect.end.x, screen_rect.position.y), PAPER, 4.0, true)
		for mark_index in range(maxi(1, int(platform_rect.size.x / 95.0))):
			var mark_x: float = screen_rect.position.x + 34.0 + float(mark_index) * 92.0
			draw_line(Vector2(mark_x, screen_rect.position.y + 13.0), Vector2(mark_x + 15.0, screen_rect.position.y + 28.0), Color(PAPER, 0.2), 2.0, true)
	_draw_cave_exit()
	_draw_cave_chest()
	_draw_cave_mid_checkpoint()
	_draw_cave_rolling_source()
	_draw_cave_arrow_trap()
	_draw_cave_falling_rocks()
	_draw_cave_dust()
	_draw_cave_rolling_rocks()

func _draw_cave_background() -> void:
	for layer_index in range(4):
		var ceiling_line := PackedVector2Array()
		for point_index in range(19):
			var world_x: float = float(point_index) * 270.0 - 80.0
			var world_y: float = 78.0 + float(layer_index) * 42.0 + sin(float(point_index) * 1.43 + float(layer_index)) * 28.0
			ceiling_line.append(_world_to_screen(Vector2(world_x, world_y)))
		draw_polyline(ceiling_line, Color(MID, 0.16 + float(layer_index) * 0.055), 3.0 + float(layer_index), true)
	for root_index in range(25):
		var root_x: float = float(root_index) * 205.0 - 40.0
		var root_start: Vector2 = _world_to_screen(Vector2(root_x, 0.0))
		var root_end: Vector2 = _world_to_screen(Vector2(root_x + sin(float(root_index) * 1.7) * 36.0, 105.0 + fmod(float(root_index) * 31.0, 92.0)))
		draw_line(root_start, root_end, Color(INK, 0.24), 5.0, true)
	for gap_index in range(CAVE_PLATFORMS.size() - 1):
		var left_platform: Rect2 = CAVE_PLATFORMS[gap_index]
		var right_platform: Rect2 = CAVE_PLATFORMS[gap_index + 1]
		var gap_left: float = left_platform.end.x
		var gap_right: float = right_platform.position.x
		var lip_left: Vector2 = _world_to_screen(Vector2(gap_left, left_platform.position.y))
		var lip_right: Vector2 = _world_to_screen(Vector2(gap_right, right_platform.position.y))
		draw_line(lip_left, lip_left + Vector2(18.0, 58.0), Color(MID, 0.55), 3.0, true)
		draw_line(lip_right, lip_right + Vector2(-18.0, 58.0), Color(MID, 0.55), 3.0, true)

func _draw_cave_exit() -> void:
	var outdoor_rect: Rect2 = _world_rect_to_screen(Rect2(4190.0, 0.0, 510.0, 195.0))
	draw_rect(outdoor_rect, Color(PALE, 0.42))
	var mouth_points := PackedVector2Array([
		_world_to_screen(Vector2(4175.0, 195.0)),
		_world_to_screen(Vector2(4210.0, 105.0)),
		_world_to_screen(Vector2(4310.0, 54.0)),
		_world_to_screen(Vector2(4440.0, 42.0)),
		_world_to_screen(Vector2(4600.0, 78.0)),
		_world_to_screen(Vector2(4700.0, 150.0)),
	])
	draw_polyline(mouth_points, INK, 12.0, true)
	_draw_shared_hut_forecourt(_world_to_screen(Vector2(4580.0, 195.0)), 0.42, 0, "ground")

func _draw_cave_rolling_source() -> void:
	var source: Vector2 = _world_to_screen(Vector2(CAVE_ROLLING_SOURCE_X, 34.0))
	var chute_points := PackedVector2Array([
		source + Vector2(-54.0, -38.0),
		source + Vector2(-36.0, 32.0),
		source + Vector2(36.0, 32.0),
		source + Vector2(54.0, -38.0),
	])
	draw_polyline(chute_points, INK, 7.0, true)
	draw_line(source + Vector2(-36.0, 32.0), source + Vector2(36.0, 32.0), Color(PAPER, 0.7), 3.0, true)
	for dust_index in range(3):
		var dust_center: Vector2 = source + Vector2(-22.0 + float(dust_index) * 22.0, 46.0 + fmod(elapsed * 28.0 + float(dust_index) * 11.0, 28.0))
		draw_circle(dust_center, 3.0 + float(dust_index), Color(MID, 0.28))

func _draw_cave_chest() -> void:
	var chest: Rect2 = _world_rect_to_screen(CAVE_CHEST)
	if not cave_chest_open:
		var pulse: float = (sin(elapsed * 4.5) + 1.0) * 4.0
		draw_circle(chest.get_center(), 58.0 + pulse, Color(GOLD, 0.10))
		draw_arc(chest.get_center(), 49.0 + pulse, 0.0, TAU, 36, Color(GOLD, 0.62), 3.0, true)
	draw_rect(Rect2(chest.position + Vector2(0.0, 28.0), Vector2(chest.size.x, chest.size.y - 28.0)), PAPER)
	draw_rect(Rect2(chest.position + Vector2(0.0, 28.0), Vector2(chest.size.x, chest.size.y - 28.0)), INK, false, 4.0)
	if cave_chest_open:
		draw_line(chest.position + Vector2(4.0, 28.0), chest.position + Vector2(18.0, -4.0), INK, 5.0, true)
		draw_line(chest.position + Vector2(18.0, -4.0), chest.position + Vector2(83.0, 13.0), INK, 5.0, true)
	else:
		draw_arc(chest.get_center() + Vector2(0.0, 28.0), 43.0, PI, TAU, 28, INK, 5.0, true)
		draw_rect(Rect2(chest.get_center() + Vector2(-7.0, 23.0), Vector2(14.0, 20.0)), GOLD)
	if not cave_chest_open and Rect2(player_position, PLAYER_SIZE).intersects(CAVE_CHEST_INTERACTION):
		_draw_key_prompt(chest.get_center() + Vector2(0.0, -62.0), "F", "")
	if shield_pickup_time > 0.0:
		var pickup_progress: float = 1.0 - shield_pickup_time / 0.95
		var source: Vector2 = chest.get_center() + Vector2(0.0, -18.0)
		var target: Vector2 = _world_to_screen(player_position + Vector2(PLAYER_SIZE.x * 0.5, 25.0))
		var arc_height: float = sin(clampf(pickup_progress, 0.0, 1.0) * PI) * 58.0
		var shield_center: Vector2 = source.lerp(target, smoothstep(0.0, 1.0, pickup_progress)) - Vector2(0.0, arc_height)
		_draw_shield_shape(shield_center, pickup_progress * 1.8, 0.82, GOLD_LIGHT)

func _draw_cave_mid_checkpoint() -> void:
	var marker_world: Vector2 = CAVE_MID_CHECKPOINT_POSITION + Vector2(PLAYER_SIZE.x * 0.5, PLAYER_SIZE.y)
	var anchor: Vector2 = _world_to_screen(marker_world)
	var marker_color: Color = GOLD if cave_mid_checkpoint_active else Color(PAPER, 0.58)
	draw_line(anchor + Vector2(0.0, -46.0), anchor + Vector2(0.0, -5.0), INK, 4.0, true)
	draw_arc(anchor + Vector2(0.0, -49.0), 15.0, 0.0, TAU, 24, marker_color, 4.0, true)
	draw_circle(anchor + Vector2(0.0, -49.0), 5.0, marker_color)
	if cave_mid_checkpoint_active:
		draw_arc(anchor + Vector2(0.0, -49.0), 24.0 + sin(elapsed * 4.0) * 3.0, 0.0, TAU, 30, Color(GOLD, 0.42), 3.0, true)

func _draw_cave_rolling_rocks() -> void:
	for index in range(cave_rolling_rocks.size()):
		var rock: Dictionary = cave_rolling_rocks[index]
		var state: String = String(rock["state"])
		if state == "gone":
			continue
		var rock_position: Vector2 = rock["position"]
		var center: Vector2 = _world_to_screen(rock_position)
		var radius: float = float(rock["radius"])
		if state == "shattered":
			var shatter_ratio: float = 1.0 - float(rock["shatter_time"]) / SHIELD_SHATTER_DURATION
			for fragment_index in range(9):
				var angle: float = float(fragment_index) * TAU / 9.0 + float(index) * 0.37
				var travel: float = 12.0 + shatter_ratio * (38.0 + float(fragment_index % 3) * 8.0)
				var fragment_center: Vector2 = center + Vector2(cos(angle), sin(angle)) * travel + Vector2(0.0, shatter_ratio * shatter_ratio * 34.0)
				draw_circle(fragment_center, maxf(2.0, radius * 0.12), Color(INK, 1.0 - shatter_ratio * 0.75))
			continue
		_draw_cave_rock_shape(center, radius, float(rock["angle"]))

func _draw_cave_dust() -> void:
	for puff in cave_dust_puffs:
		var remaining: float = float(puff["time"])
		var progress: float = 1.0 - remaining / 0.62
		var dust_scale: float = float(puff["scale"])
		var origin_world: Vector2 = puff["position"]
		var origin: Vector2 = _world_to_screen(origin_world)
		for cloud_index in range(9):
			var spread_direction: float = -1.0 + float(cloud_index) / 4.0
			var cloud_center: Vector2 = origin + Vector2(
				spread_direction * (18.0 + progress * 42.0) * dust_scale,
				-6.0 - sin(float(cloud_index) * 1.7) * 5.0 - progress * 22.0
			)
			var cloud_radius: float = (5.0 + float(cloud_index % 3) * 2.5) * dust_scale * (1.0 - progress * 0.45)
			draw_circle(cloud_center, cloud_radius, Color(MID, (1.0 - progress) * 0.34))

func _draw_cave_falling_rocks() -> void:
	for rock in cave_falling_rocks:
		var state: String = String(rock["state"])
		if state == "gone":
			continue
		var rock_position: Vector2 = rock["position"]
		var center: Vector2 = _world_to_screen(rock_position)
		if state == "warning":
			var warning_ratio: float = clampf(float(rock["warning_time"]) / 0.72, 0.0, 1.0)
			draw_circle(center, 18.0 + sin(elapsed * 18.0) * 3.0, Color(FIRE, 0.16))
			draw_arc(center, 22.0, 0.0, TAU, 24, Color(FIRE, 0.82), 3.0, true)
			for debris_index in range(4):
				var debris_y: float = 24.0 + fmod(elapsed * (95.0 + debris_index * 11.0) + debris_index * 19.0, 82.0)
				draw_circle(center + Vector2(-13.0 + debris_index * 9.0, debris_y), 2.5, Color(INK, 0.55 + warning_ratio * 0.2))
			continue
		_draw_cave_rock_shape(center, float(rock["radius"]), float(rock["angle"]))
		for speed_line_index in range(3):
			var line_x: float = center.x - 15.0 + float(speed_line_index) * 15.0
			draw_line(Vector2(line_x, center.y - 48.0), Vector2(line_x, center.y - 29.0), Color(MID, 0.6), 2.0, true)

func _draw_cave_arrow_trap() -> void:
	var launcher: Vector2 = _world_to_screen(CAVE_ARROW_LAUNCHER)
	if cave_arrow_launcher_destroyed:
		for fragment_index in range(7):
			var fragment_angle: float = -2.6 + float(fragment_index) * 0.55
			var fragment_start: Vector2 = launcher + Vector2(cos(fragment_angle), sin(fragment_angle)) * 7.0
			var fragment_end: Vector2 = launcher + Vector2(cos(fragment_angle), sin(fragment_angle)) * (20.0 + float(fragment_index % 2) * 9.0)
			draw_line(fragment_start, fragment_end, Color(INK, 0.72), 4.0, true)
		draw_circle(launcher + Vector2(8.0, 20.0), 9.0, Color(INK, 0.72))
		_draw_cave_arrows()
		return
	draw_line(launcher + Vector2(18.0, -30.0), launcher + Vector2(18.0, 28.0), INK, 6.0, true)
	draw_arc(launcher + Vector2(4.0, 0.0), 27.0, -PI * 0.5, PI * 0.5, 22, INK, 4.0, true)
	draw_line(launcher + Vector2(4.0, -27.0), launcher + Vector2(4.0, 27.0), Color(MID, 0.75), 2.0, true)
	draw_line(launcher + Vector2(-28.0, 0.0), launcher + Vector2(18.0, 0.0), INK, 3.0, true)
	var shield_mark: Vector2 = launcher + Vector2(35.0, -42.0)
	draw_arc(shield_mark, 12.0, 0.0, PI, 16, GOLD, 3.0, true)
	draw_line(shield_mark + Vector2(-12.0, 0.0), shield_mark + Vector2(0.0, 16.0), GOLD, 3.0, true)
	draw_line(shield_mark + Vector2(12.0, 0.0), shield_mark + Vector2(0.0, 16.0), GOLD, 3.0, true)
	if Rect2(player_position, PLAYER_SIZE).grow(82.0).intersects(CAVE_ARROW_LAUNCHER_HITBOX):
		_draw_key_prompt(launcher + Vector2(0.0, -68.0), "F", "挥盾击毁")
	_draw_cave_arrows()

func _draw_cave_arrows() -> void:
	for arrow in cave_arrows:
		if String(arrow["state"]) != "flying":
			continue
		var arrow_position: Vector2 = arrow["position"]
		var arrow_center: Vector2 = _world_to_screen(arrow_position)
		draw_line(arrow_center + Vector2(-23.0, 0.0), arrow_center + Vector2(21.0, 0.0), INK, 3.0, true)
		draw_line(arrow_center + Vector2(-23.0, 0.0), arrow_center + Vector2(-13.0, -7.0), INK, 3.0, true)
		draw_line(arrow_center + Vector2(-23.0, 0.0), arrow_center + Vector2(-13.0, 7.0), INK, 3.0, true)
		draw_line(arrow_center + Vector2(21.0, 0.0), arrow_center + Vector2(14.0, -6.0), Color(MID, 0.8), 2.0, true)
		draw_line(arrow_center + Vector2(21.0, 0.0), arrow_center + Vector2(14.0, 6.0), Color(MID, 0.8), 2.0, true)

func _draw_cave_rock_shape(center: Vector2, radius: float, angle: float) -> void:
	var offsets: Array[Vector2] = [
		Vector2(-0.94, -0.22), Vector2(-0.58, -0.84), Vector2(-0.08, -1.0),
		Vector2(0.62, -0.78), Vector2(0.98, -0.18), Vector2(0.88, 0.52),
		Vector2(0.28, 0.94), Vector2(-0.45, 0.82), Vector2(-1.0, 0.34),
	]
	var points := PackedVector2Array()
	for offset in offsets:
		points.append(center + (offset * radius).rotated(angle))
	draw_polygon(points, PackedColorArray([Color("6f7271")]))
	var outline: PackedVector2Array = points.duplicate()
	outline.append(points[0])
	draw_polyline(outline, INK, 4.0, true)
	draw_line(center + Vector2(-0.45, -0.38).rotated(angle) * radius, center + Vector2(0.34, -0.52).rotated(angle) * radius, INK, 2.5, true)
	draw_line(center + Vector2(0.34, -0.52).rotated(angle) * radius, center + Vector2(0.55, 0.18).rotated(angle) * radius, INK, 2.5, true)
	draw_line(center + Vector2(-0.28, 0.42).rotated(angle) * radius, center + Vector2(0.55, 0.18).rotated(angle) * radius, Color(PAPER, 0.6), 2.0, true)

func _draw_cave_failure_effect() -> void:
	var center: Vector2 = _world_to_screen(player_position + PLAYER_SIZE * 0.5)
	var alpha: float = clampf(1.0 - cave_failure_time / 0.78, 0.0, 1.0)
	draw_arc(center, 24.0 + cave_failure_time * 44.0, 0.0, TAU, 30, Color(FIRE, alpha), 4.0, true)
	for slash_index in range(6):
		var slash_angle: float = float(slash_index) * TAU / 6.0
		draw_line(center + Vector2(cos(slash_angle), sin(slash_angle)) * 15.0, center + Vector2(cos(slash_angle), sin(slash_angle)) * 34.0, Color(INK, alpha), 3.0, true)
	draw_string(ui_font, center + Vector2(-62.0, -52.0), cave_failure_reason, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 14, Color(INK, alpha))

func _draw_far_hills() -> void:
	var back_line := PackedVector2Array([
		Vector2(0.0, 420.0), Vector2(120.0, 350.0), Vector2(230.0, 405.0),
		Vector2(380.0, 310.0), Vector2(530.0, 400.0), Vector2(670.0, 330.0),
		Vector2(820.0, 410.0), Vector2(1010.0, 325.0), Vector2(1280.0, 390.0),
	])
	draw_polyline(back_line, PALE, 3.0, true)
	draw_circle(Vector2(1035.0, 150.0), 45.0, Color(PALE, 0.55), false, 3.0, true)
	for index in 8:
		var x := 70.0 + index * 160.0
		draw_line(Vector2(x, 455.0), Vector2(x + 18.0, 360.0 - fmod(index * 31.0, 54.0)), Color(MID, 0.34), 2.0, true)

func _draw_dead_tree(origin: Vector2, scale_factor: float) -> void:
	draw_line(origin, origin + Vector2(8.0, -155.0) * scale_factor, INK, 7.0 * scale_factor, true)
	draw_line(origin + Vector2(5.0, -95.0) * scale_factor, origin + Vector2(-48.0, -137.0) * scale_factor, INK, 5.0 * scale_factor, true)
	draw_line(origin + Vector2(7.0, -126.0) * scale_factor, origin + Vector2(58.0, -166.0) * scale_factor, INK, 5.0 * scale_factor, true)

func _draw_fire(origin: Vector2) -> void:
	draw_line(origin + Vector2(-24.0, 6.0), origin + Vector2(24.0, -4.0), INK, 5.0, true)
	draw_line(origin + Vector2(-24.0, -4.0), origin + Vector2(24.0, 6.0), INK, 5.0, true)
	var sway := sin(elapsed * 7.0) * 4.0
	var flame := PackedVector2Array([
		origin + Vector2(-15.0, -2.0), origin + Vector2(-8.0 + sway, -36.0),
		origin + Vector2(0.0, -20.0), origin + Vector2(10.0 - sway, -50.0),
		origin + Vector2(17.0, -4.0),
	])
	draw_polygon(flame, PackedColorArray([FIRE]))
	draw_polyline(flame, INK, 2.5, true)

func _draw_shaft() -> void:
	draw_rect(Rect2(0.0, 0.0, 492.0, SCREEN.y), INK)
	draw_rect(Rect2(788.0, 0.0, 492.0, SCREEN.y), INK)
	draw_rect(Rect2(492.0, 0.0, 28.0, SCREEN.y), Color("333638"))
	draw_rect(Rect2(760.0, 0.0, 28.0, SCREEN.y), Color("333638"))
	_draw_shaft_wall_marks()
	for platform_rect in SHAFT_PLATFORMS:
		_draw_platform(_world_rect_to_screen(platform_rect))
	for index in range(SHAFT_FLAMES.size()):
		_draw_flame_strip(
			_world_rect_to_screen(SHAFT_FLAMES[index]),
			_shaft_flame_strength(index),
			false
		)
	if entry_fall_lock > 0.0:
		var p := _world_to_screen(player_position + PLAYER_SIZE * 0.5)
		for index in 5:
			var line_x := p.x - 48.0 + index * 24.0
			draw_line(Vector2(line_x, p.y - 70.0), Vector2(line_x - 4.0, p.y - 24.0), Color(MID, 0.62), 2.0, true)

func _draw_shaft_wall_marks() -> void:
	for index in 13:
		var world_y := 90.0 + index * 170.0
		var y := world_y - camera_axis
		if y < -60.0 or y > 780.0:
			continue
		draw_line(Vector2(501.0, y), Vector2(517.0, y + 36.0), Color(PAPER, 0.24), 2.0, true)
		draw_line(Vector2(779.0, y + 40.0), Vector2(762.0, y + 76.0), Color(PAPER, 0.24), 2.0, true)

func _draw_cavern() -> void:
	_draw_cavern_background()
	for platform_rect in CAVERN_FIXED_PLATFORMS:
		_draw_platform(_world_rect_to_screen(platform_rect))
	for dynamic_rect in _cavern_dynamic_platforms(elapsed):
		_draw_moving_platform(_world_rect_to_screen(dynamic_rect))
	for index in range(CAVERN_SPIKES.size()):
		_draw_spike_strip(
			_world_rect_to_screen(CAVERN_SPIKES[index]),
			_cavern_spike_strength(index)
		)
	_draw_water_system()
	_draw_gas_system()
	_draw_cavern_mid_checkpoint()
	_draw_cable()
	_draw_lift()
	_draw_pickup_items()

func _draw_cavern_mid_checkpoint() -> void:
	var center := _world_to_screen(Vector2(1734.0, 382.0))
	var platform_top := _world_to_screen(Vector2(1734.0, 415.0))
	draw_line(center + Vector2(0.0, 16.0), platform_top, INK, 3.0, true)
	if cavern_mid_checkpoint_active:
		var pulse_radius := 22.0 + sin(elapsed * 4.5) * 3.0
		draw_circle(center, 16.0, PAPER)
		draw_circle(center, 16.0, INK, false, 3.0, true)
		draw_circle(center, 5.0, INK)
		draw_arc(center, pulse_radius, 0.0, TAU, 24, Color(INK, 0.36), 2.0, true)
	else:
		draw_circle(center, 15.0, Color(PAPER, 0.55))
		draw_circle(center, 15.0, Color(INK, 0.55), false, 2.0, true)
		draw_circle(center, 3.0, Color(INK, 0.55))
	draw_string(ui_font, center + Vector2(-34.0, -27.0), "检查点", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 13, Color(INK, 0.58))

func _draw_cavern_background() -> void:
	var root_lines: Array[PackedVector2Array] = [
		PackedVector2Array([Vector2(0.0, 170.0), Vector2(260.0, 205.0), Vector2(520.0, 145.0), Vector2(790.0, 195.0)]),
		PackedVector2Array([Vector2(690.0, 80.0), Vector2(910.0, 145.0), Vector2(1190.0, 110.0), Vector2(1440.0, 170.0)]),
		PackedVector2Array([Vector2(1440.0, 120.0), Vector2(1690.0, 180.0), Vector2(1960.0, 120.0), Vector2(2450.0, 185.0)]),
		PackedVector2Array([Vector2(2380.0, 145.0), Vector2(2700.0, 95.0), Vector2(3020.0, 165.0), Vector2(3380.0, 105.0)]),
	]
	for root_line in root_lines:
		var screen_line := PackedVector2Array()
		for point in root_line:
			screen_line.append(_world_to_screen(point))
		draw_polyline(screen_line, Color(MID, 0.3), 5.0, true)
	draw_rect(_world_rect_to_screen(Rect2(0.0, 640.0, 3380.0, 100.0)), INK)
	for index in range(24):
		var x := 40.0 + index * 145.0
		var peak := Vector2(x, 640.0 - fmod(index * 37.0, 48.0))
		var points := PackedVector2Array([
			_world_to_screen(Vector2(x - 42.0, 650.0)),
			_world_to_screen(peak),
			_world_to_screen(Vector2(x + 46.0, 650.0)),
		])
		draw_polygon(points, PackedColorArray([INK]))

func _draw_water_system() -> void:
	var pool_rect := _world_rect_to_screen(Rect2(560.0, 605.0, 2390.0, 40.0))
	draw_rect(pool_rect, Color(WATER, 0.74))
	for line_index in range(14):
		var x := 585.0 + line_index * 175.0 + sin(elapsed * 1.8 + line_index) * 14.0
		var start := _world_to_screen(Vector2(x, 618.0 + fmod(line_index * 7.0, 13.0)))
		draw_line(start, start + Vector2(78.0, 0.0), WATER_PALE, 2.0, true)

	var spout := _world_rect_to_screen(SPOUT_VISUAL)
	draw_rect(spout, PAPER)
	draw_rect(spout, INK, false, 4.0)
	draw_arc(spout.get_center() + Vector2(0.0, 18.0), 31.0, PI, TAU, 24, INK, 5.0, true)
	if water_blocked:
		draw_line(spout.get_center() + Vector2(-30.0, 22.0), spout.get_center() + Vector2(30.0, 22.0), WATER, 4.0, true)
		return
	var curtain := _world_rect_to_screen(WATER_CURTAIN)
	draw_rect(curtain, Color(WATER, 0.72))
	for stream_index in 8:
		var stream_x := curtain.position.x + 12.0 + stream_index * 19.0
		var sway := sin(elapsed * 5.0 + stream_index) * 4.0
		draw_line(Vector2(stream_x, curtain.position.y), Vector2(stream_x + sway, curtain.end.y), WATER_PALE, 4.0, true)
	_draw_label(spout.position + Vector2(-3.0, -16.0), "出水口", 14, INK)

func _draw_spout_reject_effect() -> void:
	var progress: float = 1.0 - spout_reject_time / 0.86
	var origin: Vector2 = _world_to_screen(spout_reject_origin)
	var alpha: float = clampf(1.0 - progress, 0.0, 1.0)
	var ring_radius: float = lerpf(12.0, 58.0, progress)
	draw_arc(origin, ring_radius, 0.0, TAU, 28, Color(WATER_PALE, alpha), 4.0, true)
	for drop_index in range(8):
		var angle: float = -PI * 0.82 + float(drop_index) * PI * 0.23
		var distance: float = 18.0 + progress * (24.0 + float(drop_index % 3) * 7.0)
		var drop_end: Vector2 = origin + Vector2(cos(angle), sin(angle)) * distance
		draw_line(origin, drop_end, Color(WATER, alpha), 3.0, true)
	draw_line(origin + Vector2(-10.0, -10.0), origin + Vector2(10.0, 10.0), Color(INK, alpha), 3.0, true)
	draw_line(origin + Vector2(10.0, -10.0), origin + Vector2(-10.0, 10.0), Color(INK, alpha), 3.0, true)
	draw_string(
		ui_font,
		origin + Vector2(-29.0, -52.0),
		"卡不住",
		HORIZONTAL_ALIGNMENT_LEFT,
		-1.0,
		14,
		Color(INK, alpha)
	)

func _draw_gas_system() -> void:
	for gas_column in _cavern_gas_columns():
		var world_rect: Rect2 = gas_column["rect"]
		var vent_center := _world_to_screen(Vector2(world_rect.get_center().x, world_rect.end.y))
		draw_arc(vent_center, 17.0, PI, TAU, 16, INK, 4.0, true)
		if _gas_active(float(gas_column["phase"])):
			var gas_rect := _world_rect_to_screen(world_rect)
			for puff_index in 7:
				var puff_ratio := float(puff_index) / 6.0
				var center := Vector2(
					gas_rect.get_center().x + sin(elapsed * 5.0 + puff_index) * 10.0,
					lerpf(gas_rect.end.y, gas_rect.position.y, puff_ratio)
				)
				draw_circle(center, 12.0 + puff_index * 1.8, Color(GAS, 0.42), true, -1.0, true)
				draw_circle(center, 12.0 + puff_index * 1.8, Color(GAS, 0.9), false, 2.0, true)
		elif _gas_warning(float(gas_column["phase"])):
			for warning_index in 3:
				draw_circle(vent_center + Vector2(-9.0 + warning_index * 9.0, -15.0 - warning_index * 6.0), 3.5, Color(GAS, 0.85))

func _draw_cable() -> void:
	var cable_start := _world_to_screen(Vector2(2450.0, 305.0))
	var cable_end := _world_to_screen(Vector2(3020.0, 215.0))
	draw_line(cable_start, cable_end, INK, 3.0, true)
	draw_line(cable_start + Vector2(0.0, 5.0), cable_end + Vector2(0.0, 5.0), MID, 1.0, true)

func _draw_lift() -> void:
	var lift_offset := Vector2(0.0, -lift_time * 238.0)
	var left_rail_top := _world_to_screen(Vector2(3148.0, 88.0))
	var left_rail_bottom := _world_to_screen(Vector2(3148.0, 430.0))
	var right_rail_top := _world_to_screen(Vector2(3232.0, 88.0))
	var right_rail_bottom := _world_to_screen(Vector2(3232.0, 430.0))
	draw_line(left_rail_top, left_rail_bottom, Color(MID, 0.62), 3.0, true)
	draw_line(right_rail_top, right_rail_bottom, Color(MID, 0.62), 3.0, true)

	var lift_rect := _world_rect_to_screen(LIFT_PLATFORM)
	lift_rect.position += lift_offset
	_draw_platform(lift_rect)
	draw_line(lift_rect.position + Vector2(14.0, 0.0), left_rail_top, INK, 2.0, true)
	draw_line(lift_rect.end - Vector2(14.0, lift_rect.size.y), right_rail_top, INK, 2.0, true)

	var lever_base := lift_rect.position + Vector2(23.0, -2.0)
	draw_rect(Rect2(lever_base + Vector2(-13.0, -9.0), Vector2(26.0, 9.0)), INK)
	var lever_tip := lever_base + (Vector2(18.0, -30.0) if room == Room.CAVERN else Vector2(-4.0, -34.0))
	draw_line(lever_base, lever_tip, INK, 4.0, true)
	draw_circle(lever_tip, 6.0, FIRE)
	draw_circle(lever_tip, 6.0, INK, false, 2.0, true)
	if water_blocked and room == Room.CAVERN:
		_draw_key_prompt(lift_rect.get_center() + Vector2(0.0, -70.0), "F", "拉动摇杆")

func _draw_pickup_items() -> void:
	for index in range(pickup_items.size()):
		if index == held_item_index:
			continue
		var item: Dictionary = pickup_items[index]
		var position_value: Vector2 = _world_to_screen(item["position"])
		_draw_pickup(position_value, item["kind"], item["radius"])
	if held_item_index >= 0:
		var held_item: Dictionary = pickup_items[held_item_index]
		_draw_pickup(_world_to_screen(_held_item_position()), held_item["kind"], held_item["radius"])
		if throw_preparing:
			_draw_throw_preview()
	else:
		var nearest := _nearest_pickup_index()
		if nearest >= 0:
			var prompt_position: Vector2 = _world_to_screen(pickup_items[nearest]["position"]) + Vector2(0.0, -42.0)
			_draw_key_prompt(prompt_position, "F", "拾取")

func _draw_pickup(center: Vector2, kind: String, radius: float) -> void:
	match kind:
		"stone":
			var points := PackedVector2Array([
				center + Vector2(-radius, 4.0), center + Vector2(-8.0, -radius),
				center + Vector2(9.0, -radius + 3.0), center + Vector2(radius, 6.0),
				center + Vector2(5.0, radius), center + Vector2(-10.0, radius - 2.0),
			])
			draw_polygon(points, PackedColorArray([PAPER]))
			draw_polyline(points, INK, 3.0, true)
		"wood":
			draw_line(center + Vector2(-radius, 7.0), center + Vector2(radius, -7.0), INK, 9.0, true)
			draw_line(center + Vector2(-radius, 7.0), center + Vector2(radius, -7.0), PAPER, 4.0, true)
		_:
			draw_rect(Rect2(center - Vector2(radius, radius * 0.65), Vector2(radius * 2.0, radius * 1.3)), PAPER)
			draw_rect(Rect2(center - Vector2(radius, radius * 0.65), Vector2(radius * 2.0, radius * 1.3)), INK, false, 3.0)
			draw_line(center + Vector2(-6.0, -4.0), center + Vector2(7.0, 4.0), INK, 2.0, true)

func _nearest_pickup_index() -> int:
	var nearest := -1
	var nearest_distance := 68.0
	var center := player_position + PLAYER_SIZE * 0.5
	for index in range(pickup_items.size()):
		var item: Dictionary = pickup_items[index]
		if item["state"] != "waiting":
			continue
		var distance: float = center.distance_to(item["position"])
		if distance < nearest_distance:
			nearest = index
			nearest_distance = distance
	return nearest

func _draw_throw_preview() -> void:
	var ratio: float = clampf((throw_hold_time - THROW_HOLD_THRESHOLD) / 0.82, 0.0, 1.0)
	var strength: float = lerpf(THROW_MIN_SPEED, THROW_MAX_SPEED, ratio)
	var direction: Vector2 = Vector2(player_facing * cos(throw_angle), sin(throw_angle)).normalized()
	var start: Vector2 = _held_item_position()
	var preview_points := PackedVector2Array()
	var hits_visible_socket := false
	for sample_index in range(1, 73):
		var sample_time: float = float(sample_index) / 60.0
		var world_point: Vector2 = start + direction * strength * sample_time + Vector2(0.0, GRAVITY * sample_time * sample_time * 0.5)
		preview_points.append(_world_to_screen(world_point))
		if SPOUT_TARGET.has_point(world_point):
			hits_visible_socket = true
			break
		if world_point.y > 735.0 or world_point.x < -40.0 or world_point.x > 3420.0:
			break
	if preview_points.size() < 2:
		return
	draw_polyline(preview_points, Color(INK, 0.2 + ratio * 0.26), 1.5, true)
	for dot_index in range(3, preview_points.size(), 4):
		draw_circle(preview_points[dot_index], 2.5, Color(INK, 0.5 + ratio * 0.4))
	if hits_visible_socket:
		var hit_point: Vector2 = preview_points[preview_points.size() - 1]
		draw_circle(hit_point, 7.0, Color(WATER, 0.86), false, 2.0, true)

func _draw_platform(screen_rect: Rect2) -> void:
	draw_rect(screen_rect, PAPER)
	draw_rect(screen_rect, INK, false, 3.0)
	draw_line(screen_rect.position + Vector2(7.0, 7.0), screen_rect.end - Vector2(7.0, screen_rect.size.y - 7.0), Color(MID, 0.55), 1.5, true)

func _draw_moving_platform(screen_rect: Rect2) -> void:
	_draw_platform(screen_rect)
	var center := screen_rect.get_center()
	draw_line(center + Vector2(-13.0, 0.0), center + Vector2(13.0, 0.0), INK, 2.0, true)
	draw_line(center + Vector2(-13.0, 0.0), center + Vector2(-7.0, -5.0), INK, 2.0, true)
	draw_line(center + Vector2(13.0, 0.0), center + Vector2(7.0, 5.0), INK, 2.0, true)

func _draw_flame_strip(screen_rect: Rect2, strength: float, always_hot: bool) -> void:
	draw_line(
		Vector2(screen_rect.position.x, screen_rect.end.y),
		screen_rect.end,
		INK,
		4.0,
		true
	)
	var flame_count := maxi(2, int(screen_rect.size.x / 21.0))
	var flame_width := screen_rect.size.x / float(flame_count)
	for index in range(flame_count):
		var left := screen_rect.position.x + float(index) * flame_width
		var flicker := 0.78 + sin(elapsed * 10.0 + float(index) * 1.7) * 0.22
		var visible_strength := maxf(0.1 if always_hot else 0.0, strength)
		var flame_height := screen_rect.size.y * visible_strength * flicker
		if flame_height <= 1.0:
			continue
		var points := PackedVector2Array([
			Vector2(left, screen_rect.end.y),
			Vector2(left + flame_width * 0.28, screen_rect.end.y - flame_height * 0.42),
			Vector2(left + flame_width * 0.52, screen_rect.end.y - flame_height),
			Vector2(left + flame_width * 0.78, screen_rect.end.y - flame_height * 0.38),
			Vector2(left + flame_width, screen_rect.end.y),
		])
		draw_polygon(points, PackedColorArray([FIRE]))
		draw_polyline(points, INK, 1.5, true)

func _draw_spike_strip(screen_rect: Rect2, strength: float) -> void:
	var visible_strength: float = clampf(strength, 0.0, 1.0)
	draw_line(
		Vector2(screen_rect.position.x, screen_rect.end.y),
		screen_rect.end,
		INK,
		4.0,
		true
	)
	var spike_count: int = maxi(2, int(screen_rect.size.x / 13.0))
	var spike_width: float = screen_rect.size.x / float(spike_count)
	if visible_strength <= 0.02:
		for warning_index in range(spike_count):
			var warning_x: float = screen_rect.position.x + (float(warning_index) + 0.5) * spike_width
			draw_circle(Vector2(warning_x, screen_rect.end.y - 3.0), 2.0, Color(INK, 0.42))
		return
	for spike_index in range(spike_count):
		var left: float = screen_rect.position.x + float(spike_index) * spike_width
		var spike_height: float = screen_rect.size.y * visible_strength
		var points := PackedVector2Array([
			Vector2(left, screen_rect.end.y),
			Vector2(left + spike_width * 0.5, screen_rect.end.y - spike_height),
			Vector2(left + spike_width, screen_rect.end.y),
		])
		draw_polygon(points, PackedColorArray([INK]))

func _draw_shaft_failure_effect() -> void:
	var player_center := _world_to_screen(player_position + PLAYER_SIZE * 0.5)
	if shaft_failure_kind == "fire":
		var burst_ratio := clampf(shaft_failure_time / 0.28, 0.0, 1.0)
		var source := _world_to_screen(shaft_failure_origin)
		var ring_radius := lerpf(10.0, 62.0, burst_ratio)
		draw_arc(source, ring_radius, 0.0, TAU, 32, Color(FIRE, 1.0 - burst_ratio), 5.0, true)
		for spark_index in range(10):
			var angle := float(spark_index) * TAU / 10.0 + 0.22
			var distance := 16.0 + burst_ratio * (28.0 + float(spark_index % 3) * 10.0)
			var spark_end := source + Vector2(cos(angle), sin(angle)) * distance
			draw_line(source, spark_end, Color(FIRE, 1.0 - burst_ratio * 0.75), 3.0, true)
		var pulse := 0.65 + sin(elapsed * 18.0) * 0.25
		draw_circle(player_center, 27.0, Color(FIRE, pulse), false, 4.0, true)
		var feedback_alpha := clampf(1.0 - shaft_failure_time / 0.82, 0.0, 1.0)
		draw_string(
			ui_font,
			player_center + Vector2(-43.0, -48.0),
			"灼伤 · 失衡",
			HORIZONTAL_ALIGNMENT_LEFT,
			-1.0,
			15,
			Color(FIRE, feedback_alpha)
		)
	else:
		for line_index in range(5):
			var line_x := player_center.x - 42.0 + float(line_index) * 21.0
			draw_line(
				Vector2(line_x, player_center.y - 66.0),
				Vector2(line_x - 3.0, player_center.y - 24.0),
				Color(INK, 0.38),
				2.0,
				true
			)

func _draw_cavern_failure_effect() -> void:
	var player_center: Vector2 = _world_to_screen(player_position + PLAYER_SIZE * 0.5)
	var progress: float = clampf(cavern_failure_time / 0.76, 0.0, 1.0)
	var alpha: float = clampf(1.0 - progress, 0.0, 1.0)
	if cavern_failure_kind == "gas":
		for puff_index in range(9):
			var angle: float = float(puff_index) * TAU / 9.0 + elapsed * 1.2
			var radius: float = 19.0 + progress * 24.0 + float(puff_index % 3) * 5.0
			var puff_center: Vector2 = player_center + Vector2(cos(angle), sin(angle)) * radius
			var puff_size: float = 7.0 + float(puff_index % 2) * 3.0
			draw_circle(puff_center, puff_size, Color(GAS, alpha * 0.46))
			draw_circle(puff_center, puff_size, Color(GAS, alpha), false, 2.0, true)
		draw_circle(player_center, 27.0 + sin(elapsed * 17.0) * 3.0, Color(GAS, alpha), false, 4.0, true)
		draw_string(
			ui_font,
			player_center + Vector2(-43.0, -53.0),
			"中毒 · 失衡",
			HORIZONTAL_ALIGNMENT_LEFT,
			-1.0,
			15,
			Color(GAS, alpha)
		)
		return

	var source: Vector2 = _world_to_screen(cavern_failure_origin)
	var ring_radius: float = lerpf(9.0, 54.0, minf(progress * 1.8, 1.0))
	draw_arc(source, ring_radius, 0.0, TAU, 28, Color(INK, alpha), 4.0, true)
	for slash_index in range(6):
		var slash_angle: float = -0.9 + float(slash_index) * 0.36
		var slash_start: Vector2 = player_center + Vector2(cos(slash_angle), sin(slash_angle)) * 13.0
		var slash_end: Vector2 = player_center + Vector2(cos(slash_angle), sin(slash_angle)) * (32.0 + progress * 18.0)
		draw_line(slash_start, slash_end, Color(INK, alpha), 3.0, true)
	draw_string(
		ui_font,
		player_center + Vector2(-43.0, -53.0),
		"刺伤 · 失衡",
		HORIZONTAL_ALIGNMENT_LEFT,
		-1.0,
		15,
		Color(INK, alpha)
	)

func _draw_debug_selector() -> void:
	draw_rect(Rect2(0.0, 0.0, SCREEN.x, SCREEN.y), PAPER)
	draw_string(ui_font, Vector2(72.0, 92.0), "INKFALL · DEBUG", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 30, INK)
	draw_string(ui_font, Vector2(74.0, 128.0), "关卡测试入口", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 16, Color(INK, 0.58))
	var option_titles: Array[String] = ["DEBUG · 1-01 · 墨坠井", "DEBUG · 1-02 · 风化绳崖", "DEBUG · 1-03 · 月炉木屋", "DEBUG · 1-03B · 迷雾地窖"]
	var option_details: Array[String] = [
		"悬崖井口 → 火焰竖井 → 井底根穴 → 升降梯",
		"双崖上层 → 滚石收绳 → 架绳攀爬 → 盾行山洞 → 对岸木屋",
		"木屋求救声 → 制作火把 → 月光与穿堂风 → 地窖结界 → 迷雾地窖",
		"直接测试：岔路探索 → 排水取石 → 凿墙取钥匙 → 营救魔法师",
	]
	for index in range(option_titles.size()):
		var option_rect := Rect2(72.0, 150.0 + float(index) * 103.0, 980.0, 86.0)
		var selected := index == debug_selection
		draw_rect(option_rect, INK if selected else PAPER)
		draw_rect(option_rect, INK, false, 3.0)
		var title_color := PAPER if selected else INK
		var detail_color := Color(PAPER, 0.7) if selected else Color(INK, 0.62)
		draw_string(ui_font, option_rect.position + Vector2(32.0, 36.0), option_titles[index], HORIZONTAL_ALIGNMENT_LEFT, -1.0, 22, title_color)
		draw_string(ui_font, option_rect.position + Vector2(32.0, 66.0), option_details[index], HORIZONTAL_ALIGNMENT_LEFT, -1.0, 15, detail_color)
	draw_string(ui_font, Vector2(74.0, 592.0), "↑ ↓ 选择　Enter / F 进入测试", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 18, INK)
	draw_string(ui_font, Vector2(74.0, 668.0), "游戏中按 Esc 返回 DEBUG", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 15, Color(INK, 0.55))

func _draw_player() -> void:
	var p := _world_to_screen(player_position)
	var center_x := p.x + PLAYER_SIZE.x * 0.5
	var walk_phase := sin(elapsed * 12.0) if absf(player_velocity.x) > 25.0 and on_ground else 0.0
	var head_center := Vector2(center_x, p.y + 15.0)
	var in_cellar: bool = room == Room.LEVEL_03_CELLAR_MAZE
	var body_ink: Color = PAPER if in_cellar else INK
	var body_fill: Color = Color("111617") if in_cellar else PAPER

	draw_line(Vector2(center_x - 3.0, p.y + 40.0), Vector2(center_x - 7.0 - walk_phase * 5.0, p.y + 54.0), body_ink, 3.0, true)
	draw_line(Vector2(center_x + 3.0, p.y + 40.0), Vector2(center_x + 7.0 + walk_phase * 5.0, p.y + 54.0), body_ink, 3.0, true)
	var cloak := PackedVector2Array([
		Vector2(center_x, p.y + 24.0),
		Vector2(center_x - 12.0, p.y + 45.0),
		Vector2(center_x + 12.0, p.y + 45.0),
	])
	draw_polygon(cloak, PackedColorArray([body_fill]))
	draw_polyline(cloak, body_ink, 3.0, true)
	draw_circle(head_center, 9.5, body_fill, true, -1.0, true)
	draw_circle(head_center, 9.5, body_ink, false, 3.0, true)

	var look := player_facing
	draw_circle(head_center + Vector2(look * 3.0, -1.0), 1.2, body_ink)
	var hat := PackedVector2Array([
		Vector2(center_x - 14.0, p.y + 8.0),
		Vector2(center_x + 14.0, p.y + 8.0),
		Vector2(center_x - 2.0, p.y - 13.0),
		Vector2(center_x + 1.0, p.y + 2.0),
	])
	draw_polygon(hat, PackedColorArray([body_fill if in_cellar else INK]))
	if in_cellar:
		var hat_outline: PackedVector2Array = hat.duplicate()
		hat_outline.append(hat[0])
		draw_polyline(hat_outline, body_ink, 2.5, true)
	draw_line(Vector2(center_x - 16.0, p.y + 8.0), Vector2(center_x + 16.0, p.y + 8.0), body_ink, 4.0, true)

	var shoulder := Vector2(center_x, p.y + 29.0)
	if held_item_index >= 0:
		var hand := _world_to_screen(_held_item_position())
		draw_line(shoulder + Vector2(-3.0 * player_facing, 0.0), hand, body_ink, 3.0, true)
	elif level3_held_item != "" and (room == Room.LEVEL_03_HOUSE or room == Room.LEVEL_03_YARD):
		var level3_hand := p + Vector2(13.0 + player_facing * 18.0, 31.0)
		draw_line(shoulder, level3_hand, body_ink, 3.0, true)
		_draw_level_03_held_item(level3_hand)
	elif room == Room.LEVEL_03_CELLAR_MAZE and (cellar_has_stone or cellar_has_rubble):
		var cellar_hand := p + Vector2(13.0 + player_facing * 20.0, 34.0)
		draw_line(shoulder, cellar_hand, body_ink, 3.0, true)
		_draw_cellar_stone(cellar_hand + Vector2(player_facing * 9.0, 4.0), 10.0)
	else:
		draw_line(shoulder, shoulder + Vector2(player_facing * 13.0, 8.0 + walk_phase * 2.0), body_ink, 3.0, true)
		draw_line(shoulder, shoulder + Vector2(-player_facing * 10.0, 7.0 - walk_phase * 2.0), body_ink, 3.0, true)
	if (room == Room.LEVEL_02_CAVE or room == Room.LEVEL_02_COMPLETE) and shield_acquired:
		_draw_player_shield(p)

func _draw_level_03_held_item(hand: Vector2) -> void:
	var direction := Vector2(player_facing, -0.16)
	if level3_swing_time > 0.0:
		var swing_ratio: float = 1.0 - level3_swing_time / 0.32
		var swing_angle: float = lerpf(-1.25, 0.75, clampf(swing_ratio, 0.0, 1.0)) * player_facing
		direction = Vector2(cos(swing_angle), sin(swing_angle))
	if level3_held_item == "axe":
		_draw_shared_axe(hand, direction.angle(), 0.82)
		return
	var item_length: float = 58.0 if level3_held_item == "branch" else 48.0
	var end_point := hand + direction * item_length
	var item_color: Color = HEMP if level3_held_item == "branch" or level3_held_item == "torch" else Color("35383a")
	draw_line(hand, end_point, item_color, 6.0, true)
	draw_line(hand, end_point, INK, 1.5, true)
	if level3_held_item == "torch":
		_draw_scaled_fire(end_point, 0.48)

func _draw_player_shield(player_screen_position: Vector2) -> void:
	if shield_pickup_time > 0.05:
		return
	var facing: float = player_facing
	var shield_center := player_screen_position + Vector2(13.0 + facing * 20.0, 33.0)
	var shield_rotation: float = 0.12 * facing
	var fill_color: Color = PAPER
	if shield_guarding:
		shield_center = player_screen_position + Vector2(13.0 + facing * 26.0, 29.0)
		shield_rotation = 0.0
	elif shield_parry_time > 0.0:
		var parry_ratio: float = 1.0 - shield_parry_time / SHIELD_PARRY_DURATION
		shield_center = player_screen_position + Vector2(13.0 + facing * 28.0, 29.0)
		shield_rotation = lerpf(-0.95, 0.78, parry_ratio) * facing
		fill_color = GOLD_LIGHT
		draw_arc(shield_center, 34.0 + parry_ratio * 8.0, -1.35, 1.35, 24, Color(GOLD, 0.92), 5.0, true)
	elif shield_input_active:
		shield_center = player_screen_position + Vector2(13.0 + facing * 22.0, 32.0)
		shield_rotation = -0.28 * facing
	_draw_shield_shape(shield_center, shield_rotation, 1.0, fill_color, facing)
	if shield_block_hit_time > 0.0 or shield_parry_hit_time > 0.0:
		var impact_ratio: float = maxf(
			shield_block_hit_time / 0.16,
			shield_parry_hit_time / 0.30
		)
		for spark_index in range(7):
			var spark_angle: float = -1.15 + float(spark_index) * 0.38
			var direction := Vector2(cos(spark_angle) * facing, sin(spark_angle))
			draw_line(
				shield_center + direction * 23.0,
				shield_center + direction * (30.0 + impact_ratio * 15.0),
				Color(GOLD, impact_ratio),
				3.0,
				true
			)

func _draw_shield_shape(center: Vector2, rotation: float, scale_factor: float, fill_color: Color, facing: float = 1.0) -> void:
	var local_points: Array[Vector2] = [
		Vector2(-13.0, -19.0), Vector2(13.0, -19.0), Vector2(15.0, 1.0),
		Vector2(8.0, 14.0), Vector2(0.0, 21.0), Vector2(-8.0, 14.0), Vector2(-15.0, 1.0),
	]
	var shield_points := PackedVector2Array()
	for local_point in local_points:
		var mirrored_point := Vector2(local_point.x * facing, local_point.y) * scale_factor
		shield_points.append(center + mirrored_point.rotated(rotation))
	draw_polygon(shield_points, PackedColorArray([fill_color]))
	var outline: PackedVector2Array = shield_points.duplicate()
	outline.append(shield_points[0])
	draw_polyline(outline, INK, 3.0, true)
	var emblem_top: Vector2 = center + Vector2(0.0, -10.0 * scale_factor).rotated(rotation)
	var emblem_bottom: Vector2 = center + Vector2(0.0, 11.0 * scale_factor).rotated(rotation)
	draw_line(emblem_top, emblem_bottom, GOLD, 2.5, true)
	draw_circle(center, 3.5 * scale_factor, GOLD)

func _draw_ui() -> void:
	var level_title := "INKFALL · 1-01 墨坠井"
	var cellar_room: bool = room == Room.LEVEL_03_CELLAR_READY or room == Room.LEVEL_03_CELLAR_MAZE or room == Room.LEVEL_03_RESCUED
	var base_ui_color: Color = PAPER if cellar_room else INK
	if room == Room.LEVEL_02_CLIFFS or room == Room.LEVEL_02_ROPEWAY or room == Room.LEVEL_02_CAVE or room == Room.LEVEL_02_COMPLETE:
		level_title = "INKFALL · 1-02 风化绳崖"
	elif room == Room.LEVEL_03_HOUSE or room == Room.LEVEL_03_YARD or cellar_room:
		level_title = "INKFALL · 1-03 月炉木屋"
	draw_string(ui_font, Vector2(28.0, 36.0), level_title, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 20, base_ui_color)
	draw_string(ui_font, Vector2(28.0, 64.0), _room_name(), HORIZONTAL_ALIGNMENT_LEFT, -1.0, 15, Color(base_ui_color, 0.62))
	var controls := "A / D 移动　Space 跳跃　F 拾取 / 轻放 / 长按投掷　↑ ↓ 瞄准　R 重置"
	if room == Room.LEVEL_02_CLIFFS:
		controls = "A / D 移动　Space 跳跃　R 重置"
	elif room == Room.LEVEL_02_ROPEWAY:
		controls = "A / D 移动　Space 跳跃　F 收绳 / 架绳　R 重置"
	elif room == Room.LEVEL_02_CAVE or room == Room.LEVEL_02_COMPLETE:
		controls = "A / D 移动　Space 跳跃　F 短按盾反 / 长按举盾　R 重置"
	elif room == Room.LEVEL_03_HOUSE or room == Room.LEVEL_03_YARD:
		controls = "A / D 移动　Space 跳跃　R 重置"
	elif room == Room.LEVEL_03_CELLAR_MAZE:
		controls = "A / D 移动　Space 跳跃　R 重置"
	elif room == Room.LEVEL_03_CELLAR_READY:
		controls = ""
	elif room == Room.LEVEL_03_RESCUED:
		controls = "R 重新测试地窖　Esc 返回 DEBUG"
	draw_string(ui_font, Vector2(28.0, 694.0), controls, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 15, Color(base_ui_color, 0.64))
	if room == Room.LEVEL_03_CELLAR_MAZE and cellar_has_key:
		_draw_cellar_key(Vector2(1210.0, 40.0), 0.42, 1.0)

	if room == Room.CAVERN and not water_blocked:
		draw_string(ui_font, Vector2(1015.0, 42.0), "水路：未截断", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 15, WATER)
	elif room == Room.CAVERN or room == Room.LEVEL_01_LIFT:
		draw_string(ui_font, Vector2(1015.0, 42.0), "水路：已截断", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 15, INK)

	if room == Room.LEVEL_02_ROPEWAY:
		draw_string(ui_font, Vector2(1080.0, 42.0), "长绳：%d / %d" % [ropeway_knot_count, ROPEWAY_KNOTS.size()], HORIZONTAL_ALIGNMENT_LEFT, -1.0, 15, HEMP)
		if ropeway_status_time > 0.0 and ropeway_status_text != "":
			var status_alpha := clampf(ropeway_status_time, 0.0, 1.0)
			var status_width := ui_font.get_string_size(ropeway_status_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 20).x
			draw_string(ui_font, Vector2((SCREEN.x - status_width) * 0.5, 105.0), ropeway_status_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 20, Color(INK, status_alpha))
	elif room == Room.LEVEL_02_CAVE or room == Room.LEVEL_02_COMPLETE:
		var shield_text: String = "盾牌：已取得" if shield_acquired else "盾牌：未取得"
		draw_string(ui_font, Vector2(1085.0, 42.0), shield_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 15, GOLD if shield_acquired else MID)
		if cave_tutorial_time > 0.0:
			var tutorial_alpha: float = clampf(cave_tutorial_time, 0.0, 1.0)
			var tutorial_panel := Rect2(330.0, 252.0, 620.0, 174.0)
			draw_rect(tutorial_panel, Color(PAPER, tutorial_alpha * 0.94))
			draw_rect(tutorial_panel, Color(INK, tutorial_alpha), false, 4.0)
			var tutorial_title := "获得盾牌"
			var tutorial_title_width: float = ui_font.get_string_size(tutorial_title, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 28).x
			draw_string(ui_font, Vector2((SCREEN.x - tutorial_title_width) * 0.5, 302.0), tutorial_title, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 28, Color(GOLD, tutorial_alpha))
			var parry_tip := "短按 F：挥盾盾反，击碎迎面滚石"
			var guard_tip := "长按 F：持续举盾，抵挡横向飞箭"
			var parry_width: float = ui_font.get_string_size(parry_tip, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 19).x
			var guard_width: float = ui_font.get_string_size(guard_tip, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 19).x
			draw_string(ui_font, Vector2((SCREEN.x - parry_width) * 0.5, 350.0), parry_tip, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 19, Color(INK, tutorial_alpha))
			draw_string(ui_font, Vector2((SCREEN.x - guard_width) * 0.5, 386.0), guard_tip, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 19, Color(INK, tutorial_alpha))
		elif cave_status_time > 0.0 and cave_status_text != "":
			var cave_status_alpha: float = clampf(cave_status_time, 0.0, 1.0)
			var cave_status_width: float = ui_font.get_string_size(cave_status_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 20).x
			draw_string(ui_font, Vector2((SCREEN.x - cave_status_width) * 0.5, 105.0), cave_status_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 20, Color(GOLD, cave_status_alpha))

	if room == Room.CAVERN and cavern_checkpoint_flash_time > 0.0:
		var checkpoint_alpha := clampf(cavern_checkpoint_flash_time, 0.0, 1.0)
		var checkpoint_text := "中段检查点已记录"
		var checkpoint_width := ui_font.get_string_size(checkpoint_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 20).x
		draw_string(ui_font, Vector2((SCREEN.x - checkpoint_width) * 0.5, 104.0), checkpoint_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 20, Color(INK, checkpoint_alpha))

	if room_intro_time > 0.0:
		var alpha := clampf(room_intro_time, 0.0, 1.0)
		var intro_text := _room_intro_text()
		var text_width := ui_font.get_string_size(intro_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 22).x
		draw_string(ui_font, Vector2((SCREEN.x - text_width) * 0.5, 118.0), intro_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 22, Color(INK, alpha * 0.85))

	if room == Room.LEVEL_01_LIFT and completion_time > 0.28:
		var transition_alpha := sin(clampf((completion_time - 0.28) / 1.25, 0.0, 1.0) * PI)
		draw_rect(Rect2(Vector2.ZERO, SCREEN), Color(INK, transition_alpha * 0.32))
		var transition_text := "升降梯通往下一处断崖"
		var transition_width := ui_font.get_string_size(transition_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 25).x
		draw_string(ui_font, Vector2((SCREEN.x - transition_width) * 0.5, 336.0), transition_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 25, Color(PAPER, transition_alpha))

	if room == Room.LEVEL_02_COMPLETE and completion_time > 0.45:
		draw_rect(Rect2(0.0, 0.0, SCREEN.x, SCREEN.y), Color(PAPER, 0.88))
		var complete_text := "第二关灰盒完成"
		var complete_width := ui_font.get_string_size(complete_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 42).x
		draw_string(ui_font, Vector2((SCREEN.x - complete_width) * 0.5, 330.0), complete_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 42, INK)
		var sub_text := "穿过盾行山洞，你抵达了对岸木屋的篝火。按 F 进入木屋。"
		var sub_width := ui_font.get_string_size(sub_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 18).x
		draw_string(ui_font, Vector2((SCREEN.x - sub_width) * 0.5, 372.0), sub_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 18, Color(INK, 0.68))

func _draw_key_prompt(center: Vector2, key: String, label: String) -> void:
	draw_circle(center, 17.0, PAPER)
	draw_circle(center, 17.0, INK, false, 2.0, true)
	var key_size := ui_font.get_string_size(key, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 15)
	draw_string(ui_font, center - key_size * 0.5 + Vector2(0.0, key_size.y * 0.72), key, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 15, INK)
	var label_size := ui_font.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 13)
	draw_string(ui_font, center + Vector2(-label_size.x * 0.5, 37.0), label, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 13, Color(INK, 0.7))

func _draw_label(position_value: Vector2, text: String, size: int, color: Color) -> void:
	draw_string(ui_font, position_value, text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, size, color)

